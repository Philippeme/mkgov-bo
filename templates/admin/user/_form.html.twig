{{ form_start(form, {'attr': {'class': 'user-form', 'novalidate': 'novalidate'}}) }}

<style>
.user-form .form-section {
    background: white;
    border-radius: 15px;
    padding: 25px;
    margin-bottom: 20px;
    box-shadow: 0 2px 15px rgba(0,0,0,0.08);
    border-left: 4px solid #1a4b8f;
}

.user-form .section-title {
    color: #1a4b8f;
    font-weight: 600;
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 2px solid #e9ecef;
    display: flex;
    align-items: center;
    gap: 10px;
}

.user-form .form-control,
.user-form .form-select {
    border: 2px solid #e9ecef;
    border-radius: 10px;
    padding: 12px 15px;
    transition: all 0.3s ease;
    font-size: 16px;
}

.user-form .form-control:focus,
.user-form .form-select:focus {
    border-color: #1a4b8f;
    box-shadow: 0 0 0 0.2rem rgba(26, 75, 143, 0.15);
    outline: none;
}

.user-form .form-control.is-invalid {
    border-color: #dc3545;
    box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.15);
}

.user-form .form-control.is-valid {
    border-color: #28a745;
    box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.15);
}

.user-form label {
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 5px;
}

.user-form .form-text {
    color: #6c757d;
    font-size: 0.875rem;
    margin-top: 5px;
}

.avatar-preview-section {
    text-align: center;
    padding: 20px;
    border: 2px dashed #dee2e6;
    border-radius: 15px;
    background: #f8f9fa;
    transition: all 0.3s ease;
}

.avatar-preview-section:hover {
    border-color: #1a4b8f;
    background: #f0f7ff;
}

.avatar-preview {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    margin: 0 auto 15px;
    border: 4px solid #fff;
    box-shadow: 0 4px 15px rgba(0,0,0,0.15);
    object-fit: cover;
    display: none;
}

.avatar-placeholder {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    margin: 0 auto 15px;
    border: 4px solid #fff;
    box-shadow: 0 4px 15px rgba(0,0,0,0.15);
    background: linear-gradient(135deg, #1a4b8f 0%, #2a5db3 100%);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    font-weight: bold;
}

.roles-selection-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 15px;
    max-height: 400px;
    overflow-y: auto;
    padding: 15px;
    background: #f8f9fa;
    border-radius: 10px;
    border: 2px solid #e9ecef;
}

.role-option {
    background: white;
    border: 2px solid #e9ecef;
    border-radius: 10px;
    padding: 15px;
    transition: all 0.3s ease;
    cursor: pointer;
}

.role-option:hover {
    border-color: #1a4b8f;
    box-shadow: 0 2px 10px rgba(26, 75, 143, 0.15);
}

.role-option.selected {
    border-color: #1a4b8f;
    background: linear-gradient(135deg, #f0f7ff 0%, #e8f2ff 100%);
}

.role-option input[type="checkbox"] {
    margin-right: 10px;
    transform: scale(1.2);
}

.role-title {
    font-weight: 600;
    color: #1a4b8f;
    margin-bottom: 5px;
}

.role-description {
    color: #6c757d;
    font-size: 0.875rem;
    line-height: 1.4;
}

.system-role-badge {
    background: linear-gradient(135deg, #ffc107 0%, #e0a800 100%);
    color: #212529;
    font-size: 0.75rem;
    padding: 2px 8px;
    border-radius: 12px;
    font-weight: 500;
    margin-left: 8px;
}

.form-actions {
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    border-radius: 15px;
    padding: 25px;
    margin-top: 30px;
    text-align: center;
    box-shadow: 0 2px 15px rgba(0,0,0,0.08);
}

.btn-primary-gradient {
    background: linear-gradient(135deg, #1a4b8f 0%, #2a5db3 100%);
    border: none;
    color: white;
    padding: 12px 30px;
    border-radius: 10px;
    font-weight: 600;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.btn-primary-gradient:hover {
    background: linear-gradient(135deg, #2a5db3 0%, #f18221 100%);
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(26, 75, 143, 0.4);
    color: white;
}

.btn-secondary-gradient {
    background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
    border: none;
    color: white;
    padding: 12px 30px;
    border-radius: 10px;
    font-weight: 600;
    transition: all 0.3s ease;
}

.btn-secondary-gradient:hover {
    background: linear-gradient(135deg, #495057 0%, #343a40 100%);
    transform: translateY(-2px);
    color: white;
}

.status-switches {
    display: flex;
    gap: 30px;
    justify-content: center;
    align-items: center;
    padding: 20px;
    background: #f8f9fa;
    border-radius: 10px;
    margin-top: 15px;
}

.switch-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
}

.form-check-input {
    transform: scale(1.3);
}

.char-counter {
    font-size: 0.75rem;
    color: #6c757d;
    text-align: right;
    margin-top: 5px;
}
</style>

<div class="row">
    <!-- Left Column - Main Information -->
    <div class="col-lg-8">
        <!-- Basic Information Section -->
        <div class="form-section">
            <h4 class="section-title">
                <i class="fas fa-user"></i>
                Basic Information
            </h4>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="{{ form.username.vars.id }}">
                        <i class="fas fa-at"></i>
                        {{ form.username.vars.label }}
                        <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.username) }}
                    {{ form_errors(form.username) }}
                    {% if form.username.vars.help %}
                        <div class="form-text">{{ form.username.vars.help }}</div>
                    {% endif %}
                </div>
                
                <div class="col-md-6 mb-3">
                    <label for="{{ form.email.vars.id }}">
                        <i class="fas fa-envelope"></i>
                        {{ form.email.vars.label }}
                        <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.email) }}
                    {{ form_errors(form.email) }}
                    {% if form.email.vars.help %}
                        <div class="form-text">{{ form.email.vars.help }}</div>
                    {% endif %}
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="{{ form.firstName.vars.id }}">
                        <i class="fas fa-user"></i>
                        {{ form.firstName.vars.label }}
                        <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.firstName) }}
                    {{ form_errors(form.firstName) }}
                </div>
                
                <div class="col-md-6 mb-3">
                    <label for="{{ form.lastName.vars.id }}">
                        <i class="fas fa-user"></i>
                        {{ form.lastName.vars.label }}
                        <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.lastName) }}
                    {{ form_errors(form.lastName) }}
                </div>
            </div>
            
            <div class="mb-3">
                <label for="{{ form.phoneNumber.vars.id }}">
                    <i class="fas fa-phone"></i>
                    {{ form.phoneNumber.vars.label }}
                </label>
                {{ form_widget(form.phoneNumber) }}
                {{ form_errors(form.phoneNumber) }}
                {% if form.phoneNumber.vars.help %}
                    <div class="form-text">{{ form.phoneNumber.vars.help }}</div>
                {% endif %}
            </div>
        </div>

        <!-- Security Section -->
        {% if form.plainPassword is defined %}
        <div class="form-section">
            <h4 class="section-title">
                <i class="fas fa-lock"></i>
                Security Settings
            </h4>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    {{ form_label(form.plainPassword.first) }}
                    {{ form_widget(form.plainPassword.first) }}
                    {{ form_errors(form.plainPassword.first) }}
                    {% if form.plainPassword.first.vars.help %}
                        <div class="form-text">{{ form.plainPassword.first.vars.help }}</div>
                    {% endif %}
                </div>
                
                <div class="col-md-6 mb-3">
                    {{ form_label(form.plainPassword.second) }}
                    {{ form_widget(form.plainPassword.second) }}
                    {{ form_errors(form.plainPassword.second) }}
                    {% if form.plainPassword.second.vars.help %}
                        <div class="form-text">{{ form.plainPassword.second.vars.help }}</div>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endif %}

        <!-- Roles Section -->
        <div class="form-section">
            <h4 class="section-title">
                <i class="fas fa-shield-alt"></i>
                User Roles & Permissions
            </h4>
            
            <label>{{ form.userRoles.vars.label }}</label>
            <div class="roles-selection-grid">
                {% for role_choice in form.userRoles %}
                    <div class="role-option" onclick="toggleRoleSelection(this)">
                        {{ form_widget(role_choice) }}
                        <div class="role-title">
                            {{ role_choice.vars.label }}
                            {% if role_choice.vars.choice_attr.data_system is defined and role_choice.vars.choice_attr.data_system == 'true' %}
                                <span class="system-role-badge">SYSTEM</span>
                            {% endif %}
                        </div>
                        {% if role_choice.vars.choice_attr.data_description is defined %}
                            <div class="role-description">{{ role_choice.vars.choice_attr.data_description }}</div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
            {{ form_errors(form.userRoles) }}
            {% if form.userRoles.vars.help %}
                <div class="form-text mt-2">{{ form.userRoles.vars.help }}</div>
            {% endif %}
        </div>
    </div>
    
    <!-- Right Column - Avatar and Settings -->
    <div class="col-lg-4">
        <!-- Avatar Section -->
        <div class="form-section">
            <h4 class="section-title">
                <i class="fas fa-image"></i>
                Profile Picture
            </h4>
            
            <div class="avatar-preview-section">
                {% if user is defined and user.avatar %}
                    <img id="avatarPreview" src="{{ asset('uploads/users/' ~ user.avatar) }}" 
                         alt="Current avatar" class="avatar-preview" style="display: block;">
                {% else %}
                    <img id="avatarPreview" class="avatar-preview">
                    <div id="avatarPlaceholder" class="avatar-placeholder">
                        <i class="fas fa-user"></i>
                    </div>
                {% endif %}
                
                <label for="{{ form.avatarFile.vars.id }}" class="btn btn-outline-primary">
                    <i class="fas fa-camera me-2"></i>Choose Picture
                </label>
                {{ form_widget(form.avatarFile, {'attr': {'style': 'display: none;'}}) }}
                {{ form_errors(form.avatarFile) }}
                {% if form.avatarFile.vars.help %}
                    <div class="form-text mt-2">{{ form.avatarFile.vars.help }}</div>
                {% endif %}
            </div>
        </div>

        <!-- Settings Section -->
        <div class="form-section">
            <h4 class="section-title">
                <i class="fas fa-cog"></i>
                Account Settings
            </h4>
            
            <div class="mb-3">
                <label for="{{ form.displayOrder.vars.id }}">
                    <i class="fas fa-sort-numeric-down"></i>
                    {{ form.displayOrder.vars.label }}
                </label>
                {{ form_widget(form.displayOrder) }}
                {{ form_errors(form.displayOrder) }}
                {% if form.displayOrder.vars.help %}
                    <div class="form-text">{{ form.displayOrder.vars.help }}</div>
                {% endif %}
            </div>
            
            <div class="status-switches">
                <div class="switch-wrapper">
                    {{ form_widget(form.isActive) }}
                    <label for="{{ form.isActive.vars.id }}" class="mb-0">
                        <i class="fas fa-power-off me-1"></i>
                        {{ form.isActive.vars.label }}
                    </label>
                </div>
                
                <div class="switch-wrapper">
                    {{ form_widget(form.isVerified) }}
                    <label for="{{ form.isVerified.vars.id }}" class="mb-0">
                        <i class="fas fa-check-circle me-1"></i>
                        {{ form.isVerified.vars.label }}
                    </label>
                </div>
            </div>
            
            <div class="form-text text-center">
                {% if form.isActive.vars.help %}{{ form.isActive.vars.help }}{% endif %}
                {% if form.isVerified.vars.help %}<br>{{ form.isVerified.vars.help }}{% endif %}
            </div>
        </div>
    </div>
</div>

<!-- Form Actions -->
<div class="form-actions">
    <button type="submit" class="btn btn-primary-gradient me-3">
        <i class="fas fa-save me-2"></i>
        {{ button_label|default('Save User') }}
    </button>
    <a href="{{ path('admin_user_index') }}" class="btn btn-secondary-gradient">
        <i class="fas fa-times me-2"></i>
        Cancel
    </a>
</div>

{{ form_end(form) }}

<script>
// Avatar preview functionality
function previewAvatar(input) {
    const preview = document.getElementById('avatarPreview');
    const placeholder = document.getElementById('avatarPlaceholder');
    
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        
        reader.onload = function(e) {
            preview.src = e.target.result;
            preview.style.display = 'block';
            if (placeholder) placeholder.style.display = 'none';
        };
        
        reader.readAsDataURL(input.files[0]);
    }
}

// Role selection functionality
function toggleRoleSelection(element) {
    const checkbox = element.querySelector('input[type="checkbox"]');
    checkbox.checked = !checkbox.checked;
    
    if (checkbox.checked) {
        element.classList.add('selected');
    } else {
        element.classList.remove('selected');
    }
}

// Initialize role selections
document.addEventListener('DOMContentLoaded', function() {
    const roleOptions = document.querySelectorAll('.role-option');
    roleOptions.forEach(option => {
        const checkbox = option.querySelector('input[type="checkbox"]');
        if (checkbox.checked) {
            option.classList.add('selected');
        }
        
        // Prevent double-toggle when clicking directly on checkbox
        checkbox.addEventListener('click', function(e) {
            e.stopPropagation();
            if (this.checked) {
                option.classList.add('selected');
            } else {
                option.classList.remove('selected');
            }
        });
    });
});

// Form validation feedback
document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('.user-form');
    const inputs = form.querySelectorAll('.form-control');
    
    inputs.forEach(input => {
        input.addEventListener('blur', function() {
            if (this.value.trim() !== '') {
                this.classList.add('is-valid');
                this.classList.remove('is-invalid');
            }
        });
        
        input.addEventListener('input', function() {
            this.classList.remove('is-invalid', 'is-valid');
        });
    });
});

// Character counter for description fields
function updateCharCount(element, maxLength) {
    const counter = element.parentNode.querySelector('.char-counter') || 
                   document.createElement('div');
    
    if (!element.parentNode.querySelector('.char-counter')) {
        counter.className = 'char-counter';
        element.parentNode.appendChild(counter);
    }
    
    const currentLength = element.value.length;
    counter.textContent = `${currentLength}/${maxLength} characters`;
    
    if (currentLength > maxLength * 0.9) {
        counter.style.color = '#dc3545';
    } else if (currentLength > maxLength * 0.7) {
        counter.style.color = '#ffc107';
    } else {
        counter.style.color = '#6c757d';
    }
}
</script>