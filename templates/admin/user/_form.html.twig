{{ form_start(form) }}
<div class="row">
    <div class="col-md-8">
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_row(form.username) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_row(form.email) }}
                </div>
            </div>
        </div>
        
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_row(form.firstName) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_row(form.lastName) }}
                </div>
            </div>
        </div>
        
        <div class="mb-3">
            {{ form_row(form.phoneNumber) }}
        </div>
        
        {% if form.plainPassword is defined %}
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_row(form.plainPassword.first) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_row(form.plainPassword.second) }}
                </div>
            </div>
        </div>
        {% endif %}
        
        <div class="mb-3">
            <label class="form-label">Roles</label>
            <div class="roles-container">
                {{ form_widget(form.userRoles) }}
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="mb-3">
            {{ form_row(form.avatarFile) }}
            {% if user is defined and user.avatar %}
                <div class="mt-2">
                    <p>Current avatar:</p>
                    <img src="{{ asset('uploads/users/' ~ user.avatar) }}" 
                         alt="{{ user.fullName }}" 
                         class="img-fluid rounded" 
                         style="max-width: 200px;">
                </div>
            {% endif %}
        </div>
        
        <div class="mb-3">
            {{ form_row(form.displayOrder) }}
        </div>
        
        <div class="form-check mb-3">
            {{ form_widget(form.isActive) }}
            {{ form_label(form.isActive) }}
        </div>
        
        <div class="form-check mb-3">
            {{ form_widget(form.isVerified) }}
            {{ form_label(form.isVerified) }}
        </div>
    </div>
</div>

<div class="d-flex gap-2">
    <button class="btn btn-primary">{{ button_label|default('Save') }}</button>
    <a href="{{ path('admin_user_index') }}" class="btn btn-secondary">Cancel</a>
</div>
{{ form_end(form) }}