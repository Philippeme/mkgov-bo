{# templates/admin/user/show.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block title %}{{ user.fullName }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1><i class="fas fa-user me-2"></i>{{ user.fullName }}</h1>
        <p class="text-muted mb-0">User profile and information</p>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn btn-warning">
            <i class="fas fa-edit me-1"></i> Edit User
        </a>
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="fas fa-cog me-1"></i> Actions
            </button>
            <ul class="dropdown-menu">
                <li>
                    <form method="post" action="{{ path('admin_user_toggle_status', {'id': user.id}) }}" style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_status' ~ user.id) }}">
                        <button type="submit" class="dropdown-item">
                            <i class="fas fa-{{ user.isActive ? 'ban' : 'check' }} me-2"></i>
                            {{ user.isActive ? 'Deactivate' : 'Activate' }} User
                        </button>
                    </form>
                </li>
                <li>
                    <form method="post" action="{{ path('admin_user_verify', {'id': user.id}) }}" style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('verify' ~ user.id) }}">
                        <button type="submit" class="dropdown-item">
                            <i class="fas fa-{{ user.isVerified ? 'times' : 'shield-alt' }} me-2"></i>
                            {{ user.isVerified ? 'Unverify' : 'Verify' }} User
                        </button>
                    </form>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form method="post" action="{{ path('admin_user_delete', {'id': user.id}) }}" 
                          onsubmit="return confirm('Are you sure you want to delete this user? This action cannot be undone.');" style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                        <button type="submit" class="dropdown-item text-danger">
                            <i class="fas fa-trash me-2"></i> Delete User
                        </button>
                    </form>
                </li>
            </ul>
        </div>
        <a href="{{ path('admin_user_index') }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to Users
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <!-- User Profile Card -->
        <div class="card mb-4">
            <div class="card-body text-center">
                <div class="mb-3">
                    {% if user.avatar %}
                        <img src="{{ asset('uploads/avatars/' ~ user.avatar) }}" 
                             alt="{{ user.fullName }}" 
                             class="rounded-circle img-thumbnail" 
                             width="120" height="120">
                    {% else %}
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto" 
                             style="width: 120px; height: 120px; font-size: 2rem; font-weight: bold;">
                            {{ user.initials }}
                        </div>
                    {% endif %}
                </div>
                <h4 class="mb-1">{{ user.fullName }}</h4>
                <p class="text-muted mb-2">@{{ user.username }}</p>
                <div class="mb-3">
                    {% if user.isActive %}
                        <span class="badge bg-success">Active</span>
                    {% else %}
                        <span class="badge bg-danger">Inactive</span>
                    {% endif %}
                    {% if user.isVerified %}
                        <span class="badge bg-info">Verified</span>
                    {% else %}
                        <span class="badge bg-warning">Unverified</span>
                    {% endif %}
                </div>
                {% if user.biography %}
                    <p class="text-muted">{{ user.biography }}</p>
                {% endif %}
            </div>
        </div>

        <!-- Contact Information -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-address-card me-2"></i>Contact Information
                </h5>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <i class="fas fa-envelope text-muted me-3" style="width: 20px;"></i>
                    <div>
                        <strong>Email:</strong><br>
                        <a href="mailto:{{ user.email }}" class="text-decoration-none">{{ user.email }}</a>
                    </div>
                </div>
                {% if user.phoneNumber %}
                    <div class="d-flex align-items-center mb-3">
                        <i class="fas fa-phone text-muted me-3" style="width: 20px;"></i>
                        <div>
                            <strong>Phone:</strong><br>
                            <a href="tel:{{ user.phoneNumber }}" class="text-decoration-none">{{ user.phoneNumber }}</a>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Account Statistics -->
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-chart-bar me-2"></i>Account Statistics
                </h5>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-6">
                        <div class="border-end">
                            <h4 class="text-primary">{{ user.userRoles|length }}</h4>
                            <small class="text-muted">Roles</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <h4 class="text-info">{{ user.permissions|length }}</h4>
                        <small class="text-muted">Permissions</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <!-- User Details -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-info-circle me-2"></i>User Details
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <td class="text-muted" style="width: 40%;">User ID:</td>
                                <td><strong>{{ user.id }}</strong></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Username:</td>
                                <td><code>{{ user.username }}</code></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Full Name:</td>
                                <td>{{ user.fullName }}</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Email:</td>
                                <td>{{ user.email }}</td>
                            </tr>
                            {% if user.phoneNumber %}
                                <tr>
                                    <td class="text-muted">Phone:</td>
                                    <td>{{ user.phoneNumber }}</td>
                                </tr>
                            {% endif %}
                        </table>
                    </div>
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <td class="text-muted" style="width: 40%;">Status:</td>
                                <td>
                                    {% if user.isActive %}
                                        <span class="badge bg-success">Active</span>
                                    {% else %}
                                        <span class="badge bg-danger">Inactive</span>
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <td class="text-muted">Verification:</td>
                                <td>
                                    {% if user.isVerified %}
                                        <span class="badge bg-success">Verified</span>
                                    {% else %}
                                        <span class="badge bg-warning">Unverified</span>
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <td class="text-muted">Created:</td>
                                <td>{{ user.createdAt|date('d/m/Y H:i') }}</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Last Updated:</td>
                                <td>{{ user.updatedAt|date('d/m/Y H:i') }}</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Last Login:</td>
                                <td>
                                    {% if user.lastLoginAt %}
                                        {{ user.lastLoginAt|date('d/m/Y H:i') }}
                                    {% else %}
                                        <span class="text-muted">Never</span>
                                    {% endif %}
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Roles & Permissions -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-shield-alt me-2"></i>Roles & Permissions
                </h5>
            </div>
            <div class="card-body">
                {% if user.userRoles|length > 0 %}
                    <h6 class="text-muted">Assigned Roles:</h6>
                    <div class="mb-4">
                        {% for role in user.userRoles %}
                            <div class="card border-start border-4 border-{{ role.badgeColor }} mb-2">
                                <div class="card-body py-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-1">{{ role.label }}</h6>
                                            <small class="text-muted">{{ role.name }}</small>
                                            {% if role.description %}
                                                <p class="mb-0 mt-1">{{ role.description }}</p>
                                            {% endif %}
                                        </div>
                                        <div>
                                            <span class="badge bg-{{ role.badgeColor }}">{{ role.label }}</span>
                                            {% if role.isSystem %}
                                                <span class="badge bg-secondary">System</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <h6 class="text-muted">Effective Permissions:</h6>
                    <div class="row">
                        {% set permissionsByCategory = {} %}
                        {% for role in user.userRoles %}
                            {% for permission in role.permissions %}
                                {% set category = permission.category %}
                                {% if permissionsByCategory[category] is not defined %}
                                    {% set permissionsByCategory = permissionsByCategory|merge({(category): []}) %}
                                {% endif %}
                                {% set permissionsByCategory = permissionsByCategory|merge({(category): permissionsByCategory[category]|merge([permission])}) %}
                            {% endfor %}
                        {% endfor %}

                        {% for category, permissions in permissionsByCategory %}
                            <div class="col-md-6 mb-3">
                                <h6 class="text-primary">{{ category|title|replace({'_': ' '}) }}</h6>
                                {% for permission in permissions|unique %}
                                    <span class="badge {{ permission.badgeClass }} me-1 mb-1">{{ permission.label }}</span>
                                {% endfor %}
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center py-4">
                        <i class="fas fa-shield-alt fa-3x text-muted mb-3"></i>
                        <h6 class="text-muted">No roles assigned</h6>
                        <p class="text-muted">This user has no roles and therefore no permissions.</p>
                        <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn btn-primary">
                            <i class="fas fa-plus me-1"></i> Assign Roles
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}