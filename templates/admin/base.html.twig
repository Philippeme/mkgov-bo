                                    {{ app.user ? (app.user.firstName|first ~ app.user.lastName|first) : 'AD' }}
                                </div>
                                <div class="user-info-header d-none d-md-block">
                                    <div class="user-name">{{ app.user ? (app.user.firstName ~ ' ' ~ app.user.lastName) : 'Administrateur' }}</div>
                                    <div class="user-role">Administrateur</div>
                                </div>
                                <i class="fas fa-chevron-down" style="font-size: 10px; color: var(--mk-gray);"></i>
                            </button>
                            <ul class="dropdown-menu user-dropdown dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" href="#">
                                        <i class="bi-person-circle me-2"></i>
                                        Mon Profil
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="#">
                                        <i class="bi-gear me-2"></i>
                                        Paramètres
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="#">
                                        <i class="bi-question-circle me-2"></i>
                                        Aide
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" href="{{ path('app_logout') }}">
                                        <i class="bi-box-arrow-right text-danger me-2"></i>
                                        Déconnexion
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                
                <!-- Breadcrumb Navigation -->
                <div class="breadcrumb-nav">
                    <div class="breadcrumb-path">
                        <a href="{{ path('admin_dashboard') }}" class="breadcrumb-item">Dashboard</a>
                        {% if app.request.get('_route') != 'admin_dashboard' %}
                        <span class="breadcrumb-separator">/</span>
                        <span class="breadcrumb-item current">
                            {% if app.request.get('_route') starts with 'admin_project' %}
                                Projets
                            {% elseif app.request.get('_route') starts with 'admin_family' %}
                                Familles
                            {% elseif app.request.get('_route') starts with 'admin_user' %}
                                Utilisateurs
                            {% elseif app.request.get('_route') starts with 'admin_role' %}
                                Rôles
                            {% elseif app.request.get('_route') starts with 'admin_procedure' %}
                                Procédures
                            {% elseif app.request.get('_route') starts with 'admin_document' %}
                                Documents
                            {% elseif app.request.get('_route') starts with 'admin_request' %}
                                Demandes
                            {% else %}
                                Administration
                            {% endif %}
                        </span>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="admin-main">
                {% block body %}{% endblock %}
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery pour DataTables -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    
    <!-- Custom Admin JS -->
    <script src="{{ asset('js/admin.js') }}"></script>

    <!-- NOUVEAU: JavaScript pour le système de messages centralisé -->
    <script>
        // Gestion centralisée des messages flash
        document.addEventListener('DOMContentLoaded', function() {
            initializeFlashMessages();
            setupMenuActiveStates();
        });

        function initializeFlashMessages() {
            const flashMessages = document.querySelectorAll('.flash-message[data-auto-dismiss="true"]');
            
            flashMessages.forEach(message => {
                // Auto dismiss après 2 secondes
                setTimeout(() => {
                    dismissFlashMessage(message);
                }, 2000);

                // Gestion du clic sur le bouton close
                const closeBtn = message.querySelector('.btn-close');
                if (closeBtn) {
                    closeBtn.addEventListener('click', (e) => {
                        e.preventDefault();
                        dismissFlashMessage(message);
                    });
                }
            });
        }

        function dismissFlashMessage(message) {
            if (message && !message.classList.contains('dismissing')) {
                message.classList.add('dismissing');
                setTimeout(() => {
                    if (message.parentNode) {
                        message.parentNode.removeChild(message);
                    }
                }, 400); // Durée de l'animation
            }
        }

        // NOUVEAU: Fonction pour ajouter des messages via JavaScript (si nécessaire)
        function showFlashMessage(text, type = 'info') {
            const container = document.getElementById('flashMessagesContainer');
            if (!container) return;

            const alertClass = type === 'error' ? 'danger' : type;
            const iconClass = type === 'success' ? 'check-circle' : 
                            (type === 'error' || type === 'danger' ? 'exclamation-triangle' : 
                            (type === 'warning' ? 'exclamation-circle' : 'info-circle'));

            const messageEl = document.createElement('div');
            messageEl.className = `alert flash-message alert-${alertClass} fade show`;
            messageEl.setAttribute('role', 'alert');
            messageEl.setAttribute('data-auto-dismiss', 'true');
            
            messageEl.innerHTML = `
                <div class="alert-content">
                    <i class="alert-icon fas fa-${iconClass}"></i>
                    <span class="alert-text">${text}</span>
                    <button type="button" class="btn-close" aria-label="Close"></button>
                </div>
                <div class="auto-dismiss-progress"></div>
            `;

            container.appendChild(messageEl);

            // Auto dismiss
            setTimeout(() => {
                dismissFlashMessage(messageEl);
            }, 5000);

            // Gestion du clic sur close
            const closeBtn = messageEl.querySelector('.btn-close');
            if (closeBtn) {
                closeBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    dismissFlashMessage(messageEl);
                });
            }
        }

        function setupMenuActiveStates() {
            const currentRoute = '{{ app.request.get('_route') }}';
            
            // Supprimer toutes les classes has-active-child existantes
            document.querySelectorAll('.nav-item.dropdown.has-active-child').forEach(item => {
                item.classList.remove('has-active-child');
            });
            
            // Ajouter has-active-child selon la route actuelle
            if (currentRoute.startsWith('admin_project')) {
                const projectDropdown = document.querySelector('[data-dropdown="projects"]').closest('.nav-item.dropdown');
                if (projectDropdown) {
                    projectDropdown.classList.add('has-active-child');
                    const dropdownMenu = projectDropdown.querySelector('.dropdown-menu');
                    if (dropdownMenu) {
                        dropdownMenu.classList.add('show');
                        projectDropdown.classList.add('open');
                    }
                }
            } else if (currentRoute.startsWith('admin_document')) {
                const documentDropdown = document.querySelector('[data-dropdown="documents"]').closest('.nav-item.dropdown');
                if (documentDropdown) {
                    documentDropdown.classList.add('has-active-child');
                    const dropdownMenu = documentDropdown.querySelector('.dropdown-menu');
                    if (dropdownMenu) {
                        dropdownMenu.classList.add('show');
                        documentDropdown.classList.add('open');
                    }
                }
            } else if (currentRoute.startsWith('admin_request')) {
                    const requestDropdown = document.querySelector('[data-dropdown="requests"]').closest('.nav-item.dropdown');
                    if (requestDropdown) {
                        requestDropdown.classList.add('has-active-child');
                        const dropdownMenu = requestDropdown.querySelector('.dropdown-menu');
                        if (dropdownMenu) {
                            dropdownMenu.classList.add('show');
                            requestDropdown.classList.add('open');
                        }
                    }
            } else if (currentRoute.startsWith('admin_procedure')) {
                    const procedureDropdown = document.querySelector('[data-dropdown="procedures"]').closest('.nav-item.dropdown');
                    if (procedureDropdown) {
                        procedureDropdown.classList.add('has-active-child');
                        const dropdownMenu = procedureDropdown.querySelector('.dropdown-menu');
                        if (dropdownMenu) {
                            dropdownMenu.classList.add('show');
                            procedureDropdown.classList.add('open');
                        }
                    }
            } else if (currentRoute.startsWith('admin_family')) {
                    const familyDropdown = document.querySelector('[data-dropdown="families"]').closest('.nav-item.dropdown');
                    if (familyDropdown) {
                        familyDropdown.classList.add('has-active-child');
                        const dropdownMenu = familyDropdown.querySelector('.dropdown-menu');
                        if (dropdownMenu) {
                            dropdownMenu.classList.add('show');
                            familyDropdown.classList.add('open');
                        }
                    }
            } else if (currentRoute.startsWith('admin_user')) {
                    const userDropdown = document.querySelector('[data-dropdown="users"]').closest('.nav-item.dropdown');
                    if (userDropdown) {
                        userDropdown.classList.add('has-active-child');
                        const dropdownMenu = userDropdown.querySelector('.dropdown-menu');
                        if (dropdownMenu) {
                            dropdownMenu.classList.add('show');
                            userDropdown.classList.add('open');
                        }
                    }
            } else if (currentRoute.startsWith('admin_role')) {
                    const roleDropdown = document.querySelector('[data-dropdown="roles"]').closest('.nav-item.dropdown');
                    if (roleDropdown) {
                        roleDropdown.classList.add('has-active-child');
                        const dropdownMenu = roleDropdown.querySelector('.dropdown-menu');
                        if (dropdownMenu) {
                            dropdownMenu.classList.add('show');
                            roleDropdown.classList.add('open');
                        }
                    }
            }
            
        }

        // Exposer la fonction globalement pour les autres scripts
        window.showFlashMessage = showFlashMessage;
        window.dismissFlashMessage = dismissFlashMessage;
    </script>

    {% block javascripts %}{% endblock %}
</body>
</html>