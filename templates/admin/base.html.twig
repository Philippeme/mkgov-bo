<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Administration{% endblock %} - MK BA</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"/>

    <style>
        :root {
            /* MK BA Color Palette */
            --mk-primary: #6d5192;
            --mk-secondary: #8e32e9;
            --mk-accent: #a855f7;
            --mk-dark: #1c273c;
            --mk-darker: #0f172a;
            --mk-gray: #6c7293;
            --mk-gray-light: #9ca3af;
            --mk-light: #f8f9fa;
            --mk-lighter: #ffffff;
            --mk-success: #10b981;
            --mk-warning: #f59e0b;
            --mk-danger: #ef4444;
            --mk-info: #3b82f6;
            
            /* Gradients */
            --mk-gradient-primary: linear-gradient(135deg, #6d5192 0%, #8e32e9 100%);
            --mk-gradient-dark: linear-gradient(180deg, #1c273c 0%, #0f172a 100%);
            --mk-gradient-light: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
            
            /* Sidebar */
            --sidebar-width: 280px;
            --sidebar-collapsed-width: 70px;
            --transition-speed: 0.3s;
            
            /* Shadows */
            --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Roboto', sans-serif;
            background: var(--mk-light);
            margin: 0;
            padding: 0;
            font-size: 14px;
            line-height: 1.6;
        }

        .admin-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* ========== SIDEBAR ========== */
        .admin-sidebar {
            width: var(--sidebar-width);
            background: var(--mk-gradient-dark);
            color: white;
            box-shadow: var(--shadow-xl);
            position: fixed;
            height: 100vh;
            overflow-y: auto;
            overflow-x: hidden;
            transition: width var(--transition-speed) ease;
            z-index: 1000;
            border-right: 1px solid rgba(255, 255, 255, 0.1);
        }

        .admin-sidebar.collapsed {
            width: var(--sidebar-collapsed-width);
        }

        .admin-sidebar::-webkit-scrollbar {
            width: 4px;
        }

        .admin-sidebar::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.1);
        }

        .admin-sidebar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.3);
            border-radius: 2px;
        }

        /* Sidebar Header */
        .sidebar-header {
            padding: 2rem 1.5rem;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            position: relative;
            background: rgba(109, 81, 146, 0.1);
        }

        .logo-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1rem;
        }

        .logo-frame {
            width: 50px;
            height: 50px;
            background: rgba(255, 255, 255, 0.15);
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }

        .logo-frame:hover {
            transform: scale(1.05);
            border-color: rgba(255, 255, 255, 0.5);
        }

        .logo-text {
            font-size: 20px;
            font-weight: 900;
            background: linear-gradient(45deg, #ffffff, #f8f9fa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .sidebar-header h4 {
            margin: 0;
            font-size: 18px;
            font-weight: 700;
            transition: opacity var(--transition-speed) ease;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
        }

        .collapsed .sidebar-header h4 {
            opacity: 0;
        }

        /* Hamburger Toggle */
        .hamburger-toggle {
            position: absolute;
            top: 20px;
            right: 15px;
            background: rgba(255, 255, 255, 0.1);
            border: none;
            color: white;
            width: 35px;
            height: 35px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all var(--transition-speed) ease;
            backdrop-filter: blur(10px);
        }

        .hamburger-toggle:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: scale(1.05);
        }

        .hamburger-toggle i {
            font-size: 16px;
            transition: transform var(--transition-speed) ease;
        }

        .collapsed .hamburger-toggle i {
            transform: rotate(180deg);
        }

        /* Navigation */
        .sidebar-nav {
            padding: 0;
            list-style: none;
            margin: 0;
        }

        .nav-section {
            margin-bottom: 8px;
        }

        .nav-section-title {
            padding: 16px 20px 8px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255, 255, 255, 0.6);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            margin-bottom: 8px;
            transition: opacity var(--transition-speed) ease;
        }

        .collapsed .nav-section-title {
            opacity: 0;
            height: 0;
            padding: 0;
            margin: 0;
            overflow: hidden;
        }

        .sidebar-nav li {
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .sidebar-nav a {
            display: flex;
            align-items: center;
            padding: 14px 20px;
            color: rgba(255, 255, 255, 0.9);
            text-decoration: none;
            transition: all 0.3s ease;
            font-weight: 500;
            font-size: 14px;
            position: relative;
        }

        .sidebar-nav a:hover,
        .sidebar-nav a.active {
            background: rgba(255, 255, 255, 0.1);
            color: white;
            padding-left: 2rem;
            text-decoration: none;
        }

        .sidebar-nav a.active {
            background: linear-gradient(90deg, #1a4b8f 0%, #f18221 100%);
            box-shadow: 0 4px 12px rgba(109, 81, 146, 0.3);
            position: relative;
        }

        .sidebar-nav a.active::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background: #f18221;;
        }

        .sidebar-nav i {
            width: 20px;
            margin-right: 12px;
            font-size: 16px;
            transition: all var(--transition-speed) ease;
        }

        .nav-text {
            flex: 1;
            transition: opacity var(--transition-speed) ease;
            white-space: nowrap;
            overflow: hidden;
        }

        .collapsed .nav-text {
            opacity: 0;
            width: 0;
        }

        .nav-arrow {
            font-size: 12px;
            transition: transform var(--transition-speed) ease;
            margin-left: auto;
        }

        .collapsed .nav-arrow {
            opacity: 0;
        }

        .nav-badge {
            background: var(--mk-danger);
            color: white;
            font-size: 10px;
            font-weight: bold;
            padding: 3px 7px;
            border-radius: 12px;
            margin-left: auto;
            min-width: 18px;
            text-align: center;
            transition: opacity var(--transition-speed) ease;
        }

        .collapsed .nav-badge {
            opacity: 0;
        }

        /* Dropdown Menus */
        .nav-item.dropdown {
            position: relative;
        }

        .nav-item.dropdown .nav-link {
            cursor: pointer;
        }

        .dropdown-menu {
            position: static;
            float: none;
            display: none;
            margin: 0;
            border: none;
            background: rgba(0, 0, 0, 0.1);
            box-shadow: none;
            opacity: 0;
            max-height: 0;
            overflow: hidden;
            transition: all 0.4s ease;
            transform: scaleY(0);
            transform-origin: top;
        }

        .dropdown-menu.show {
            display: block;
            opacity: 1;
            max-height: 300px;
            transform: scaleY(1);
            border-radius: 4px;
            margin-top: 5px;
            padding: 5px 0;
        }

        .dropdown-item {
            padding: 0.5rem 1rem 0.5rem 2.5rem;
            transition: all 0.3s ease;
            border-radius: 4px;
            margin: 2px 8px;
            color: rgba(255, 255, 255, 0.8);
        }

        .dropdown-item:hover {
            background: rgba(255, 255, 255, 0.15);
            color: white;
            transform: translateX(5px);
        }

        .nav-item.dropdown .bi-chevron-down {
            transition: transform 0.3s ease;
        }

        .nav-item.dropdown.open .bi-chevron-down {
            transform: rotate(180deg);
        }

        /* Tooltip for collapsed state */
        .tooltip {
            position: absolute;
            left: calc(100% + 10px);
            top: 50%;
            transform: translateY(-50%);
            background: rgba(0, 0, 0, 0.9);
            color: white;
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 12px;
            white-space: nowrap;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
            z-index: 1000;
        }

        .tooltip::before {
            content: '';
            position: absolute;
            left: -4px;
            top: 50%;
            transform: translateY(-50%);
            border: 4px solid transparent;
            border-right-color: rgba(0, 0, 0, 0.9);
        }

        .collapsed .sidebar-nav a:hover .tooltip {
            opacity: 1;
        }

        /* ========== MAIN CONTENT ========== */
        .admin-content {
            flex: 1;
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            transition: margin-left var(--transition-speed) ease;
            background: var(--mk-light);
        }

        .admin-content.collapsed {
            margin-left: var(--sidebar-collapsed-width);
        }

        /* Header */
        .admin-header {
            background: var(--mk-lighter);
            padding: 1rem 2rem;
            box-shadow: var(--shadow-md);
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header-left-section {
            display: flex;
            align-items: center;
            gap: 20px;
            flex: 1;
        }

        .search-container {
            position: relative;
            min-width: 300px;
        }

        .search-input {
            width: 100%;
            padding: 10px 40px 10px 16px;
            border: 2px solid #e5e7eb;
            border-radius: 12px;
            font-size: 14px;
            transition: all 0.3s ease;
            background: var(--mk-light);
        }

        .search-input:focus {
            outline: none;
            border-color: var(--mk-primary);
            box-shadow: 0 0 0 3px rgba(109, 81, 146, 0.1);
            background: var(--mk-lighter);
        }

        .search-btn {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--mk-gray);
            cursor: pointer;
            padding: 4px;
            border-radius: 4px;
            transition: all 0.3s ease;
        }

        .search-btn:hover {
            color: var(--mk-primary);
            background: rgba(109, 81, 146, 0.1);
        }

        /* Breadcrumb */
        .breadcrumb-nav {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .breadcrumb-path {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--mk-gray);
            font-size: 14px;
        }

        .breadcrumb-item {
            color: var(--mk-primary);
            text-decoration: none;
            font-weight: 500;
        }

        .breadcrumb-item:hover {
            text-decoration: underline;
        }

        .breadcrumb-item.current {
            color: var(--mk-gray);
            font-weight: 600;
        }

        .breadcrumb-separator {
            color: var(--mk-gray-light);
        }

        /* Header Actions */
        .header-actions {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .header-timestamp {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--mk-gray);
            font-size: 14px;
            padding: 8px 12px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: var(--mk-light);
        }

        .language-selector .dropdown-toggle {
            background: none;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 8px 12px;
            color: var(--mk-gray);
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 5px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .language-selector .dropdown-toggle:hover {
            border-color: var(--mk-primary);
            color: var(--mk-primary);
        }

        .notification-btn {
            background: none;
            border: none;
            color: var(--mk-gray);
            font-size: 18px;
            padding: 8px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
        }

        .notification-btn:hover {
            background: var(--mk-light);
            color: var(--mk-primary);
        }

        .notification-badge {
            position: absolute;
            top: 2px;
            right: 2px;
            background: var(--mk-danger);
            color: white;
            border-radius: 50%;
            width: 18px;
            height: 18px;
            font-size: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        /* User Profile */
        .user-profile {
            position: relative;
        }

        .profile-toggle {
            display: flex;
            align-items: center;
            gap: 10px;
            background: none;
            border: none;
            cursor: pointer;
            padding: 8px;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .profile-toggle:hover {
            background: var(--mk-light);
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--mk-gradient-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 14px;
            border: 2px solid var(--mk-lighter);
            box-shadow: var(--shadow-md);
        }

        .user-info-header {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .user-name {
            font-weight: 600;
            color: var(--mk-dark);
            font-size: 14px;
            margin: 0;
        }

        .user-role {
            font-size: 12px;
            color: var(--mk-gray);
            margin: 0;
        }

        /* Main Content */
        .admin-main {
            padding: 2rem;
        }

        /* Cards */
        .card {
            border: none;
            border-radius: 12px;
            box-shadow: var(--shadow-md);
            margin-bottom: 1.5rem;
        }

        .card-header {
            background: var(--mk-lighter);
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            border-radius: 12px 12px 0 0 !important;
            font-weight: 600;
            color: var(--mk-dark);
            padding: 1.25rem 1.5rem;
        }

        /* Buttons */
        .btn-primary {
            background: var(--mk-gradient-primary);
            border: none;
            border-radius: 8px;
            font-weight: 600;
            padding: 10px 20px;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(109, 81, 146, 0.3);
            background: var(--mk-gradient-primary);
            border: none;
        }

        .btn-secondary {
            background: var(--mk-gray);
            border: none;
            border-radius: 8px;
            font-weight: 600;
            padding: 10px 20px;
        }

        /* Tables */
        .table {
            border-radius: 8px;
            overflow: hidden;
        }

        .table th {
            background: var(--mk-light);
            border-top: none;
            font-weight: 600;
            color: var(--mk-dark);
            border-bottom: 2px solid #e5e7eb;
        }

        .table td {
            vertical-align: middle;
            border-color: #f3f4f6;
        }

        .table-hover tbody tr:hover {
            background: rgba(109, 81, 146, 0.05);
        }

        /* Badges */
        .badge {
            font-size: 0.75em;
            font-weight: 600;
            border-radius: 6px;
            padding: 4px 8px;
        }

        /* Alerts */
        .alert {
            border-radius: 8px;
            border: none;
            padding: 1rem 1.25rem;
        }

        .alert-success {
            background: rgba(16, 185, 129, 0.1);
            color: #065f46;
            border-left: 4px solid var(--mk-success);
        }

        .alert-danger {
            background: rgba(239, 68, 68, 0.1);
            color: #7f1d1d;
            border-left: 4px solid var(--mk-danger);
        }

        .alert-warning {
            background: rgba(245, 158, 11, 0.1);
            color: #78350f;
            border-left: 4px solid var(--mk-warning);
        }

        .alert-info {
            background: rgba(59, 130, 246, 0.1);
            color: #1e3a8a;
            border-left: 4px solid var(--mk-info);
        }

        /* Flash Messages */
        .flash-messages {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1050;
            max-width: 400px;
        }

        .flash-message {
            margin-bottom: 10px;
            animation: slideInRight 0.3s ease;
        }

        @keyframes slideInRight {
            from {
                transform: translateX(100%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        /* Mobile Responsiveness */
        @media (max-width: 768px) {
            .admin-sidebar {
                margin-left: calc(-1 * var(--sidebar-width));
                transition: margin-left var(--transition-speed) ease;
            }

            .admin-sidebar.show {
                margin-left: 0;
            }

            .admin-content {
                margin-left: 0;
            }

            .mobile-menu-toggle {
                display: block;
            }

            .search-container {
                min-width: 200px;
            }

            .user-info-header {
                display: none;
            }

            .header-left-section {
                flex-direction: column;
                gap: 10px;
                align-items: flex-start;
            }
        }

        .mobile-menu-toggle {
            display: none;
            background: none;
            border: none;
            color: var(--mk-primary);
            font-size: 1.5rem;
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body>
    <!-- Messages flash -->
    <div class="flash-messages">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show flash-message" role="alert">
                    <i class="fas fa-{{ type == 'success' ? 'check-circle' : (type == 'error' ? 'exclamation-triangle' : 'info-circle') }}"></i>
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    <div class="admin-wrapper">
        <!-- Sidebar -->
        <div class="admin-sidebar" id="adminSidebar">
            <div class="sidebar-header">
                <div class="logo-container">
                    <div class="logo-frame">
                        <div class="logo-text">MK</div>
                    </div>
                </div>
                <button class="hamburger-toggle" id="hamburgerToggle">
                    <i class="fas fa-bars"></i>
                </button>
            </div>

            <ul class="sidebar-nav">
                <!-- ANALYTICS SECTION -->
                <li class="nav-section">
                    <div class="nav-section-title">Analytics</div>
                </li>

                <li class="nav-item">
                    <a href="{{ path('admin_dashboard') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_dashboard' ? 'active' : '' }}">
                        <i class="bi-speedometer2"></i>
                        <span class="nav-text">Dashboard</span>
                        <div class="tooltip">Dashboard</div>
                    </a>
                </li>

                <!-- SERVICE MANAGEMENT SECTION -->
                <li class="nav-section">
                    <div class="nav-section-title">Gestion des Services</div>
                </li>

                <li class="nav-item dropdown">
                    <a href="#" class="nav-link d-flex align-items-center justify-content-between dropdown-toggle-custom {{ app.request.get('_route') starts with 'admin_request' ? 'active' : '' }}" data-dropdown="requests">
                        <span class="d-flex align-items-center">
                            <i class="bi-journal-text"></i>
                            <span class="nav-text">Demandes</span>
                        </span>
                        <span class="nav-badge">23</span>
                        <i class="bi-chevron-down nav-arrow"></i>
                        <div class="tooltip">Gestion des Demandes</div>
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#"><i class="bi-plus-circle me-2"></i>Nouvelle Demande</a></li>
                        <li><a class="dropdown-item" href="#"><i class="bi-list-ul me-2"></i>Toutes les Demandes</a></li>
                        <li><a class="dropdown-item" href="#"><i class="bi-clock me-2"></i>En Attente</a></li>
                        <li><a class="dropdown-item" href="#"><i class="bi-check-circle me-2"></i>Terminées</a></li>
                    </ul>
                </li>

                <li class="nav-item dropdown">
                    <a href="#" class="nav-link d-flex align-items-center justify-content-between dropdown-toggle-custom {{ app.request.get('_route') starts with 'admin_procedure' ? 'active' : '' }}" data-dropdown="procedures">
                        <span class="d-flex align-items-center">
                            <i class="bi-file-earmark-text"></i>
                            <span class="nav-text">Procédures</span>
                        </span>
                        <i class="bi-chevron-down nav-arrow"></i>
                        <div class="tooltip">Gestion des Procédures</div>
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#"><i class="bi-plus-circle me-2"></i>Nouvelle Procédure</a></li>
                        <li><a class="dropdown-item" href="#"><i class="bi-list-ul me-2"></i>Toutes les Procédures</a></li>
                    </ul>
                </li>

                <li class="nav-item dropdown">
                    <a href="#" class="nav-link d-flex align-items-center justify-content-between dropdown-toggle-custom {{ app.request.get('_route') starts with 'admin_family' ? 'active' : '' }}" data-dropdown="families">
                        <span class="d-flex align-items-center">
                            <i class="bi-collection"></i>
                            <span class="nav-text">Familles de Services</span>
                        </span>
                        <i class="bi-chevron-down nav-arrow"></i>
                        <div class="tooltip">Familles de Services</div>
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="{{ path('admin_family_new') }}"><i class="bi-plus-circle me-2"></i>Nouvelle Famille</a></li>
