{{ form_start(form, {'attr': {'id': 'requestForm', 'novalidate': 'novalidate'}}) }}

<div class="row g-4">
    <div class="col-lg-8">
        <!-- Basic Information Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="d-flex align-items-center">
                    <div class="icon-wrapper me-3">
                        <i class="bi-journal-text fs-4"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0 fw-bold">Request Information</h5>
                        <small class="opacity-75">Select citizen and procedure for this request</small>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <!-- Citizen and Procedure Row -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-person me-1 text-primary"></i>{{ form_label(form.person) }}*
                        </label>
                        {{ form_widget(form.person, {
                            'attr': {'class': 'form-select form-select-lg'}
                        }) }}
                        {{ form_errors(form.person) }}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-gear me-1 text-primary"></i>{{ form_label(form.procedure) }}*
                        </label>
                        {{ form_widget(form.procedure, {
                            'attr': {'class': 'form-select form-select-lg'}
                        }) }}
                        {{ form_errors(form.procedure) }}
                    </div>
                </div>

                <!-- Status and Priority Row -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-check-circle me-1 text-primary"></i>{{ form_label(form.status) }}
                        </label>
                        {{ form_widget(form.status, {
                            'attr': {'class': 'form-select form-select-lg'}
                        }) }}
                        {{ form_errors(form.status) }}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-exclamation-triangle me-1 text-primary"></i>{{ form_label(form.priority) }}
                        </label>
                        {{ form_widget(form.priority, {
                            'attr': {'class': 'form-select form-select-lg'}
                        }) }}
                        {{ form_errors(form.priority) }}
                    </div>
                </div>

                <!-- Comments -->
                <div class="mb-4">
                    <label class="form-label fw-semibold text-dark mb-2">
                        <i class="bi-chat-left-text me-1 text-primary"></i>{{ form_label(form.comments) }}
                    </label>
                    {{ form_widget(form.comments, {
                        'attr': {
                            'class': 'form-control form-control-lg',
                            'rows': 3
                        }
                    }) }}
                    {{ form_errors(form.comments) }}
                </div>

                <!-- Admin Notes -->
                <div class="mb-3">
                    <label class="form-label fw-semibold text-dark mb-2">
                        <i class="bi-sticky me-1 text-primary"></i>{{ form_label(form.adminNotes) }}
                    </label>
                    {{ form_widget(form.adminNotes, {
                        'attr': {
                            'class': 'form-control form-control-lg',
                            'rows': 4
                        }
                    }) }}
                    {{ form_errors(form.adminNotes) }}
                </div>
            </div>
        </div>

        <!-- Financial Information Card -->
        <div class="card shadow-sm border-0 mb-4" id="financialSection">
            <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                <div class="d-flex align-items-center">
                    <div class="icon-wrapper me-3">
                        <i class="bi-currency-exchange fs-4"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0 fw-bold">Financial Details</h5>
                        <small class="opacity-75">Cost and payment information</small>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <!-- Alert for rejected/cancelled status -->
                <div class="alert alert-warning" id="paymentDisabledAlert" style="display: none;">
                    <i class="bi-exclamation-triangle me-2"></i>
                    <strong>Payment Section Disabled:</strong> Payment information is not editable for rejected or cancelled requests.
                </div>

                <!-- Cost and Payment Row -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-cash me-1 text-primary"></i>{{ form_label(form.totalCost) }}
                        </label>
                        {{ form_widget(form.totalCost, {
                            'attr': {'class': 'form-control form-control-lg'}
                        }) }}
                        {{ form_errors(form.totalCost) }}
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-credit-card me-1 text-primary"></i>{{ form_label(form.paidAmount) }}
                        </label>
                        {{ form_widget(form.paidAmount, {
                            'attr': {'class': 'form-control form-control-lg'}
                        }) }}
                        {{ form_errors(form.paidAmount) }}
                        <div class="form-text" id="paymentValidationMessage"></div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-check2-square me-1 text-primary"></i>{{ form_label(form.paymentStatus) }}
                        </label>
                        {{ form_widget(form.paymentStatus, {
                            'attr': {'class': 'form-select form-select-lg'}
                        }) }}
                        {{ form_errors(form.paymentStatus) }}
                    </div>
                </div>

                <!-- Remaining Amount Display -->
                <div class="row g-3" id="remainingAmountSection" style="display: none;">
                    <div class="col-md-12">
                        <div class="alert alert-info">
                            <i class="bi-info-circle me-2"></i>
                            <strong>Remaining Amount:</strong> <span id="remainingAmountValue">0</span> XAF
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Timeline Information Card -->
        <div class="card shadow-sm border-0 mb-4" id="timelineSection">
            <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%); color: #333 !important;">
                <div class="d-flex align-items-center">
                    <div class="icon-wrapper me-3">
                        <i class="bi-calendar-event fs-4 text-warning"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0 fw-bold text-dark">Timeline</h5>
                        <small class="text-muted">Expected completion and actual dates</small>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <!-- Alert for rejected/cancelled status -->
                <div class="alert alert-warning" id="timelineDisabledAlert" style="display: none;">
                    <i class="bi-exclamation-triangle me-2"></i>
                    <strong>Timeline Section Disabled:</strong> Timeline information is not editable for rejected or cancelled requests.
                </div>

                <!-- Dates Row -->
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-calendar-plus me-1 text-primary"></i>{{ form_label(form.expectedCompletionAt) }}
                        </label>
                        {{ form_widget(form.expectedCompletionAt, {
                            'attr': {'class': 'form-control form-control-lg'}
                        }) }}
                        {{ form_errors(form.expectedCompletionAt) }}
                        <div class="form-text">
                            <small class="text-muted">
                                <i class="bi-info-circle me-1"></i>
                                Automatically calculated based on procedure
                            </small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-calendar-check me-1 text-primary"></i>{{ form_label(form.completedAt) }}
                        </label>
                        {{ form_widget(form.completedAt, {
                            'attr': {'class': 'form-control form-control-lg'}
                        }) }}
                        {{ form_errors(form.completedAt) }}
                    </div>
                </div>
            </div>
        </div>

        <!-- Administrative Settings Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%); color: #333 !important;">
                <div class="d-flex align-items-center">
                    <div class="icon-wrapper me-3">
                        <i class="bi-gear-fill fs-4 text-secondary"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0 fw-bold text-dark">Administrative Settings</h5>
                        <small class="text-muted">System configuration options</small>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-sort-numeric-up me-1 text-primary"></i>{{ form_label(form.displayOrder) }}
                        </label>
                        {{ form_widget(form.displayOrder, {
                            'attr': {'class': 'form-control form-control-lg'}
                        }) }}
                        {{ form_errors(form.displayOrder) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Information Sidebar -->
    <div class="col-lg-4">
        <div class="position-sticky" style="top: 2rem;">
            <!-- Procedure Information -->
            <div class="card shadow-sm border-0 mb-4" id="procedureInfo" style="display: none;">
                <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <div class="d-flex align-items-center">
                        <div class="icon-wrapper me-3">
                            <i class="bi-info-circle fs-4"></i>
                        </div>
                        <div>
                            <h5 class="card-title mb-0 fw-bold">Procedure Details</h5>
                            <small class="opacity-75">Information about selected procedure</small>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div id="procedureDetails">
                        <div class="text-center text-muted">
                            <i class="bi-arrow-left-circle" style="font-size: 2rem;"></i>
                            <p class="mt-2 mb-0">Select a procedure to view details</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Guidelines -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <div class="d-flex align-items-center">
                        <i class="bi-lightbulb me-2 text-warning"></i>
                        <h6 class="card-title mb-0 fw-bold">Form Guidelines</h6>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="guidelines-list">
                        <div class="guideline-item mb-3">
                            <div class="d-flex align-items-start">
                                <i class="bi-check-circle text-success me-2 mt-1"></i>
                                <div>
                                    <strong class="text-dark">Payment Validation</strong>
                                    <p class="mb-0 small text-muted">Paid amount cannot exceed total cost or be negative</p>
                                </div>
                            </div>
                        </div>
                        <div class="guideline-item mb-3">
                            <div class="d-flex align-items-start">
                                <i class="bi-check-circle text-success me-2 mt-1"></i>
                                <div>
                                    <strong class="text-dark">Status-Based Logic</strong>
                                    <p class="mb-0 small text-muted">Payment and timeline sections disabled for rejected/cancelled requests</p>
                                </div>
                            </div>
                        </div>
                        <div class="guideline-item mb-3">
                            <div class="d-flex align-items-start">
                                <i class="bi-check-circle text-success me-2 mt-1"></i>
                                <div>
                                    <strong class="text-dark">Auto-calculation</strong>
                                    <p class="mb-0 small text-muted">Expected completion date calculated automatically</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Form Actions -->
<div class="row mt-5">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center p-4 bg-light rounded-3 border">
            <div class="form-actions-info">
                <h6 class="mb-1 fw-bold text-dark">Ready to submit?</h6>
                <small class="text-muted">Make sure all required fields are completed</small>
            </div>
            <div class="form-actions-buttons">
                <a href="{{ path('admin_request_index') }}" class="btn btn-outline-secondary btn-lg me-3">
                    <i class="bi-arrow-left me-2"></i>Cancel
                </a>
                <button type="submit" class="btn btn-primary btn-lg px-4">
                    <i class="bi-check-circle me-2"></i>
                    {{ button_label|default('Save Request') }}
                </button>
            </div>
        </div>
    </div>
</div>

{{ form_end(form) }}

<script>
// Variables globales
let currentRequestData = {{ request|default({})|json_encode|raw }};
let isEditMode = {{ request.id is defined and request.id ? 'true' : 'false' }};

// Fonction pour gérer les changements de statut
function handleStatusChange(newStatus) {
    const isRejectedOrCancelled = ['rejected', 'cancelled'].includes(newStatus);
    
    // Gérer la section financière
    const financialInputs = document.querySelectorAll('#financialSection input, #financialSection select');
    const paymentAlert = document.getElementById('paymentDisabledAlert');
    
    if (isRejectedOrCancelled) {
        financialInputs.forEach(input => {
            if (input.name !== 'request[totalCost]') { // Keep total cost visible
                input.disabled = true;
            }
        });
        paymentAlert.style.display = 'block';
        
        // Mettre à jour automatiquement le statut de paiement
        updatePaymentStatusForRejectedCancelled();
    } else {
        financialInputs.forEach(input => input.disabled = false);
        paymentAlert.style.display = 'none';
    }
    
    // Gérer la section timeline
    const timelineInputs = document.querySelectorAll('#timelineSection input');
    const timelineAlert = document.getElementById('timelineDisabledAlert');
    
    if (isRejectedOrCancelled) {
        timelineInputs.forEach(input => input.disabled = true);
        timelineAlert.style.display = 'block';
    } else {
        timelineInputs.forEach(input => {
            // Expected completion reste toujours readonly
            if (input.name !== 'request[expectedCompletionAt]') {
                input.disabled = false;
            }
        });
        timelineAlert.style.display = 'none';
    }
}

// Fonction pour mettre à jour le statut de paiement pour les requêtes rejetées/annulées
function updatePaymentStatusForRejectedCancelled() {
    const paidAmountField = document.querySelector('input[name="request[paidAmount]"]');
    const paymentStatusField = document.querySelector('select[name="request[paymentStatus]"]');
    
    if (!paidAmountField || !paymentStatusField) return;
    
    const paidAmount = parseFloat(paidAmountField.value) || 0;
    
    // Mettre à jour les options du select
    const newOptions = paidAmount > 0 ? 
        {
            'awaiting_refund': 'Awaiting Refund',
            'refunded': 'Refunded'
        } : 
        {
            'revoked': 'Revoked'
        };
    
    // Vider et repeupler les options
    paymentStatusField.innerHTML = '';
    Object.entries(newOptions).forEach(([value, label]) => {
        const option = document.createElement('option');
        option.value = value;
        option.textContent = label;
        paymentStatusField.appendChild(option);
    });
    
    // Sélectionner la valeur appropriée
    paymentStatusField.value = paidAmount > 0 ? 'awaiting_refund' : 'revoked';
}

// Fonction pour valider le montant payé
function validatePaymentAmount(value) {
    const totalCostField = document.querySelector('input[name="request[totalCost]"]');
    const paidAmountField = document.querySelector('input[name="request[paidAmount]"]');
    const messageDiv = document.getElementById('paymentValidationMessage');
    const remainingSection = document.getElementById('remainingAmountSection');
    const remainingValue = document.getElementById('remainingAmountValue');
    
    if (!totalCostField || !paidAmountField) return;
    
    const totalCost = parseFloat(totalCostField.value) || 0;
    const paidAmount = parseFloat(value) || 0;
    
    // Validation des montants négatifs
    if (paidAmount < 0) {
        paidAmountField.value = 0;
        messageDiv.innerHTML = '<small class="text-danger">Paid amount cannot be negative</small>';
        return;
    }
    
    // Validation du dépassement
    if (paidAmount > totalCost) {
        paidAmountField.value = totalCost;
        messageDiv.innerHTML = '<small class="text-warning">Paid amount adjusted to total cost</small>';
        setTimeout(() => messageDiv.innerHTML = '', 3000);
    } else {
        messageDiv.innerHTML = '';
    }
    
    // Calculer et afficher le reste à payer
    const remainingAmount = Math.max(0, totalCost - paidAmount);
    if (remainingAmount > 0 && paidAmount > 0) {
        remainingValue.textContent = remainingAmount.toLocaleString();
        remainingSection.style.display = 'block';
    } else {
        remainingSection.style.display = 'none';
    }
    
    // Mettre à jour automatiquement le statut de paiement
    autoUpdatePaymentStatus(paidAmount, totalCost);
}

// Fonction pour mettre à jour automatiquement le statut de paiement
function autoUpdatePaymentStatus(paidAmount, totalCost) {
    const paymentStatusField = document.querySelector('select[name="request[paymentStatus]"]');
    const statusField = document.querySelector('select[name="request[status]"]');
    
    if (!paymentStatusField || !statusField) return;
    
    const currentStatus = statusField.value;
    const isRejectedOrCancelled = ['rejected', 'cancelled'].includes(currentStatus);
    
    if (isRejectedOrCancelled) {
        // Ne pas modifier automatiquement pour les statuts rejetés/annulés
        return;
    }
    
    // Logique normale pour les autres statuts
    if (paidAmount === 0) {
        paymentStatusField.value = 'pending';
    } else if (paidAmount >= totalCost) {
        paymentStatusField.value = 'completed';
    } else {
        paymentStatusField.value = 'partial';
    }
}

// Fonction pour mettre à jour les informations de procédure
function updateCostAndTime(procedureId) {
    if (!procedureId) {
        document.getElementById('procedureInfo').style.display = 'none';
        return;
    }
    
    fetch(`/admin/request/api/procedure/${procedureId}/info`)
        .then(response => response.json())
        .then(data => {
            // Mettre à jour le coût
            const costField = document.querySelector('input[name="request[totalCost]"]');
            if (costField && data.cost) {
                costField.value = data.cost;
                
                // Revalider le montant payé
                const paidAmountField = document.querySelector('input[name="request[paidAmount]"]');
                if (paidAmountField) {
                    validatePaymentAmount(paidAmountField.value);
                }
            }
            
            // Calculer la date d'achèvement prévue
            if (data.processTime) {
                const match = data.processTime.match(/(\d+)/);
                const days = match ? parseInt(match[1]) : 7;
                
                const expectedDate = new Date();
                expectedDate.setDate(expectedDate.getDate() + days);
                
                const expectedField = document.querySelector('input[name="request[expectedCompletionAt]"]');
                if (expectedField) {
                    expectedField.value = expectedDate.toISOString().slice(0, 16);
                }
            }
            
            // Mettre à jour les informations de procédure
            const procedureDetails = document.getElementById('procedureDetails');
            procedureDetails.innerHTML = `
                <div class="mb-3">
                    <label class="fw-bold text-muted small">Service Cost:</label>
                    <div class="fs-5 text-success fw-bold">${data.cost ? Number(data.cost).toLocaleString() : '0'} XAF</div>
                </div>
                <div class="mb-3">
                    <label class="fw-bold text-muted small">Processing Time:</label>
                    <div class="text-info">${data.processTime || 'Not specified'}</div>
                </div>
                <div class="mb-0">
                    <label class="fw-bold text-muted small">Family:</label>
                    <div class="text-primary">${data.family || 'Not specified'}</div>
                </div>
            `;
            
            document.getElementById('procedureInfo').style.display = 'block';
        })
        .catch(error => {
            console.error('Error fetching procedure info:', error);
        });
}

// Initialisation au chargement de la page
document.addEventListener('DOMContentLoaded', function() {
    // Initialiser l'état des sections selon le statut actuel
    const statusField = document.querySelector('select[name="request[status]"]');
    if (statusField) {
        handleStatusChange(statusField.value);
    }
    
    // Initialiser la validation des montants
    const paidAmountField = document.querySelector('input[name="request[paidAmount]"]');
    if (paidAmountField && paidAmountField.value) {
        validatePaymentAmount(paidAmountField.value);
    }
    
    // Initialiser les informations de procédure si une procédure est déjà sélectionnée
    const procedureField = document.querySelector('select[name="request[procedure]"]');
    if (procedureField && procedureField.value) {
        updateCostAndTime(procedureField.value);
    }
    
    // Validation du formulaire
    document.getElementById('requestForm').addEventListener('submit', function(e) {
        const person = document.querySelector('select[name="request[person]"]').value;
        const procedure = document.querySelector('select[name="request[procedure]"]').value;
        
        if (!person || !procedure) {
            e.preventDefault();
            alert('Please select both a citizen and a procedure.');
            return false;
        }
    });
});
</script>

<style>
/* Styles pour les sections désactivées */
#financialSection.disabled,
#timelineSection.disabled {
    opacity: 0.7;
    pointer-events: none;
}

#financialSection input:disabled,
#timelineSection input:disabled,
#financialSection select:disabled,
#timelineSection select:disabled {
    background-color: #f8f9fa;
    opacity: 0.8;
}

/* Styles pour les alerts */
.alert {
    border-radius: 8px;
    border: none;
}

.alert-warning {
    background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
    border-left: 4px solid #ffc107;
}

.alert-info {
    background: linear-gradient(135deg, #d1ecf1 0%, #bee5eb 100%);
    border-left: 4px solid #17a2b8;
}

/* Animation pour les changements d'état */
.form-control,
.form-select {
    transition: all 0.3s ease;
}

.form-control:disabled,
.form-select:disabled {
    transform: scale(0.98);
}
</style>