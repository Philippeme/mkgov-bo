{{ form_start(form, {'attr': {'id': 'requestForm', 'novalidate': 'novalidate'}}) }}

<div class="row g-4">
    <div class="col-lg-8">
        <!-- Basic Information Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="d-flex align-items-center">
                    <div class="icon-wrapper me-3">
                        <i class="bi-journal-text fs-4"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0 fw-bold">Request Information</h5>
                        <small class="opacity-75">Select citizen and procedure for this request</small>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <!-- Citizen and Procedure Row -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-person me-1 text-primary"></i>{{ form_label(form.person) }}*
                        </label>
                        {{ form_widget(form.person, {
                            'attr': {'class': 'form-select form-select-lg'}
                        }) }}
                        {{ form_errors(form.person) }}
                        <div class="form-text">
                            <small class="text-muted">
                                <i class="bi-info-circle me-1"></i>
                                Select the citizen requesting this service
                            </small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-gear me-1 text-primary"></i>{{ form_label(form.procedure) }}*
                        </label>
                        {{ form_widget(form.procedure, {
                            'attr': {'class': 'form-select form-select-lg'}
                        }) }}
                        {{ form_errors(form.procedure) }}
                        <div class="form-text">
                            <small class="text-muted">
                                <i class="bi-info-circle me-1"></i>
                                Cost and timeline will be calculated automatically
                            </small>
                        </div>
                    </div>
                </div>

                <!-- Status and Priority Row -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-check-circle me-1 text-primary"></i>{{ form_label(form.status) }}
                        </label>
                        {{ form_widget(form.status, {
                            'attr': {'class': 'form-select form-select-lg'}
                        }) }}
                        {{ form_errors(form.status) }}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-exclamation-triangle me-1 text-primary"></i>{{ form_label(form.priority) }}
                        </label>
                        {{ form_widget(form.priority, {
                            'attr': {'class': 'form-select form-select-lg'}
                        }) }}
                        {{ form_errors(form.priority) }}
                    </div>
                </div>

                <!-- Status Warning for Rejected/Cancelled -->
                {% if request and request.isPaymentTimelineSectionDisabled %}
                <div class="alert alert-warning mb-4">
                    <i class="bi-exclamation-triangle me-2"></i>
                    <strong>Note:</strong> Payment and timeline sections are disabled for rejected/cancelled requests.
                </div>
                {% endif %}

                <!-- Comments -->
                <div class="mb-4">
                    <label class="form-label fw-semibold text-dark mb-2">
                        <i class="bi-chat-left-text me-1 text-primary"></i>{{ form_label(form.comments) }}
                    </label>
                    {{ form_widget(form.comments, {
                        'attr': {
                            'class': 'form-control form-control-lg',
                            'rows': 3
                        }
                    }) }}
                    {{ form_errors(form.comments) }}
                </div>

                <!-- Admin Notes -->
                <div class="mb-3">
                    <label class="form-label fw-semibold text-dark mb-2">
                        <i class="bi-sticky me-1 text-primary"></i>{{ form_label(form.adminNotes) }}
                    </label>
                    {{ form_widget(form.adminNotes, {
                        'attr': {
                            'class': 'form-control form-control-lg',
                            'rows': 4
                        }
                    }) }}
                    {{ form_errors(form.adminNotes) }}
                    <div class="form-text">
                        <small class="text-muted">
                            <i class="bi-info-circle me-1"></i>
                            Internal notes for administrative purposes only
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Financial Information Card -->
        <div class="card shadow-sm border-0 mb-4" id="financialCard">
            <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                <div class="d-flex align-items-center">
                    <div class="icon-wrapper me-3">
                        <i class="bi-currency-exchange fs-4"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0 fw-bold">Financial Details</h5>
                        <small class="opacity-75">Cost and payment information</small>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <!-- Cost and Payment Row -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-cash me-1 text-primary"></i>{{ form_label(form.totalCost) }}
                        </label>
                        {{ form_widget(form.totalCost, {
                            'attr': {'class': 'form-control form-control-lg'}
                        }) }}
                        {{ form_errors(form.totalCost) }}
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-credit-card me-1 text-primary"></i>{{ form_label(form.paidAmount) }}
                        </label>
                        {{ form_widget(form.paidAmount, {
                            'attr': {'class': 'form-control form-control-lg payment-field'}
                        }) }}
                        {{ form_errors(form.paidAmount) }}
                        <div class="form-text">
                            <small class="text-muted" id="paidAmountHelp">
                                <i class="bi-info-circle me-1"></i>
                                Amount cannot exceed total cost
                            </small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-check2-square me-1 text-primary"></i>{{ form_label(form.paymentStatus) }}
                        </label>
                        {{ form_widget(form.paymentStatus, {
                            'attr': {'class': 'form-select form-select-lg payment-field'}
                        }) }}
                        {{ form_errors(form.paymentStatus) }}
                    </div>
                </div>

                <!-- Payment Progress Bar -->
                <div class="payment-progress mb-3" id="paymentProgressContainer" style="display: none;">
                    <label class="form-label fw-semibold text-dark mb-2">Payment Progress</label>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-success" role="progressbar" id="paymentProgressBar" 
                             style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mt-1">
                        <small class="text-muted">Paid</small>
                        <small class="text-muted" id="paymentPercentage">0%</small>
                        <small class="text-muted">Total</small>
                    </div>
                </div>

                <!-- Remaining Amount Display -->
                <div class="remaining-amount" id="remainingAmountContainer" style="display: none;">
                    <div class="alert alert-info">
                        <i class="bi-info-circle me-2"></i>
                        <strong>Remaining to pay:</strong> <span id="remainingAmount">0</span> XAF
                    </div>
                </div>
            </div>
        </div>

        <!-- Timeline Information Card -->
        <div class="card shadow-sm border-0 mb-4" id="timelineCard">
            <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%); color: #333 !important;">
                <div class="d-flex align-items-center">
                    <div class="icon-wrapper me-3">
                        <i class="bi-calendar-event fs-4 text-warning"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0 fw-bold text-dark">Timeline</h5>
                        <small class="text-muted">Expected completion and actual dates</small>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <!-- Dates Row -->
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-calendar-plus me-1 text-primary"></i>{{ form_label(form.expectedCompletionAt) }}
                        </label>
                        {{ form_widget(form.expectedCompletionAt, {
                            'attr': {'class': 'form-control form-control-lg timeline-field'}
                        }) }}
                        {{ form_errors(form.expectedCompletionAt) }}
                        <div class="form-text">
                            <small class="text-muted">
                                <i class="bi-info-circle me-1"></i>
                                Calculated automatically based on procedure
                            </small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-calendar-check me-1 text-primary"></i>{{ form_label(form.completedAt) }}
                        </label>
                        {{ form_widget(form.completedAt, {
                            'attr': {'class': 'form-control form-control-lg timeline-field'}
                        }) }}
                        {{ form_errors(form.completedAt) }}
                        <div class="form-text">
                            <small class="text-muted">
                                <i class="bi-info-circle me-1"></i>
                                Set when request is marked as completed
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Administrative Settings Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%); color: #333 !important;">
                <div class="d-flex align-items-center">
                    <div class="icon-wrapper me-3">
                        <i class="bi-gear-fill fs-4 text-secondary"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0 fw-bold text-dark">Administrative Settings</h5>
                        <small class="text-muted">System configuration options</small>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-sort-numeric-up me-1 text-primary"></i>{{ form_label(form.displayOrder) }}
                        </label>
                        {{ form_widget(form.displayOrder, {
                            'attr': {'class': 'form-control form-control-lg'}
                        }) }}
                        {{ form_errors(form.displayOrder) }}
                        <div class="form-text">
                            <small class="text-muted">
                                <i class="bi-info-circle me-1"></i>
                                Used for sorting requests in lists and reports
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Information Sidebar -->
    <div class="col-lg-4">
        <div class="position-sticky" style="top: 2rem;">
            <!-- Procedure Information -->
            <div class="card shadow-sm border-0 mb-4" id="procedureInfo" style="display: none;">
                <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <div class="d-flex align-items-center">
                        <div class="icon-wrapper me-3">
                            <i class="bi-info-circle fs-4"></i>
                        </div>
                        <div>
                            <h5 class="card-title mb-0 fw-bold">Procedure Details</h5>
                            <small class="opacity-75">Information about selected procedure</small>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div id="procedureDetails">
                        <div class="text-center text-muted">
                            <i class="bi-arrow-left-circle" style="font-size: 2rem;"></i>
                            <p class="mt-2 mb-0">Select a procedure to view details</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Guidelines -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <div class="d-flex align-items-center">
                        <i class="bi-lightbulb me-2 text-warning"></i>
                        <h6 class="card-title mb-0 fw-bold">Form Guidelines</h6>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="guidelines-list">
                        <div class="guideline-item mb-3">
                            <div class="d-flex align-items-start">
                                <i class="bi-check-circle text-success me-2 mt-1"></i>
                                <div>
                                    <strong class="text-dark">Payment Validation</strong>
                                    <p class="mb-0 small text-muted">Paid amount cannot exceed total cost</p>
                                </div>
                            </div>
                        </div>
                        <div class="guideline-item mb-3">
                            <div class="d-flex align-items-start">
                                <i class="bi-check-circle text-success me-2 mt-1"></i>
                                <div>
                                    <strong class="text-dark">Status Dependencies</strong>
                                    <p class="mb-0 small text-muted">Payment options change based on request status</p>
                                </div>
                            </div>
                        </div>
                        <div class="guideline-item mb-3">
                            <div class="d-flex align-items-start">
                                <i class="bi-check-circle text-success me-2 mt-1"></i>
                                <div>
                                    <strong class="text-dark">Timeline Protection</strong>
                                    <p class="mb-0 small text-muted">Expected completion is auto-calculated</p>
                                </div>
                            </div>
                        </div>
                        <div class="guideline-item">
                            <div class="d-flex align-items-start">
                                <i class="bi-info-circle text-info me-2 mt-1"></i>
                                <div>
                                    <strong class="text-dark">Disabled Sections</strong>
                                    <p class="mb-0 small text-muted">Payment/Timeline disabled for rejected/cancelled</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Form Actions -->
<div class="row mt-5">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center p-4 bg-light rounded-3 border">
            <div class="form-actions-info">
                <h6 class="mb-1 fw-bold text-dark">Ready to submit?</h6>
                <small class="text-muted">Make sure all required fields are completed</small>
            </div>
            <div class="form-actions-buttons">
                <a href="{{ path('admin_request_index') }}" class="btn btn-outline-secondary btn-lg me-3">
                    <i class="bi-arrow-left me-2"></i>Cancel
                </a>
                <button type="submit" class="btn btn-primary btn-lg px-4">
                    <i class="bi-check-circle me-2"></i>
                    {{ button_label|default('Save Request') }}
                </button>
            </div>
        </div>
    </div>
</div>

{{ form_end(form) }}

<script>
// Enhanced form management with new features
document.addEventListener('DOMContentLoaded', function() {
    const statusField = document.querySelector('select[name="request[status]"]');
    const paymentStatusField = document.querySelector('select[name="request[paymentStatus]"]');
    const totalCostField = document.querySelector('input[name="request[totalCost]"]');
    const paidAmountField = document.querySelector('input[name="request[paidAmount]"]');
    const financialCard = document.getElementById('financialCard');
    const timelineCard = document.getElementById('timelineCard');

    // Initialize form state
    updateFormState();
    updatePaymentProgress();
    updateRemainingAmount();

    // Status change handler
    if (statusField) {
        statusField.addEventListener('change', function() {
            updatePaymentStatusOptions(this.value);
            updateFormState();
        });
    }

    // Paid amount validation and auto-update
    if (paidAmountField) {
        paidAmountField.addEventListener('input', function() {
            validateAndUpdatePaymentStatus(this);
            updatePaymentProgress();
            updateRemainingAmount();
        });
    }

    function updateFormState() {
        const status = statusField ? statusField.value : '';
        const isDisabled = ['rejected', 'cancelled'].includes(status);
        
        // Toggle card visibility/styling
        if (financialCard && timelineCard) {
            if (isDisabled) {
                financialCard.style.opacity = '0.6';
                timelineCard.style.opacity = '0.6';
                
                // Disable payment and timeline fields
                document.querySelectorAll('.payment-field, .timeline-field').forEach(field => {
                    field.setAttribute('readonly', true);
                    field.setAttribute('disabled', true);
                });
            } else {
                financialCard.style.opacity = '1';
                timelineCard.style.opacity = '1';
                
                // Enable payment fields (but keep expectedCompletionAt readonly)
                document.querySelectorAll('.payment-field').forEach(field => {
                    field.removeAttribute('readonly');
                    field.removeAttribute('disabled');
                });
                
                // Keep expectedCompletionAt readonly always
                const expectedField = document.querySelector('#request_expectedCompletionAt');
                if (expectedField) {
                    expectedField.setAttribute('readonly', true);
                }
            }
        }
    }

    function updatePaymentStatusOptions(requestStatus) {
        if (!paymentStatusField) return;
        
        const currentPaymentStatus = paymentStatusField.value;
        
        // Clear existing options
        paymentStatusField.innerHTML = '';
        
        let options = {};
        
        if (['rejected', 'cancelled'].includes(requestStatus)) {
            // Limited options for rejected/cancelled
            if (currentPaymentStatus === 'pending_refund') {
                options = {
                    'pending_refund': 'Pending Refund',
                    'refunded': 'Refunded'
                };
            } else if (currentPaymentStatus === 'revoked') {
                options = {'revoked': 'Revoked'};
            } else if (currentPaymentStatus === 'refunded') {
                options = {'refunded': 'Refunded'};
            } else {
                // Determine based on paid amount
                const paidAmount = parseFloat(paidAmountField?.value || 0);
                if (paidAmount > 0) {
                    options = {'pending_refund': 'Pending Refund'};
                } else {
                    options = {'revoked': 'Revoked'};
                }
            }
        } else {
            // Normal options for active requests
            options = {
                'pending': 'Pending',
                'partial': 'Partial',
                'completed': 'Completed'
            };
        }
        
        // Add options to select
        Object.entries(options).forEach(([value, label]) => {
            const option = document.createElement('option');
            option.value = value;
            option.textContent = label;
            if (value === currentPaymentStatus) {
                option.selected = true;
            }
            paymentStatusField.appendChild(option);
        });
    }

    function validateAndUpdatePaymentStatus(paidAmountField) {
        const paidAmount = parseFloat(paidAmountField.value || 0);
        const totalCost = parseFloat(totalCostField?.value || 0);
        const helpText = document.getElementById('paidAmountHelp');
        
        // Validation
        if (paidAmount < 0) {
            paidAmountField.setCustomValidity('Amount cannot be negative');
            if (helpText) helpText.innerHTML = '<i class="bi-exclamation-triangle me-1 text-danger"></i>Amount cannot be negative';
            return;
        }
        
        if (paidAmount > totalCost && totalCost > 0) {
            paidAmountField.setCustomValidity('Amount cannot exceed total cost');
            if (helpText) helpText.innerHTML = '<i class="bi-exclamation-triangle me-1 text-danger"></i>Amount cannot exceed total cost';
            return;
        }
        
        paidAmountField.setCustomValidity('');
        if (helpText) helpText.innerHTML = '<i class="bi-info-circle me-1"></i>Amount cannot exceed total cost';
        
        // Auto-update payment status (only for active requests)
        const requestStatus = statusField?.value || '';
        if (!['rejected', 'cancelled'].includes(requestStatus) && paymentStatusField) {
            if (paidAmount === 0) {
                paymentStatusField.value = 'pending';
            } else if (paidAmount >= totalCost && totalCost > 0) {
                paymentStatusField.value = 'completed';
            } else if (paidAmount > 0) {
                paymentStatusField.value = 'partial';
            }
        }
    }

    function updatePaymentProgress() {
        const paidAmount = parseFloat(paidAmountField?.value || 0);
        const totalCost = parseFloat(totalCostField?.value || 0);
        const progressContainer = document.getElementById('paymentProgressContainer');
        const progressBar = document.getElementById('paymentProgressBar');
        const percentageText = document.getElementById('paymentPercentage');
        
        if (!progressContainer || !progressBar || !percentageText) return;
        
        if (totalCost > 0) {
            const percentage = Math.min(100, Math.round((paidAmount / totalCost) * 100));
            progressBar.style.width = percentage + '%';
            progressBar.setAttribute('aria-valuenow', percentage);
            percentageText.textContent = percentage + '%';
            progressContainer.style.display = 'block';
        } else {
            progressContainer.style.display = 'none';
        }
    }

    function updateRemainingAmount() {
        const paidAmount = parseFloat(paidAmountField?.value || 0);
        const totalCost = parseFloat(totalCostField?.value || 0);
        const remainingContainer = document.getElementById('remainingAmountContainer');
        const remainingAmountSpan = document.getElementById('remainingAmount');
        const paymentStatus = paymentStatusField?.value || '';
        
        if (!remainingContainer || !remainingAmountSpan) return;
        
        if (paymentStatus === 'partial' && totalCost > paidAmount) {
            const remaining = totalCost - paidAmount;
            remainingAmountSpan.textContent = remaining.toLocaleString();
            remainingContainer.style.display = 'block';
        } else {
            remainingContainer.style.display = 'none';
        }
    }

    // Procedure change handler (existing functionality)
    window.updateCostAndTime = function(procedureId) {
        if (!procedureId) return;
        
        fetch(`/admin/request/api/procedure/${procedureId}/info`)
            .then(response => response.json())
            .then(data => {
                if (totalCostField && data.cost) {
                    totalCostField.value = data.cost;
                    updatePaymentProgress();
                    updateRemainingAmount();
                }
                
                if (data.processTime) {
                    const match = data.processTime.match(/(\d+)/);
                    const days = match ? parseInt(match[1]) : 7;
                    
                    const expectedDate = new Date();
                    expectedDate.setDate(expectedDate.getDate() + days);
                    
                    const expectedField = document.querySelector('input[name="request[expectedCompletionAt]"]');
                    if (expectedField) {
                        expectedField.value = expectedDate.toISOString().slice(0, 16);
                    }
                }
            })
            .catch(error => console.error('Error fetching procedure info:', error));
    };

    // Form submission validation
    document.getElementById('requestForm').addEventListener('submit', function(e) {
        const person = document.querySelector('select[name="request[person]"]').value;
        const procedure = document.querySelector('select[name="request[procedure]"]').value;
        
        if (!person || !procedure) {
            e.preventDefault();
            alert('Please select both a citizen and a procedure.');
            return false;
        }
    });
});
</script>