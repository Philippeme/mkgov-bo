{{ form_start(form, {'attr': {'id': 'publicEntityForm', 'enctype': 'multipart/form-data'}}) }}
<div class="row">
    <div class="col-md-8">
        <div class="mb-3">{{ form_row(form.institutionName, {'label_attr': {'class': 'form-label fw-bold'}, 'attr': {'class': 'form-control'}}) }}</div>
        <div class="mb-3">{{ form_row(form.department, {'label_attr': {'class': 'form-label fw-bold'}, 'attr': {'class': 'form-select'}}) }}</div>
        <div class="mb-3">{{ form_row(form.headquartersAddress, {'label_attr': {'class': 'form-label fw-bold'}, 'attr': {'class': 'form-control', 'rows': 3}}) }}</div>
        
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">{{ form_row(form.phoneNumber, {'label_attr': {'class': 'form-label fw-bold'}, 'attr': {'class': 'form-control'}}) }}</div>
                <div class="mb-3">{{ form_row(form.email, {'label_attr': {'class': 'form-label fw-bold'}, 'attr': {'class': 'form-control'}}) }}</div>
                <div class="mb-3">{{ form_row(form.website, {'label_attr': {'class': 'form-label fw-bold'}, 'attr': {'class': 'form-control'}}) }}</div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">{{ form_row(form.contactPersonName, {'label_attr': {'class': 'form-label fw-bold'}, 'attr': {'class': 'form-control'}}) }}</div>
                <div class="mb-3">{{ form_row(form.contactPersonEmail, {'label_attr': {'class': 'form-label fw-bold'}, 'attr': {'class': 'form-control'}}) }}</div>
                <div class="mb-3">{{ form_row(form.contactPersonPhone, {'label_attr': {'class': 'form-label fw-bold'}, 'attr': {'class': 'form-control'}}) }}</div>
            </div>
        </div>
        
        <div class="mb-3">{{ form_row(form.description, {'label_attr': {'class': 'form-label fw-bold'}, 'attr': {'class': 'form-control', 'rows': 4}}) }}</div>
        
        <div class="row">
            <div class="col-md-4">{{ form_row(form.code, {'label_attr': {'class': 'form-label fw-bold'}, 'attr': {'class': 'form-control'}}) }}</div>
            <div class="col-md-4">{{ form_row(form.status, {'label_attr': {'class': 'form-label fw-bold'}, 'attr': {'class': 'form-select'}}) }}</div>
            <div class="col-md-4">{{ form_row(form.displayOrder, {'label_attr': {'class': 'form-label fw-bold'}, 'attr': {'class': 'form-control'}}) }}</div>
        </div>
        
    </div>
    
    <div class="col-md-4">
        <div class="card bg-light mb-4">
            <div class="card-header">
                <h6 class="card-title mb-0"><i class="bi-image me-2"></i>Institution Logo</h6>
            </div>
            <div class="card-body">
                <div class="mb-3 text-center">
                    <div id="logoPreview" class="border rounded p-3" style="min-height: 120px;">
                        {% if public_entity.logo %}
                            <img src="{{ asset('uploads/public_entities/' ~ public_entity.logo) }}" alt="{{ public_entity.institutionName }}" class="img-fluid rounded" style="max-height: 100px;">
                            <p class="mt-2 mb-0 small text-muted">Current Logo</p>
                        {% else %}
                            <div class="text-muted"><i class="bi-image" style="font-size: 2rem;"></i><p class="mt-2 mb-0">No logo uploaded</p></div>
                        {% endif %}
                    </div>
                </div>
                
                <div class="mb-3">{{ form_row(form.logoFile, {'label_attr': {'class': 'form-label fw-bold'}, 'attr': {'class': 'form-control', 'accept': 'image/*', 'onchange': 'previewLogo(this)'}}) }}</div>
                
                <div class="mb-3">
                    <div class="form-check">
                        {{ form_widget(form.removeLogo, {'attr': {'class': 'form-check-input'}}) }}
                        {{ form_label(form.removeLogo, 'Remove current logo', {'label_attr': {'class': 'form-check-label text-danger'}}) }}
                    </div>
                </div>
                
                <div class="form-text"><small><i class="bi-info-circle me-1"></i>Upload institution logo. Max: 5MB</small></div>
            </div>
        </div>
        
        <!-- Active Status Section -->
        <div class="card bg-light">
            <div class="card-header">
                <h6 class="card-title mb-0"><i class="bi-toggle-on me-2"></i>Status Settings</h6>
            </div>
            <div class="card-body">
                <div class="form-check form-switch">
                    {{ form_widget(form.isActive, {'attr': {'class': 'form-check-input'}}) }}
                    {{ form_label(form.isActive, 'Active Status', {'label_attr': {'class': 'form-check-label fw-bold'}}) }}
                </div>
                <div class="form-text mt-2">
                    <small><i class="bi-info-circle me-1"></i>Enable or disable this public entity</small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <button type="submit" class="btn btn-primary"><i class="bi-check-circle me-2"></i>{{ button_label|default('Save Public Entity') }}</button>
    <a href="{{ path('admin_public_entity_index') }}" class="btn btn-secondary"><i class="bi-arrow-left me-2"></i>Cancel</a>
</div>

{{ form_end(form) }}

<script>
function previewLogo(input) {
    const preview = document.getElementById('logoPreview');
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
            preview.innerHTML = `<img src="${e.target.result}" class="img-fluid rounded" style="max-height: 100px;" alt="Logo preview"><p class="mt-2 mb-0 small text-muted">Logo Preview</p>`;
        };
        reader.readAsDataURL(input.files[0]);
        const removeCheckbox = document.querySelector('input[name="public_entity[removeLogo]"]');
        if (removeCheckbox) removeCheckbox.checked = false;
    }
}

document.getElementById('publicEntityForm').addEventListener('submit', function(e) {
    const institutionName = document.querySelector('input[name="public_entity[institutionName]"]').value.trim();
    const department = document.querySelector('select[name="public_entity[department]"]').value;
    const address = document.querySelector('textarea[name="public_entity[headquartersAddress]"]').value.trim();
    
    if (!institutionName || !department || !address) {
        e.preventDefault();
        alert('Please fill in all required fields.');
        return false;
    }
});
</script>