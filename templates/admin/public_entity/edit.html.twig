{% extends 'admin/base.html.twig' %}

{% block title %}Edit Public Entity{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">
        <i class="bi-pencil me-2"></i>
        Edit Public Entity: {{ public_entity.institutionName }}
    </h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="{{ path('admin_public_entity_index') }}">Public Entities</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin_public_entity_show', {'id': public_entity.id}) }}">{{ public_entity.institutionName }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit</li>
        </ol>
    </nav>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-warning text-dark">
        <h5 class="card-title mb-0">
            <i class="bi-building me-2"></i>
            Update Public Entity Information
        </h5>
    </div>
    <div class="card-body">
        {{ include('admin/public_entity/_form.html.twig', {'button_label': 'Update Public Entity'}) }}
    </div>
</div>
{% endblock %}