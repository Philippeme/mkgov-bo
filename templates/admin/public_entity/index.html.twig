{% extends 'admin/base.html.twig' %}
{% block title %}Public Entities{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0"><i class="bi-building me-2"></i>Public Entities Management</h1>
    <a href="{{ path('admin_public_entity_new') }}" class="btn btn-primary">
        <i class="bi-plus-circle me-2"></i>New Public Entity
    </a>
</div>

{% if public_entities|length > 0 %}
<div class="card shadow-sm">
    <div class="card-header bg-light">
        <h5 class="card-title mb-0"><i class="bi-list-ul me-2"></i>All Public Entities ({{ public_entities|length }})</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th width="5%">#</th>
                        <th width="8%">Logo</th>
                        <th width="20%">Institution</th>
                        <th width="12%">Department</th>
                        <th width="15%">Contact</th>
                        <th width="15%">Address</th>
                        <th width="8%">Status</th>
                        <th width="8%">Order</th>
                        <th width="9%">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for entity in public_entities %}
                    <tr>
                        <td class="text-muted">#{{ entity.id }}</td>
                        <td>
                            {% if entity.logo %}
                                <img src="{{ asset('uploads/public_entities/' ~ entity.logo) }}" alt="{{ entity.institutionName }}" class="img-thumbnail" style="width: 40px; height: 40px; object-fit: cover;">
                            {% else %}
                                <div class="bg-light d-flex align-items-center justify-content-center rounded" style="width: 40px; height: 40px;">
                                    <i class="bi-building text-muted"></i>
                                </div>
                            {% endif %}
                        </td>
                        <td>
                            <strong>{{ entity.institutionName }}</strong>
                            <div class="small text-muted">
                                {% if entity.code %}<span class="badge bg-info badge-sm">{{ entity.code }}</span>{% endif %}
                                Created: {{ entity.createdAt|date('M d, Y') }}
                            </div>
                        </td>
                        <td>
                            {% if entity.department %}
                                <span class="badge bg-primary">{{ entity.department.name }}</span>
                            {% else %}
                                <span class="badge bg-warning">No Department</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if entity.email %}<div class="small"><i class="bi-envelope me-1"></i>{{ entity.email|slice(0, 20) }}{% if entity.email|length > 20 %}...{% endif %}</div>{% endif %}
                            {% if entity.phoneNumber %}<div class="small"><i class="bi-telephone me-1"></i>{{ entity.phoneNumber }}</div>{% endif %}
                            {% if entity.contactPersonName %}<div class="small text-muted">Contact: {{ entity.contactPersonName }}</div>{% endif %}
                        </td>
                        <td>
                            <div class="text-truncate" style="max-width: 150px;" title="{{ entity.headquartersAddress }}">
                                {{ entity.headquartersAddress|slice(0, 50) }}{% if entity.headquartersAddress|length > 50 %}...{% endif %}
                            </div>
                        </td>
                        <td>
                            <div class="form-check form-switch form-check-sm">
                                <input class="form-check-input status-toggle" type="checkbox" data-entity-id="{{ entity.id }}" {% if entity.isActive %}checked{% endif %}>
                                <label class="form-check-label small">{{ entity.isActive ? 'Active' : 'Inactive' }}</label>
                            </div>
                            <span class="badge bg-{{ entity.status == 'active' ? 'success' : 'secondary' }} badge-sm">{{ entity.status|title }}</span>
                        </td>
                        <td class="text-center"><span class="badge bg-secondary">{{ entity.displayOrder }}</span></td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a href="{{ path('admin_public_entity_show', {'id': entity.id}) }}" class="btn btn-outline-info" title="View"><i class="bi-eye"></i></a>
                                <a href="{{ path('admin_public_entity_edit', {'id': entity.id}) }}" class="btn btn-outline-warning" title="Edit"><i class="bi-pencil"></i></a>
                                <button type="button" class="btn btn-outline-danger delete-btn" data-entity-id="{{ entity.id }}" data-entity-name="{{ entity.institutionName }}" title="Delete"><i class="bi-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% else %}
<div class="text-center py-5">
    <i class="bi-building text-muted" style="font-size: 4rem;"></i>
    <h3 class="text-muted mt-3">No public entities found</h3>
    <p class="text-muted">Start by creating your first public entity</p>
    <a href="{{ path('admin_public_entity_new') }}" class="btn btn-primary">
        <i class="bi-plus-circle me-2"></i>Create First Public Entity
    </a>
</div>
{% endif %}

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi-exclamation-triangle me-2"></i>Confirm Deletion</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the public entity <strong id="entityName"></strong>?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" style="display: inline;">
                    <input type="hidden" name="_token" id="deleteToken">
                    <button type="submit" class="btn btn-danger"><i class="bi-trash me-1"></i>Delete Entity</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.status-toggle').forEach(function(toggle) {
        toggle.addEventListener('change', function() {
            const entityId = this.dataset.entityId;
            fetch(`/admin/public-entity/${entityId}/toggle-status`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'}
            }).then(response => response.json()).then(data => {
                if (data.success) {
                    const label = this.parentElement.querySelector('.form-check-label');
                    label.textContent = data.status ? 'Active' : 'Inactive';
                } else {
                    this.checked = !this.checked;
                    alert('Error: ' + data.message);
                }
            }).catch(() => { this.checked = !this.checked; alert('Error updating status'); });
        });
    });

    document.querySelectorAll('.delete-btn').forEach(function(button) {
        button.addEventListener('click', function() {
            const entityId = this.dataset.entityId;
            const entityName = this.dataset.entityName;
            document.getElementById('entityName').textContent = entityName;
            document.getElementById('deleteForm').action = `/admin/public-entity/${entityId}/delete`;
            document.getElementById('deleteToken').value = '{{ csrf_token("delete") }}';
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        });
    });
});
</script>
{% endblock %}