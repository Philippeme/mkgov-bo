{# templates/admin/permission/_form.html.twig #}
{{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'needs-validation'}}) }}
    <div class="row">
        <div class="col-md-8">
            <!-- Basic Information -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-key me-2"></i>Permission Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.name) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.label) }}
                        </div>
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.description) }}
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.category) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.displayOrder) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.action) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.resource) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Settings -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-cog me-2"></i>Settings
                    </h5>
                </div>
                <div class="card-body">
                    <div class="form-check mb-3">
                        {{ form_widget(form.isActive) }}
                        {{ form_label(form.isActive) }}
                        {% if form.isActive.vars.help %}
                            <div class="form-text">{{ form.isActive.vars.help }}</div>
                        {% endif %}
                    </div>
                    {% if form.isSystem is defined %}
                        <div class="form-check mb-3">
                            {{ form_widget(form.isSystem) }}
                            {{ form_label(form.isSystem) }}
                            {% if form.isSystem.vars.help %}
                                <div class="form-text">{{ form.isSystem.vars.help }}</div>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- Permission Preview -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-eye me-2"></i>Preview
                    </h5>
                </div>
                <div class="card-body">
                    <div class="permission-preview">
                        <span class="badge bg-primary" id="actionBadge">general</span>
                        <div class="mt-2">
                            <strong id="permissionLabel">Permission Label</strong>
                        </div>
                        <div class="mt-1">
                            <code id="permissionName">permission_name</code>
                        </div>
                        {% if permission.id %}
                            <div class="mt-2">
                                <small class="text-muted">Full Name: <span id="fullPermissionName">{{ permission.fullPermissionName }}</span></small>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Permission Information (for edit mode) -->
            {% if permission.id %}
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-info-circle me-2"></i>Permission Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-sm">
                            <tr>
                                <td><strong>Created:</strong></td>
                                <td>{{ permission.createdAt|date('d/m/Y H:i') }}</td>
                            </tr>
                            <tr>
                                <td><strong>Last Updated:</strong></td>
                                <td>{{ permission.updatedAt|date('d/m/Y H:i') }}</td>
                            </tr>
                            <tr>
                                <td><strong>Roles:</strong></td>
                                <td>{{ permission.rolesCount }}</td>
                            </tr>
                            <tr>
                                <td><strong>Status:</strong></td>
                                <td>
                                    {% if permission.isActive %}
                                        <span class="badge bg-success">Active</span>
                                    {% else %}
                                        <span class="badge bg-danger">Inactive</span>
                                    {% endif %}
                                    {% if permission.isSystem %}
                                        <span class="badge bg-secondary">System</span>
                                    {% endif %}
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            {% endif %}

            <!-- Help -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-question-circle me-2"></i>Help
                    </h5>
                </div>
                <div class="card-body">
                    <h6>Permission Naming:</h6>
                    <ul class="small">
                        <li>Use lowercase letters and underscores only</li>
                        <li>Examples: create_user, read_project, manage_system</li>
                        <li>Keep names descriptive but concise</li>
                    </ul>
                    
                    <h6 class="mt-3">Action Types:</h6>
                    <div class="d-flex flex-wrap gap-1">
                        <span class="badge bg-success">Create</span>
                        <span class="badge bg-info">Read</span>
                        <span class="badge bg-warning text-dark">Update</span>
                        <span class="badge bg-danger">Delete</span>
                        <span class="badge bg-primary">Manage</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Form Actions -->
    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between">
                <div>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>
                        {{ button_label|default(permission.id ? 'Update Permission' : 'Create Permission') }}
                    </button>
                    <button type="button" class="btn btn-outline-secondary ms-2" onclick="history.back()">
                        <i class="fas fa-times me-1"></i> Cancel
                    </button>
                </div>
                <div>
                    {% if permission.id %}
                        <a href="{{ path('admin_permission_show', {'id': permission.id}) }}" class="btn btn-outline-info">
                            <i class="fas fa-eye me-1"></i> View Permission
                        </a>
                    {% endif %}
                    <a href="{{ path('admin_permission_index') }}" class="btn btn-outline-secondary">
                        <i class="fas fa-list me-1"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
{{ form_end(form) }}

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Permission name validation and auto-formatting
    const nameInput = document.querySelector('input[name*="name"]');
    const labelInput = document.querySelector('input[name*="label"]');
    const actionSelect = document.querySelector('select[name*="action"]');
    const resourceInput = document.querySelector('input[name*="resource"]');
    
    // Preview elements
    const actionBadge = document.getElementById('actionBadge');
    const permissionLabel = document.getElementById('permissionLabel');
    const permissionName = document.getElementById('permissionName');
    const fullPermissionName = document.getElementById('fullPermissionName');

    function updatePreview() {
        if (actionBadge && actionSelect) {
            const action = actionSelect.value || 'general';
            actionBadge.textContent = action;
            actionBadge.className = 'badge ' + getBadgeClass(action);
        }
        
        if (permissionLabel && labelInput) {
            permissionLabel.textContent = labelInput.value || 'Permission Label';
        }
        
        if (permissionName && nameInput) {
            permissionName.textContent = nameInput.value || 'permission_name';
        }
        
        if (fullPermissionName && actionSelect && resourceInput) {
            const action = actionSelect.value;
            const resource = resourceInput.value;
            if (action && resource) {
                fullPermissionName.textContent = action + '_' + resource;
            } else if (nameInput) {
                fullPermissionName.textContent = nameInput.value || '';
            }
        }
    }

    function getBadgeClass(action) {
        const classes = {
            'create': 'bg-success',
            'read': 'bg-info',
            'view': 'bg-info',
            'update': 'bg-warning text-dark',
            'delete': 'bg-danger',
            'manage': 'bg-primary',
            'admin': 'bg-primary',
            'execute': 'bg-secondary'
        };
        return classes[action] || 'bg-light text-dark';
    }

    if (nameInput) {
        nameInput.addEventListener('input', function() {
            let value = this.value.toLowerCase();
            // Remove invalid characters
            value = value.replace(/[^a-z_]/g, '');
            this.value = value;
            updatePreview();
        });
    }

    if (labelInput) {
        labelInput.addEventListener('input', updatePreview);
    }

    if (actionSelect) {
        actionSelect.addEventListener('change', updatePreview);
    }

    if (resourceInput) {
        resourceInput.addEventListener('input', function() {
            let value = this.value.toLowerCase();
            // Remove invalid characters
            value = value.replace(/[^a-z_]/g, '');
            this.value = value;
            updatePreview();
        });
    }

    // Auto-generate permission name from action and resource
    if (actionSelect && resourceInput && nameInput) {
        function autoGenerateName() {
            const action = actionSelect.value;
            const resource = resourceInput.value;
            if (action && resource && !nameInput.value) {
                nameInput.value = action + '_' + resource;
                updatePreview();
            }
        }

        actionSelect.addEventListener('change', autoGenerateName);
        resourceInput.addEventListener('input', autoGenerateName);
    }

    // Initial preview update
    updatePreview();

    // Form validation
    const form = document.querySelector('.needs-validation');
    if (form) {
        form.addEventListener('submit', function(event) {
            if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
            }
            form.classList.add('was-validated');
        });
    }
});
</script>