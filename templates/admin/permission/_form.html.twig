{{ form_start(form) }}
    <div class="row">
        <div class="col-md-8">
            <div class="mb-3">
                {{ form_row(form.name) }}
            </div>
            <div class="mb-3">
                {{ form_row(form.description) }}
            </div>
        </div>
        <div class="col-md-4">
            <div class="mb-3">
                {{ form_row(form.displayOrder) }}
            </div>
        </div>
    </div>
    <button class="btn btn-primary">{{ button_label|default('Save') }}</button>
    <a href="{{ path('admin_permission_index') }}" class="btn btn-secondary">Cancel</a>
{{ form_end(form) }}