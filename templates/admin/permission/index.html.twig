{# templates/admin/permission/index.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block title %}Permissions Management{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1><i class="fas fa-key me-2"></i>Permissions Management</h1>
        <p class="text-muted mb-0">Manage system permissions and access control</p>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_permission_new') }}" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> New Permission
        </a>
        <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#crudGeneratorModal">
            <i class="fas fa-magic me-1"></i> Generate CRUD
        </button>
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="fas fa-download me-1"></i> Export
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="{{ path('admin_permission_export') }}"><i class="fas fa-file-csv me-2"></i>Export as CSV</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title text-white-50">Total Permissions</h6>
                        <h3 class="mb-0">{{ statistics.total }}</h3>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-key fa-2x text-white-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title text-white-50">Active</h6>
                        <h3 class="mb-0">{{ statistics.active }}</h3>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-check-circle fa-2x text-white-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title text-white-50">System</h6>
                        <h3 class="mb-0">{{ statistics.system }}</h3>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-cog fa-2x text-white-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title text-white-50">Categories</h6>
                        <h3 class="mb-0">{{ categories|length }}</h3>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-tags fa-2x text-white-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Categories Statistics -->
{% if categories_stats|length > 0 %}
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Permissions by Category</h5>
        </div>
        <div class="card-body">
            <div class="row">
                {% for category, count in categories_stats %}
                    <div class="col-md-2 text-center mb-3">
                        <div class="card border">
                            <div class="card-body py-3">
                                <h5 class="mb-1">{{ count }}</h5>
                                <small class="text-muted">{{ category|title|replace({'_': ' '}) }}</small>
                                <div class="mt-2">
                                    <a href="{{ path('admin_permission_by_category', {'category': category}) }}" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endif %}

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label for="search" class="form-label">Search</label>
                <input type="text" class="form-control" id="search" name="search" 
                       value="{{ filters.search ?? '' }}" placeholder="Search by name, label or description">
            </div>
            <div class="col-md-2">
                <label for="category" class="form-label">Category</label>
                <select class="form-select" id="category" name="category">
                    <option value="">All Categories</option>
                    {% for category in categories %}
                        <option value="{{ category }}" {{ filters.category == category ? 'selected' : '' }}>
                            {{ category|title|replace({'_': ' '}) }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label for="action" class="form-label">Action</label>
                <select class="form-select" id="action" name="action">
                    <option value="">All Actions</option>
                    {% for action in actions %}
                        <option value="{{ action }}" {{ filters.action == action ? 'selected' : '' }}>{{ action|title }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label for="resource" class="form-label">Resource</label>
                <select class="form-select" id="resource" name="resource">
                    <option value="">All Resources</option>
                    {% for resource in resources %}
                        <option value="{{ resource }}" {{ filters.resource == resource ? 'selected' : '' }}>{{ resource|title }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label for="active" class="form-label">Status</label>
                <select class="form-select" id="active" name="active">
                    <option value="">All Status</option>
                    <option value="1" {{ filters.active == true ? 'selected' : '' }}>Active</option>
                    <option value="0" {{ filters.active == false ? 'selected' : '' }}>Inactive</option>
                </select>
            </div>
            <div class="col-md-1">
                <label class="form-label">&nbsp;</label>
                <div class="d-flex gap-1">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search"></i>
                    </button>
                    <a href="{{ path('admin_permission_index') }}" class="btn btn-outline-secondary">
                        <i class="fas fa-times"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Permissions by Category View -->
{% if permissions_by_category|length > 0 %}
    <div class="accordion" id="permissionsAccordion">
        {% for category, categoryPermissions in permissions_by_category %}
            <div class="card mb-3">
                <div class="card-header" id="heading{{ loop.index }}">
                    <h2 class="mb-0">
                        <button class="btn btn-link btn-block text-left d-flex justify-content-between align-items-center" type="button" 
                                data-bs-toggle="collapse" data-bs-target="#collapse{{ loop.index }}" aria-expanded="true">
                            <span>
                                <i class="fas fa-folder-open me-2"></i>
                                {{ category|title|replace({'_': ' '}) }}
                                <span class="badge bg-primary ms-2">{{ categoryPermissions|length }}</span>
                            </span>
                            <i class="fas fa-chevron-down"></i>
                        </button>
                    </h2>
                </div>
                <div id="collapse{{ loop.index }}" class="collapse {{ loop.first ? 'show' : '' }}" data-bs-parent="#permissionsAccordion">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Permission</th>
                                        <th>Action</th>
                                        <th>Resource</th>
                                        <th>Roles</th>
                                        <th>Status</th>
                                        <th width="150">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                {% for permission in categoryPermissions %}
                                    <tr>
                                        <td>
                                            <div>
                                                <div class="fw-semibold">{{ permission.label }}</div>
                                                <small class="text-muted font-monospace">{{ permission.name }}</small>
                                                {% if permission.isSystem %}
                                                    <span class="badge bg-secondary ms-1">System</span>
                                                {% endif %}
                                            </div>
                                        </td>
                                        <td>
                                            {% if permission.action %}
                                                <span class="badge {{ permission.badgeClass }}">{{ permission.action|title }}</span>
                                            {% else %}
                                                <span class="text-muted">-</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if permission.resource %}
                                                <code>{{ permission.resource }}</code>
                                            {% else %}
                                                <span class="text-muted">-</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark">{{ permission.rolesCount }} roles</span>
                                        </td>
                                        <td>
                                            {% if permission.isActive %}
                                                <span class="badge bg-success">Active</span>
                                            {% else %}
                                                <span class="badge bg-danger">Inactive</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a href="{{ path('admin_permission_show', {'id': permission.id}) }}" class="btn btn-outline-info" title="View">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                {% if not permission.isSystem %}
                                                    <a href="{{ path('admin_permission_edit', {'id': permission.id}) }}" class="btn btn-outline-warning" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                {% endif %}
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" title="More actions">
                                                        <i class="fas fa-ellipsis-v"></i>
                                                    </button>
                                                    <ul class="dropdown-menu">
                                                        {% if not permission.isSystem %}
                                                            <li>
                                                                <form method="post" action="{{ path('admin_permission_toggle_status', {'id': permission.id}) }}" style="display: inline;">
                                                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_status' ~ permission.id) }}">
                                                                    <button type="submit" class="dropdown-item">
                                                                        <i class="fas fa-{{ permission.isActive ? 'ban' : 'check' }} me-2"></i>
                                                                        {{ permission.isActive ? 'Deactivate' : 'Activate' }}
                                                                    </button>
                                                                </form>
                                                            </li>
                                                            {% if permission.rolesCount == 0 %}
                                                                <li><hr class="dropdown-divider"></li>
                                                                <li>
                                                                    <form method="post" action="{{ path('admin_permission_delete', {'id': permission.id}) }}" 
                                                                          onsubmit="return confirm('Are you sure you want to delete this permission?');" style="display: inline;">
                                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ permission.id) }}">
                                                                        <button type="submit" class="dropdown-item text-danger">
                                                                            <i class="fas fa-trash me-2"></i> Delete
                                                                        </button>
                                                                    </form>
                                                                </li>
                                                            {% endif %}
                                                        {% endif %}
                                                    </ul>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% else %}
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="fas fa-key fa-3x text-muted mb-3"></i>
            <h5 class="text-muted">No permissions found</h5>
            <p class="text-muted">Start by creating your first permission.</p>
            <a href="{{ path('admin_permission_new') }}" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i> Create Permission
            </a>
        </div>
    </div>
{% endif %}

<!-- CRUD Generator Modal -->
<div class="modal fade" id="crudGeneratorModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Generate CRUD Permissions</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="{{ path('admin_permission_generate_crud') }}">
                <div class="modal-body">
                    <p>Generate Create, Read, Update, Delete permissions for a resource:</p>
                    <div class="mb-3">
                        <label for="resource" class="form-label">Resource Name</label>
                        <input type="text" class="form-control" id="resource" name="resource" placeholder="e.g., user, project, document" required>
                        <div class="form-text">Enter the resource name (singular, lowercase)</div>
                    </div>
                    <div class="mb-3">
                        <label for="category" class="form-label">Category</label>
                        <select class="form-select" id="category" name="category">
                            <option value="user_management">User Management</option>
                            <option value="content_management">Content Management</option>
                            <option value="system_administration">System Administration</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        This will create 4 permissions: create_[resource], read_[resource], update_[resource], delete_[resource]
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Generate Permissions</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}