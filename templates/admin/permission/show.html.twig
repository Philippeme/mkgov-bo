{% extends 'admin/base.html.twig' %}

{% block title %}{{ permission.name }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>{{ permission.name }}</h1>
    <div>
        <a href="{{ path('admin_permission_edit', {'id': permission.id}) }}" class="btn btn-warning">
            <i class="fas fa-edit"></i> Update
        </a>
        <a href="{{ path('admin_permission_index') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to the list
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Permissions information</h5>
                <table class="table">
                    <tbody>
                        <tr>
                            <th>ID</th>
                            <td>{{ permission.id }}</td>
                        </tr>
                        <tr>
                            <th>Description</th>
                            <td>{{ permission.description }}</td>
                        </tr>    
                        <tr>
                            <th>Ordre d'affichage</th>
                            <td>{{ permission.displayOrder }}</td>
                        </tr>
                        <tr>
                            <th>Créé le</th>
                            <td>{{ permission.createdAt ? permission.createdAt|date('d/m/Y H:i') : '' }}</td>
                        </tr>
                        <tr>
                            <th>Modifié le</th>
                            <td>{{ permission.updatedAt ? permission.updatedAt|date('d/m/Y H:i') : '' }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}