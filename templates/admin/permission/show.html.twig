{# templates/admin/permission/show.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block title %}{{ permission.label }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>
            <span class="badge {{ permission.badgeClass }} me-2">{{ permission.action|default('general')|title }}</span>
            {{ permission.label }}
            {% if permission.isSystem %}
                <span class="badge bg-secondary">System</span>
            {% endif %}
        </h1>
        <p class="text-muted mb-0">Permission details and role assignments</p>
    </div>
    <div class="d-flex gap-2">
        {% if not permission.isSystem %}
            <a href="{{ path('admin_permission_edit', {'id': permission.id}) }}" class="btn btn-warning">
                <i class="fas fa-edit me-1"></i> Edit Permission
            </a>
        {% endif %}
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="fas fa-cog me-1"></i> Actions
            </button>
            <ul class="dropdown-menu">
                {% if not permission.isSystem %}
                    <li>
                        <form method="post" action="{{ path('admin_permission_toggle_status', {'id': permission.id}) }}" style="display: inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle_status' ~ permission.id) }}">
                            <button type="submit" class="dropdown-item">
                                <i class="fas fa-{{ permission.isActive ? 'ban' : 'check' }} me-2"></i>
                                {{ permission.isActive ? 'Deactivate' : 'Activate' }} Permission
                            </button>
                        </form>
                    </li>
                    {% if permission.rolesCount == 0 %}
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form method="post" action="{{ path('admin_permission_delete', {'id': permission.id}) }}" 
                                  onsubmit="return confirm('Are you sure you want to delete this permission? This action cannot be undone.');" style="display: inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ permission.id) }}">
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="fas fa-trash me-2"></i> Delete Permission
                                </button>
                            </form>
                        </li>
                    {% endif %}
                {% endif %}
            </ul>
        </div>
        <a href="{{ path('admin_permission_index') }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to Permissions
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <!-- Permission Information -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-info-circle me-2"></i>Permission Information
                </h5>
            </div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tr>
                        <td class="text-muted" style="width: 40%;">Name:</td>
                        <td><code>{{ permission.name }}</code></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Label:</td>
                        <td><strong>{{ permission.label }}</strong></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Category:</td>
                        <td>
                            <a href="{{ path('admin_permission_by_category', {'category': permission.category}) }}" class="text-decoration-none">
                                {{ permission.category|title|replace({'_': ' '}) }}
                            </a>
                        </td>
                    </tr>
                    {% if permission.action %}
                        <tr>
                            <td class="text-muted">Action:</td>
                            <td><span class="badge {{ permission.badgeClass }}">{{ permission.action|title }}</span></td>
                        </tr>
                    {% endif %}
                    {% if permission.resource %}
                        <tr>
                            <td class="text-muted">Resource:</td>
                            <td><code>{{ permission.resource }}</code></td>
                        </tr>
                    {% endif %}
                    <tr>
                        <td class="text-muted">Status:</td>
                        <td>
                            {% if permission.isActive %}
                                <span class="badge bg-success">Active</span>
                            {% else %}
                                <span class="badge bg-danger">Inactive</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">Type:</td>
                        <td>
                            {% if permission.isSystem %}
                                <span class="badge bg-secondary">System Permission</span>
                            {% else %}
                                <span class="badge bg-primary">Custom Permission</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">Created:</td>
                        <td>{{ permission.createdAt|date('d/m/Y H:i') }}</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Last Updated:</td>
                        <td>{{ permission.updatedAt|date('d/m/Y H:i') }}</td>
                    </tr>
                </table>
                {% if permission.description %}
                    <hr>
                    <h6 class="text-muted">Description:</h6>
                    <p>{{ permission.description }}</p>
                {% endif %}
            </div>
        </div>

        <!-- Statistics -->
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-chart-bar me-2"></i>Statistics
                </h5>
            </div>
            <div class="card-body text-center">
                <h4 class="text-primary">{{ permission.rolesCount }}</h4>
                <small class="text-muted">Roles with this permission</small>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <!-- Roles with this permission -->
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-shield-alt me-2"></i>Roles with this Permission ({{ permission.rolesCount }})
                </h5>
            </div>
            <div class="card-body">
                {% if permission.roles|length > 0 %}
                    <div class="row">
                        {% for role in permission.roles %}
                            <div class="col-md-6 mb-3">
                                <div class="card border-start border-4 border-{{ role.badgeColor }}">
                                    <div class="card-body py-3">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h6 class="mb-1">{{ role.label }}</h6>
                                                <small class="text-muted font-monospace">{{ role.name }}</small>
                                                {% if role.description %}
                                                    <p class="mb-0 mt-1 small">{{ role.description }}</p>
                                                {% endif %}
                                                <div class="mt-2">
                                                    <span class="badge bg-light text-dark">{{ role.usersCount }} users</span>
                                                    {% if role.isSystem %}
                                                        <span class="badge bg-secondary">System</span>
                                                    {% endif %}
                                                    {% if not role.isActive %}
                                                        <span class="badge bg-danger">Inactive</span>
                                                    {% endif %}
                                                </div>
                                            </div>
                                            <div>
                                                <a href="{{ path('admin_role_show', {'id': role.id}) }}" class="btn btn-outline-primary btn-sm">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center py-4">
                        <i class="fas fa-shield-alt fa-3x text-muted mb-3"></i>
                        <h6 class="text-muted">No roles assigned</h6>
                        <p class="text-muted">This permission is not currently assigned to any roles.</p>
                        <a href="{{ path('admin_role_index') }}" class="btn btn-primary">
                            <i class="fas fa-plus me-1"></i> Assign to Roles
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}