{# templates/admin/permission/edit.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block title %}Edit Permission: {{ permission.label }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1><i class="fas fa-key me-2"></i>Edit Permission</h1>
        <p class="text-muted mb-0">Update permission information</p>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_permission_show', {'id': permission.id}) }}" class="btn btn-outline-info">
            <i class="fas fa-eye me-1"></i> View Permission
        </a>
        <a href="{{ path('admin_permission_index') }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to Permissions
        </a>
    </div>
</div>

{{ include('admin/permission/_form.html.twig') }}
{% endblock %}