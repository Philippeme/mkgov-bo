{% extends 'admin/base.html.twig' %}

{% block title %}Documents{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">
        <i class="bi-files me-2"></i>
        Documents Management
    </h1>
    <div class="btn-group">
        <a href="{{ path('admin_document_new') }}" class="btn btn-primary">
            <i class="bi-plus-circle me-2"></i>
            New Document
        </a>
        <div class="btn-group" role="group">
            <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                <i class="bi-download me-2"></i>
                Export
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="#" onclick="exportDocuments('active')">Active Documents</a></li>
                <li><a class="dropdown-item" href="#" onclick="exportDocuments('expiring')">Expiring Soon</a></li>
                <li><a class="dropdown-item" href="#" onclick="exportDocuments('all')">All Documents</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
{% if statistics is defined %}
<div class="row mb-4">
    <div class="col-md-2">
        <div class="card text-center bg-primary text-white">
            <div class="card-body">
                <h3 class="mb-1">{{ statistics.total }}</h3>
                <small>Total Documents</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center bg-warning text-white">
            <div class="card-body">
                <h3 class="mb-1">{{ statistics.input }}</h3>
                <small>Input Documents</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center bg-success text-white">
            <div class="card-body">
                <h3 class="mb-1">{{ statistics.output }}</h3>
                <small>Output Documents</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center bg-info text-white">
            <div class="card-body">
                <h3 class="mb-1">{{ statistics.with_request }}</h3>
                <small>With Request</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center bg-danger text-white">
            <div class="card-body">
                <h3 class="mb-1">{{ statistics.expiring_soon }}</h3>
                <small>Expiring Soon</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center bg-secondary text-white">
            <div class="card-body">
                <h3 class="mb-1">{{ documents|length }}</h3>
                <small>Filtered Results</small>
            </div>
        </div>
    </div>
</div>
{% endif %}

<!-- Enhanced Filters -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        <h6 class="card-title mb-0">
            <i class="bi-funnel me-2"></i>
            Search & Filter Documents
        </h6>
    </div>
    <div class="card-body">
        <form method="GET" class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-bold">Search</label>
                <input type="text" name="search" class="form-control" 
                       placeholder="Document name, request, or citizen..." 
                       value="{{ filters.search }}">
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Type</label>
                <select name="type" class="form-select">
                    <option value="">All Types</option>
                    <option value="input" {% if filters.type == 'input' %}selected{% endif %}>Input</option>
                    <option value="output" {% if filters.type == 'output' %}selected{% endif %}>Output</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Status</label>
                <select name="status" class="form-select">
                    <option value="">All Status</option>
                    <option value="draft" {% if filters.status == 'draft' %}selected{% endif %}>Draft</option>
                    <option value="pending" {% if filters.status == 'pending' %}selected{% endif %}>Pending</option>
                    <option value="approved" {% if filters.status == 'approved' %}selected{% endif %}>Approved</option>
                    <option value="active" {% if filters.status == 'active' %}selected{% endif %}>Active</option>
                    <option value="rejected" {% if filters.status == 'rejected' %}selected{% endif %}>Rejected</option>
                    <option value="expired" {% if filters.status == 'expired' %}selected{% endif %}>Expired</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Association</label>
                <select name="association" class="form-select">
                    <option value="">All</option>
                    <option value="with_request" {% if filters.association == 'with_request' %}selected{% endif %}>With Request</option>
                    <option value="procedure_only" {% if filters.association == 'procedure_only' %}selected{% endif %}>Procedure Only</option>
                    <option value="person_only" {% if filters.association == 'person_only' %}selected{% endif %}>Person Only</option>
                    <option value="orphan" {% if filters.association == 'orphan' %}selected{% endif %}>No Associations</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">&nbsp;</label>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi-search me-1"></i> Search
                    </button>
                    <a href="{{ path('admin_document_index') }}" class="btn btn-outline-secondary">
                        <i class="bi-arrow-clockwise"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

{% if documents|length > 0 %}
<div class="card shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">
            <i class="bi-list-ul me-2"></i>
            All Documents ({{ documents|length }})
        </h5>
        <div class="btn-group btn-group-sm">
            <button type="button" class="btn btn-outline-primary" onclick="selectAll()">Select All</button>
            <button type="button" class="btn btn-outline-danger" onclick="bulkAction('delete')" disabled id="bulkDeleteBtn">
                Delete Selected
            </button>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th width="3%">
                            <input type="checkbox" id="selectAllCheckbox" class="form-check-input">
                        </th>
                        <th width="5%">#</th>
                        <th width="8%">File</th>
                        <th width="18%">Name</th>
                        <th width="8%">Type</th>
                        <th width="15%">Associations</th>
                        <th width="10%">File Info</th>
                        <th width="8%">Status</th>
                        <th width="10%">Expiration</th>
                        <th width="6%">Required</th>
                        <th width="9%">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for document in documents %}
                    <tr>
                        <td>
                            <input type="checkbox" class="form-check-input document-checkbox" value="{{ document.id }}">
                        </td>
                        <td class="text-muted">#{{ document.id }}</td>
                        <td>
                            {% if document.filePath %}
                                {% if document.mimeType starts with 'image/' %}
                                    <i class="bi-image text-info" style="font-size: 1.5rem;"></i>
                                {% elseif document.mimeType == 'application/pdf' %}
                                    <i class="bi-file-pdf text-danger" style="font-size: 1.5rem;"></i>
                                {% elseif document.mimeType starts with 'application/vnd.openxmlformats' %}
                                    <i class="bi-file-word text-primary" style="font-size: 1.5rem;"></i>
                                {% else %}
                                    <i class="bi-file-earmark text-secondary" style="font-size: 1.5rem;"></i>
                                {% endif %}
                            {% else %}
                                <div class="bg-light d-flex align-items-center justify-content-center rounded"
                                     style="width: 40px; height: 40px;">
                                    <i class="bi-file text-muted"></i>
                                </div>
                            {% endif %}
                        </td>
                        <td>
                            <strong>{{ document.name }}</strong>
                            <div class="text-muted small">
                                Created: {{ document.createdAt|date('M d, Y') }}
                            </div>
                            {% if document.description %}
                                <div class="text-muted small">
                                    {{ document.description|slice(0, 40) }}{% if document.description|length > 40 %}...{% endif %}
                                </div>
                            {% endif %}
                        </td>
                        <td>
                            <span class="badge bg-{{ document.type == 'input' ? 'warning' : 'success' }}">
                                {{ document.type|upper }}
                            </span>
                        </td>
                        <td>
                            <!-- Priority: Request > Procedure > Person -->
                            {% if document.request %}
                                <div class="small mb-1">
                                    <i class="bi-journal-text text-primary me-1"></i>
                                    <a href="{{ path('admin_request_show', {'id': document.request.id}) }}" 
                                       class="text-decoration-none fw-bold">
                                        {{ document.request.reference }}
                                    </a>
                                    <small class="text-muted d-block">
                                        {{ document.request.status|title }} • {{ document.request.person.fullName }}
                                    </small>
                                </div>
                            {% endif %}
                            
                            {% if document.procedure %}
                                <div class="small mb-1">
                                    <i class="bi-gear text-secondary me-1"></i>
                                    <a href="{{ path('admin_procedure_show', {'id': document.procedure.id}) }}" 
                                       class="text-decoration-none">
                                        {{ document.procedure.pname|slice(0, 25) }}{% if document.procedure.pname|length > 25 %}...{% endif %}
                                    </a>
                                </div>
                            {% endif %}
                            
                            {% if document.person and not document.request %}
                                <div class="small">
                                    <i class="bi-person text-info me-1"></i>
                                    <a href="{{ path('admin_person_show', {'id': document.person.id}) }}" 
                                       class="text-decoration-none">
                                        {{ document.person.fullName }}
                                    </a>
                                </div>
                            {% endif %}
                            
                            {% if not document.request and not document.procedure and not document.person %}
                                <span class="text-muted small">
                                    <i class="bi-slash-circle me-1"></i>No associations
                                </span>
                            {% endif %}
                        </td>
                        <td>
                            {% if document.filePath %}
                                <div>
                                    {% if document.filePath ends with '-template.pdf' %}
                                        <span class="badge bg-primary">Template</span>
                                    {% else %}
                                        <span class="badge bg-info">Custom</span>
                                    {% endif %}
                                </div>
                                {% if document.fileSize %}
                                    <small class="text-muted">{{ document.fileSize }}</small>
                                {% endif %}
                            {% else %}
                                <span class="text-muted">No file</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-{{ document.statusBadgeClass }} dropdown-toggle" 
                                        type="button" data-bs-toggle="dropdown">
                                    {{ document.status|title }}
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item status-change" href="#" 
                                           data-document-id="{{ document.id }}" data-status="draft">Draft</a></li>
                                    <li><a class="dropdown-item status-change" href="#" 
                                           data-document-id="{{ document.id }}" data-status="pending">Pending</a></li>
                                    <li><a class="dropdown-item status-change" href="#" 
                                           data-document-id="{{ document.id }}" data-status="approved">Approved</a></li>
                                    <li><a class="dropdown-item status-change" href="#" 
                                           data-document-id="{{ document.id }}" data-status="active">Active</a></li>
                                    <li><a class="dropdown-item status-change" href="#" 
                                           data-document-id="{{ document.id }}" data-status="rejected">Rejected</a></li>
                                    <li><a class="dropdown-item status-change" href="#" 
                                           data-document-id="{{ document.id }}" data-status="expired">Expired</a></li>
                                </ul>
                            </div>
                        </td>
                        <td>
                            {% if document.expirationDate %}
                                <div class="small">
                                    {{ document.expirationDate|date('M d, Y') }}
                                </div>
                                {% if document.isExpired %}
                                    <span class="badge bg-danger">Expired</span>
                                {% else %}
                                    {% set daysLeft = date().diff(document.expirationDate).days %}
                                    {% if daysLeft <= 30 %}
                                        <span class="badge bg-warning">{{ daysLeft }} days</span>
                                    {% else %}
                                        <span class="badge bg-success">Valid</span>
                                    {% endif %}
                                {% endif %}
                            {% else %}
                                <span class="text-muted small">No expiry</span>
                            {% endif %}
                        </td>
                        <td class="text-center">
                            <span class="badge bg-{{ document.isRequired ? 'danger' : 'secondary' }}">
                                {{ document.isRequired ? 'Required' : 'Optional' }}
                            </span>
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm" role="group">
                                {% if document.filePath %}
                                <a href="{{ asset('uploads/documents/' ~ document.filePath) }}" 
                                   target="_blank"
                                   class="btn btn-outline-secondary" title="View File">
                                    <i class="bi-eye"></i>
                                </a>
                                {% endif %}
                                <a href="{{ path('admin_document_show', {'id': document.id}) }}" 
                                   class="btn btn-outline-info" title="View Details">
                                    <i class="bi-info-circle"></i>
                                </a>
                                <a href="{{ path('admin_document_edit', {'id': document.id}) }}" 
                                   class="btn btn-outline-warning" title="Edit">
                                    <i class="bi-pencil"></i>
                                </a>
                                <button type="button" 
                                        class="btn btn-outline-danger delete-btn" 
                                        data-document-id="{{ document.id }}"
                                        data-document-name="{{ document.name }}"
                                        title="Delete">
                                    <i class="bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% else %}
<div class="text-center py-5">
    <i class="bi-files text-muted" style="font-size: 4rem;"></i>
    <h3 class="text-muted mt-3">No documents found</h3>
    <p class="text-muted">
        {% if filters.search or filters.type or filters.status or filters.association %}
            Try adjusting your search criteria or filters
        {% else %}
            Start by creating your first document
        {% endif %}
    </p>
    <a href="{{ path('admin_document_new') }}" class="btn btn-primary">
        <i class="bi-plus-circle me-2"></i>
        Create First Document
    </a>
</div>
{% endif %}

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi-exclamation-triangle me-2"></i>
                    Confirm Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the document <strong id="documentName"></strong>?</p>
                <p class="text-muted small">This action will deactivate the document and cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" style="display: inline;">
                    <input type="hidden" name="_token" id="deleteToken">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi-trash me-1"></i>
                        Delete Document
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Status change functionality
    document.querySelectorAll('.status-change').forEach(function(link) {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            const documentId = this.dataset.documentId;
            const newStatus = this.dataset.status;
            
            fetch(`/admin/document/${documentId}/update-status`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: `status=${newStatus}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error updating status: ' + data.message);
                }
            })
            .catch(error => {
                alert('Error updating status');
            });
        });
    });

    // Delete modal functionality
    document.querySelectorAll('.delete-btn').forEach(function(button) {
        button.addEventListener('click', function() {
            const documentId = this.dataset.documentId;
            const documentName = this.dataset.documentName;
            
            document.getElementById('documentName').textContent = documentName;
            document.getElementById('deleteForm').action = `/admin/document/${documentId}/delete`;
            document.getElementById('deleteToken').value = '{{ csrf_token("delete") }}';
            
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        });
    });

    // Bulk selection functionality
    const selectAllCheckbox = document.getElementById('selectAllCheckbox');
    const documentCheckboxes = document.querySelectorAll('.document-checkbox');
    const bulkDeleteBtn = document.getElementById('bulkDeleteBtn');

    if (selectAllCheckbox) {
        selectAllCheckbox.addEventListener('change', function() {
            documentCheckboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
            updateBulkActionButtons();
        });
    }

    documentCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', updateBulkActionButtons);
    });

    function updateBulkActionButtons() {
        const checkedBoxes = document.querySelectorAll('.document-checkbox:checked');
        if (bulkDeleteBtn) {
            bulkDeleteBtn.disabled = checkedBoxes.length === 0;
        }
    }

    window.selectAll = function() {
        if (selectAllCheckbox) {
            selectAllCheckbox.checked = true;
            selectAllCheckbox.dispatchEvent(new Event('change'));
        }
    };

    window.bulkAction = function(action) {
        const checkedBoxes = document.querySelectorAll('.document-checkbox:checked');
        if (checkedBoxes.length === 0) {
            alert('Please select at least one document.');
            return;
        }
        
        if (action === 'delete') {
            if (confirm(`Are you sure you want to delete ${checkedBoxes.length} document(s)?`)) {
                // Implement bulk delete functionality
                console.log('Bulk delete', Array.from(checkedBoxes).map(cb => cb.value));
            }
        }
    };

    // Export functionality
    window.exportDocuments = function(type) {
        const params = new URLSearchParams(window.location.search);
        params.set('export', type);
        window.location.href = window.location.pathname + '?' + params.toString();
    };
});
</script>
{% endblock %}