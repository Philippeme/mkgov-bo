{% extends 'admin/base.html.twig' %}

{% block title %}Documents Management{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Documents Management</h1>
    <a href="{{ path('admin_document_new') }}" class="btn btn-primary">
        <i class="fas fa-plus"></i> New document
    </a>
</div>

<div class="card">
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Category</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for document in documents %}
                <tr>
                    <td>{{ document.id }}</td>
                    <td>
                        {% if document.pdf %}
                            <a href="{{ asset('uploads/pdf_uploads/' ~ document.pdf) }}" target="_blank">Show the PDF</a>
                        {% else %}
                            <span class="text-muted">No PDF file</span>
                        {% endif %}
                    </td>
                    <td>{{ document.dname }}</td>
                    <td>{{ document.description }}</td>
                    <td>{{ document.category }}</td>
                    <td>
                        <a href="{{ path('admin_document_show', {'id': document.id}) }}" class="btn btn-sm btn-info">
                            <i class="fas fa-eye"></i>
                        </a>
                        <a href="{{ path('admin_document_edit', {'id': document.id}) }}" class="btn btn-sm btn-warning">
                            <i class="fas fa-edit"></i>
                        </a>
                        <form method="post" action="{{ path('admin_document_delete', {'id': document.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette procedure ?');" style="display: inline-block;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ document.id) }}">
                            <button class="btn btn-sm btn-danger">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8" class="text-center">No document found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}