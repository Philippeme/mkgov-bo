{# document/edit.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block title %}Edit Document{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">
        <i class="bi-pencil me-2"></i>
        Edit Document: {{ document.name }}
    </h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="{{ path('admin_document_index') }}">Documents</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin_document_show', {'id': document.id}) }}">{{ document.name }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit</li>
        </ol>
    </nav>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-warning text-dark">
        <h5 class="card-title mb-0">
            <i class="bi-file-earmark me-2"></i>
            Update Document Information
        </h5>
    </div>
    <div class="card-body">
        {{ include('admin/document/_form.html.twig', {'button_label': 'Update Document'}) }}
    </div>
</div>
{% endblock %}