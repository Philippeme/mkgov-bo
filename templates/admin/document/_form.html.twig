{{ form_start(form, {'attr': {'id': 'documentForm', 'enctype': 'multipart/form-data'}}) }}
<div class="row">
    <div class="col-md-8">
        <!-- Basic Information -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h6 class="card-title mb-0">
                    <i class="bi-file-earmark me-2"></i>
                    Basic Information
                </h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    {{ form_row(form.name, {
                        'label_attr': {'class': 'form-label fw-bold'},
                        'attr': {'class': 'form-control'}
                    }) }}
                </div>
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_row(form.type, {
                                'label_attr': {'class': 'form-label fw-bold'},
                                'attr': {'class': 'form-select'}
                            }) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_row(form.status, {
                                'label_attr': {'class': 'form-label fw-bold'},
                                'attr': {'class': 'form-select'}
                            }) }}
                        </div>
                    </div>
                </div>
                
                <div class="mb-3">
                    {{ form_row(form.description, {
                        'label_attr': {'class': 'form-label fw-bold'},
                        'attr': {'class': 'form-control', 'rows': 4}
                    }) }}
                </div>
            </div>
        </div>

        <!-- Associations -->
        <div class="card mb-4">
            <div class="card-header bg-info text-white">
                <h6 class="card-title mb-0">
                    <i class="bi-link me-2"></i>
                    Associations
                </h6>
            </div>
            <div class="card-body">
                <!-- Request Association (Priority 1) -->
                <div class="alert alert-info border-0 mb-3">
                    <div class="d-flex align-items-center">
                        <i class="bi-info-circle me-2"></i>
                        <small>
                            <strong>Association Priority:</strong> Request → Procedure → Person. 
                            Selecting a request will automatically populate related fields.
                        </small>
                    </div>
                </div>

                <div class="mb-3">
                    {{ form_row(form.request, {
                        'label_attr': {'class': 'form-label fw-bold'},
                        'attr': {'class': 'form-select request-select'}
                    }) }}
                    <div class="form-text">
                        <small class="text-muted">
                            <i class="bi-info-circle me-1"></i>
                            Primary association. When selected, related procedure and person are inherited.
                        </small>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_row(form.procedure, {
                                'label_attr': {'class': 'form-label fw-bold'},
                                'attr': {'class': 'form-select procedure-field'}
                            }) }}
                            <div class="form-text">
                                <small class="text-muted">
                                    <i class="bi-gear me-1"></i>
                                    Secondary association (automatically filled when request is selected)
                                </small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_row(form.person, {
                                'label_attr': {'class': 'form-label fw-bold'},
                                'attr': {'class': 'form-select person-select person-field'}
                            }) }}
                            <div class="form-text">
                                <small class="text-muted">
                                    <i class="bi-person me-1"></i>
                                    Tertiary association (automatically filled when request is selected)
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_row(form.expirationDate, {
                                'label_attr': {'class': 'form-label fw-bold'},
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_row(form.displayOrder, {
                                'label_attr': {'class': 'form-label fw-bold'},
                                'attr': {'class': 'form-control'}
                            }) }}
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                {{ form_widget(form.isRequired, {'attr': {'class': 'form-check-input'}}) }}
                                {{ form_label(form.isRequired, 'Required Document', {'label_attr': {'class': 'form-check-label fw-bold'}}) }}
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                {{ form_widget(form.isActive, {'attr': {'class': 'form-check-input'}}) }}
                                {{ form_label(form.isActive, 'Active Status', {'label_attr': {'class': 'form-check-label fw-bold'}}) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <!-- Association Context Info -->
        <div class="card mb-4 bg-light">
            <div class="card-header">
                <h6 class="card-title mb-0">
                    <i class="bi bi-puzzle me-2"></i>
                    Association Context
                </h6>
            </div>
            <div class="card-body" id="associationContext">
                {% if document.request %}
                    <div class="context-item request-context">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi-journal-text text-primary me-2"></i>
                            <strong>Request</strong>
                        </div>
                        <div class="ps-4">
                            <div class="fw-bold text-primary">{{ document.request.reference }}</div>
                            <small class="text-muted">Status: {{ document.request.status|title }}</small>
                        </div>
                    </div>
                {% endif %}
                
                {% if document.procedure %}
                    <div class="context-item procedure-context {% if document.request %}mt-3{% endif %}">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi-gear text-secondary me-2"></i>
                            <strong>Procedure</strong>
                        </div>
                        <div class="ps-4">
                            <div class="fw-bold">{{ document.procedure.pname }}</div>
                            {% if document.procedure.family %}
                                <small class="text-muted">Family: {{ document.procedure.family.fname }}</small>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
                
                {% if document.person %}
                    <div class="context-item person-context {% if document.procedure or document.request %}mt-3{% endif %}">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi-person text-info me-2"></i>
                            <strong>Citizen</strong>
                        </div>
                        <div class="ps-4">
                            <div class="fw-bold">{{ document.person.fullName }}</div>
                            <small class="text-muted">ID: {{ document.person.nationalId }}</small>
                        </div>
                    </div>
                {% endif %}
                
                {% if not document.request and not document.procedure and not document.person %}
                    <div class="text-center text-muted">
                        <i class="bi-slash-circle" style="font-size: 2rem;"></i>
                        <p class="mt-2 mb-0">No associations</p>
                        <small>Select a request, procedure, or citizen to establish context</small>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Document File Section -->
        <div class="card bg-light">
            <div class="card-header">
                <h6 class="card-title mb-0">
                    <i class="bi-file-earmark me-2"></i>
                    Document File
                </h6>
            </div>
            <div class="card-body">
                <div class="mb-3 text-center">
                    <div id="documentPreview" class="border rounded p-3" style="min-height: 120px;">
                        {% if document.filePath %}
                            <div class="text-success">
                                {% if document.mimeType starts with 'image/' %}
                                    <img src="{{ asset('uploads/documents/' ~ document.filePath) }}" 
                                         alt="{{ document.name }}" 
                                         class="img-fluid rounded"
                                         style="max-height: 100px;">
                                {% else %}
                                    {% if document.mimeType == 'application/pdf' %}
                                        <i class="bi-file-pdf text-danger" style="font-size: 3rem;"></i>
                                    {% elseif document.mimeType starts with 'application/vnd.openxmlformats' %}
                                        <i class="bi-file-word text-primary" style="font-size: 3rem;"></i>
                                    {% else %}
                                        <i class="bi-file-earmark text-info" style="font-size: 3rem;"></i>
                                    {% endif %}
                                {% endif %}
                                <p class="mt-2 mb-0">
                                    <a href="{{ asset('uploads/documents/' ~ document.filePath) }}" 
                                       target="_blank" 
                                       class="text-decoration-none">
                                        View Current File
                                    </a>
                                </p>
                                {% if document.fileSize %}
                                    <small class="text-muted">{{ document.fileSize }}</small>
                                {% endif %}
                            </div>
                        {% else %}
                            <div class="text-muted">
                                <i class="bi-file-earmark" style="font-size: 3rem;"></i>
                                <p class="mt-2 mb-0">No file uploaded</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
                
                <div class="mb-3">
                    {{ form_row(form.documentTemplates, {
                        'label_attr': {'class': 'form-label fw-bold'},
                        'attr': {'class': 'form-select', 'onchange': 'updateDocumentPreview(this.value, this.options[this.selectedIndex].text)'}
                    }) }}
                </div>
                
                <div class="mb-3">
                    {{ form_row(form.documentFile, {
                        'label_attr': {'class': 'form-label fw-bold'},
                        'attr': {'class': 'form-control', 'onchange': 'previewDocument(this)'}
                    }) }}
                </div>

                <!-- Remove Document Option -->
                <div class="mb-3">
                    <div class="form-check">
                        {{ form_widget(form.removeDocument, {'attr': {'class': 'form-check-input'}}) }}
                        {{ form_label(form.removeDocument, 'Remove current document', {'label_attr': {'class': 'form-check-label text-danger'}}) }}
                    </div>
                </div>
                
                <div class="form-text">
                    <small>
                        <i class="bi-info-circle me-1"></i>
                        Choose template or upload custom. Max: 10MB
                    </small>
                </div>
            </div>
        </div>

        <!-- Document Status Information -->
        <div class="card mt-3">
            <div class="card-header">
                <h6 class="card-title mb-0">
                    <i class="bi-info-circle me-2"></i>
                    Status Information
                </h6>
            </div>
            <div class="card-body">
                <div class="mb-2">
                    <label class="small fw-bold text-muted">Current Status:</label>
                    <div>
                        <span class="badge bg-{{ document.statusBadgeClass }}">
                            {{ document.status ? document.status|title : 'Draft' }}
                        </span>
                    </div>
                </div>
                
                {% if document.expirationDate %}
                <div class="mb-2">
                    <label class="small fw-bold text-muted">Expiration:</label>
                    <div class="small">
                        {{ document.expirationDate|date('F d, Y') }}
                        {% if document.isExpired %}
                            <span class="badge bg-danger">Expired</span>
                        {% else %}
                            <span class="text-success">Valid</span>
                        {% endif %}
                    </div>
                </div>
                {% endif %}

                {% if document.request %}
                <div class="mb-2">
                    <label class="small fw-bold text-muted">Request:</label>
                    <div class="small">
                        <a href="{{ path('admin_request_show', {'id': document.request.id}) }}" class="text-decoration-none">
                            {{ document.request.reference }}
                        </a>
                    </div>
                </div>
                {% endif %}

                {% if document.procedure %}
                <div class="mb-2">
                    <label class="small fw-bold text-muted">Procedure:</label>
                    <div class="small">
                        <a href="{{ path('admin_procedure_show', {'id': document.procedure.id}) }}" class="text-decoration-none">
                            {{ document.procedure.pname }}
                        </a>
                    </div>
                </div>
                {% endif %}

                {% if document.person %}
                <div class="mb-2">
                    <label class="small fw-bold text-muted">Citizen:</label>
                    <div class="small">
                        <a href="{{ path('admin_person_show', {'id': document.person.id}) }}" class="text-decoration-none">
                            {{ document.person.fullName }}
                        </a>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <button type="submit" class="btn btn-primary">
        <i class="bi-check-circle me-2"></i>
        {{ button_label|default('Save Document') }}
    </button>
    <a href="{{ path('admin_document_index') }}" class="btn btn-secondary">
        <i class="bi-arrow-left me-2"></i>
        Cancel
    </a>
    {% if document.request %}
        <a href="{{ path('admin_request_show', {'id': document.request.id}) }}" class="btn btn-info">
            <i class="bi-journal-text me-2"></i>
            Back to Request
        </a>
    {% endif %}
</div>

{{ form_end(form) }}

<script>
function updateDocumentPreview(templateValue, templateLabel) {
    if (templateValue) {
        const preview = document.getElementById('documentPreview');
        preview.innerHTML = `
            <div class="text-info">
                <i class="bi-file-pdf" style="font-size: 3rem;"></i>
                <p class="mt-2 mb-0">Template: ${templateLabel}</p>
                <small class="text-muted">Will be generated automatically</small>
            </div>
        `;
        // Clear custom file input and remove checkbox
        document.querySelector('input[name="document[documentFile]"]').value = '';
        const removeCheckbox = document.querySelector('input[name="document[removeDocument]"]');
        if (removeCheckbox) removeCheckbox.checked = false;
    }
}

function previewDocument(input) {
    const preview = document.getElementById('documentPreview');
    
    if (input.files && input.files[0]) {
        const file = input.files[0];
        const fileName = file.name;
        const fileSize = (file.size / 1024 / 1024).toFixed(2);
        const fileType = file.type;
        
        if (fileType.startsWith('image/')) {
            const reader = new FileReader();
            reader.onload = function(e) {
                preview.innerHTML = `
                    <img src="${e.target.result}" 
                         class="img-fluid rounded" 
                         style="max-height: 100px;"
                         alt="Document preview">
                    <p class="mt-2 mb-0">${fileName}</p>
                    <small class="text-muted">${fileSize} MB</small>
                `;
            };
            reader.readAsDataURL(file);
        } else {
            let icon = 'bi-file-earmark';
            if (fileType === 'application/pdf') {
                icon = 'bi-file-pdf text-danger';
            } else if (fileType.includes('word') || fileType.includes('document')) {
                icon = 'bi-file-word text-primary';
            } else if (fileType.includes('excel') || fileType.includes('sheet')) {
                icon = 'bi-file-excel text-success';
            }
            
            preview.innerHTML = `
                <div class="text-info">
                    <i class="${icon}" style="font-size: 3rem;"></i>
                    <p class="mt-2 mb-0">${fileName}</p>
                    <small class="text-muted">${fileSize} MB</small>
                </div>
            `;
        }
        
        // Clear template selection and remove checkbox
        document.querySelector('select[name="document[documentTemplates]"]').value = '';
        const removeCheckbox = document.querySelector('input[name="document[removeDocument]"]');
        if (removeCheckbox) removeCheckbox.checked = false;
    }
}

// Function to update request-related fields
function updateRequestRelatedFields(requestId) {
    if (requestId) {
        fetch(`/admin/request/${requestId}/info`)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Update procedure field
                    const procedureField = document.querySelector('select[name="document[procedure]"]');
                    if (procedureField && data.procedure_id) {
                        procedureField.value = data.procedure_id;
                        procedureField.disabled = true;
                    }
                    
                    // Update person field
                    const personField = document.querySelector('select[name="document[person]"]');
                    if (personField && data.person_id) {
                        personField.value = data.person_id;
                        personField.disabled = true;
                    }
                    
                    // Update context display
                    updateAssociationContext(data);
                }
            })
            .catch(error => {
                console.error('Error fetching request info:', error);
            });
    } else {
        // Re-enable fields when no request is selected
        const procedureField = document.querySelector('select[name="document[procedure]"]');
        const personField = document.querySelector('select[name="document[person]"]');
        
        if (procedureField) {
            procedureField.disabled = false;
            procedureField.value = '';
        }
        
        if (personField) {
            personField.disabled = false;
            personField.value = '';
        }
    }
}

function updateAssociationContext(data) {
    const contextDiv = document.getElementById('associationContext');
    let html = '';
    
    if (data.request_reference) {
        html += `
            <div class="context-item request-context">
                <div class="d-flex align-items-center mb-2">
                    <i class="bi-journal-text text-primary me-2"></i>
                    <strong>Request</strong>
                </div>
                <div class="ps-4">
                    <div class="fw-bold text-primary">${data.request_reference}</div>
                    <small class="text-muted">Status: ${data.request_status}</small>
                </div>
            </div>
        `;
    }
    
    if (data.procedure_name) {
        html += `
            <div class="context-item procedure-context ${data.request_reference ? 'mt-3' : ''}">
                <div class="d-flex align-items-center mb-2">
                    <i class="bi-gear text-secondary me-2"></i>
                    <strong>Procedure</strong>
                </div>
                <div class="ps-4">
                    <div class="fw-bold">${data.procedure_name}</div>
                    ${data.family_name ? `<small class="text-muted">Family: ${data.family_name}</small>` : ''}
                </div>
            </div>
        `;
    }
    
    if (data.person_name) {
        html += `
            <div class="context-item person-context ${(data.procedure_name || data.request_reference) ? 'mt-3' : ''}">
                <div class="d-flex align-items-center mb-2">
                    <i class="bi-person text-info me-2"></i>
                    <strong>Citizen</strong>
                </div>
                <div class="ps-4">
                    <div class="fw-bold">${data.person_name}</div>
                    <small class="text-muted">ID: ${data.person_national_id}</small>
                </div>
            </div>
        `;
    }
    
    if (!html) {
        html = `
            <div class="text-center text-muted">
                <i class="bi-slash-circle" style="font-size: 2rem;"></i>
                <p class="mt-2 mb-0">No associations</p>
                <small>Select a request, procedure, or citizen to establish context</small>
            </div>
        `;
    }
    
    contextDiv.innerHTML = html;
}

// Enhanced person search functionality
document.addEventListener('DOMContentLoaded', function() {
    const personSelect = document.querySelector('.person-select');
    if (personSelect) {
        // Add search functionality for person selection
        personSelect.addEventListener('focus', function() {
            this.setAttribute('data-live-search', 'true');
        });
    }

    // Auto-update expiration warning
    const expirationInput = document.querySelector('input[name="document[expirationDate]"]');
    if (expirationInput) {
        expirationInput.addEventListener('change', function() {
            const selectedDate = new Date(this.value);
            const today = new Date();
            const warningThreshold = new Date();
            warningThreshold.setDate(today.getDate() + 30); // 30 days warning

            // Remove existing warnings
            const existingWarning = this.parentElement.querySelector('.expiration-warning');
            if (existingWarning) {
                existingWarning.remove();
            }

            if (selectedDate <= today) {
                const warning = document.createElement('div');
                warning.className = 'small text-danger mt-1 expiration-warning';
                warning.innerHTML = '<i class="bi-exclamation-triangle me-1"></i>This date has already passed';
                this.parentElement.appendChild(warning);
            } else if (selectedDate <= warningThreshold) {
                const warning = document.createElement('div');
                warning.className = 'small text-warning mt-1 expiration-warning';
                warning.innerHTML = '<i class="bi-clock me-1"></i>Expires within 30 days';
                this.parentElement.appendChild(warning);
            }
        });
    }

    // Request selection handler
    const requestSelect = document.querySelector('select[name="document[request]"]');
    if (requestSelect) {
        requestSelect.addEventListener('change', function() {
            updateRequestRelatedFields(this.value);
        });
    }
});

// Form validation
document.getElementById('documentForm').addEventListener('submit', function(e) {
    const name = document.querySelector('input[name="document[name]"]').value.trim();
    const type = document.querySelector('select[name="document[type]"]').value;
    
    if (!name || !type) {
        e.preventDefault();
        alert('Please fill in all required fields.');
        return false;
    }

    // Validate expiration date if provided
    const expirationDate = document.querySelector('input[name="document[expirationDate]"]').value;
    if (expirationDate) {
        const selectedDate = new Date(expirationDate);
        const today = new Date();
        
        if (selectedDate <= today) {
            e.preventDefault();
            alert('Expiration date cannot be in the past.');
            return false;
        }
    }
});
</script>