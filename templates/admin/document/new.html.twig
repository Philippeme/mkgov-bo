                <div id="linksCollection">
                    <div class="collection-item">
                        <button type="button" class="btn btn-remove-item" onclick="removeLink(this)">
                            <i class="bi-trash"></i>
                        </button>
                        <div class="row">
                            <div class="col-md-6">
                                <label class="form-label">Titre du lien</label>
                                <input type="text" class="form-control" name="liens[0][titre]" placeholder="Titre du lien">
                            </div>
                            <div class="col-md-6">
