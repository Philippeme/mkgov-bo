{# document/show.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block title %}{{ document.name }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">
        <i class="bi-eye me-2"></i>
        {{ document.name }}
    </h1>
    <div class="btn-group">
        <a href="{{ path('admin_document_edit', {'id': document.id}) }}" class="btn btn-warning">
            <i class="bi-pencil me-2"></i>
            Edit
        </a>
        <button type="button" 
                class="btn btn-danger delete-btn" 
                data-document-id="{{ document.id }}"
                data-document-name="{{ document.name }}">
            <i class="bi-trash me-2"></i>
            Delete
        </button>
    </div>
</div>

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('admin_document_index') }}">Documents</a></li>
        <li class="breadcrumb-item active" aria-current="page">{{ document.name }}</li>
    </ol>
</nav>

<div class="row">
    <div class="col-md-8">
        <!-- Basic Information -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0">
                    <i class="bi-info-circle me-2"></i>
                    Document Details
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">Document Name:</label>
                            <p class="fs-5">{{ document.name }}</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">Type:</label>
                            <p>
                                <span class="badge bg-{{ document.type == 'input' ? 'warning' : 'success' }} fs-6">
                                    {{ document.type|upper }}
                                </span>
                            </p>
                        </div>
                    </div>
                </div>
                
                {% if document.description %}
                <div class="mb-3">
                    <label class="form-label fw-bold text-muted">Description:</label>
                    <div class="border rounded p-3 bg-light">
                        {{ document.description|nl2br }}
                    </div>
                </div>
                {% endif %}
                
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">Required:</label>
                            <p>
                                <span class="badge bg-{{ document.isRequired ? 'danger' : 'secondary' }} fs-6">
                                    {{ document.isRequired ? 'Required' : 'Optional' }}
                                </span>
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">Display Order:</label>
                            <p><span class="badge bg-secondary fs-6">{{ document.displayOrder }}</span></p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">Status:</label>
                            <p>
                                <span class="badge bg-{{ document.isActive ? 'success' : 'danger' }} fs-6">
                                    {{ document.isActive ? 'Active' : 'Inactive' }}
                                </span>
                            </p>
                        </div>
                    </div>
                </div>

                {% if document.procedure %}
                <div class="mb-3">
                    <label class="form-label fw-bold text-muted">Related Procedure:</label>
                    <div class="border rounded p-3 bg-light">
                        <a href="{{ path('admin_procedure_show', {'id': document.procedure.id}) }}" class="text-decoration-none">
                            <strong>{{ document.procedure.pname }}</strong>
                        </a>
                        <div class="text-muted small mt-1">
                            {{ document.procedure.shortdesc|slice(0, 100) }}{% if document.procedure.shortdesc|length > 100 %}...{% endif %}
                        </div>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <!-- File Information -->
        {% if document.filePath %}
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="bi-file-earmark me-2"></i>
                    Document File
                </h6>
            </div>
            <div class="card-body text-center">
                {% if document.mimeType starts with 'image/' %}
                    <img src="{{ asset('uploads/documents/' ~ document.filePath) }}" 
                         alt="{{ document.name }}" 
                         class="img-fluid rounded border"
                         style="max-width: 100%; max-height: 200px;">
                {% else %}
                    {% if document.mimeType == 'application/pdf' %}
                        <i class="bi-file-pdf text-danger" style="font-size: 4rem;"></i>
                    {% elseif document.mimeType starts with 'application/vnd.openxmlformats' %}
                        <i class="bi-file-word text-primary" style="font-size: 4rem;"></i>
                    {% else %}
                        <i class="bi-file-earmark text-info" style="font-size: 4rem;"></i>
                    {% endif %}
                {% endif %}
                
                <div class="mt-3">
                    <a href="{{ asset('uploads/documents/' ~ document.filePath) }}" 
                       target="_blank" 
                       class="btn btn-outline-primary btn-sm">
                        <i class="bi-download me-1"></i>
                        View/Download File
                    </a>
                </div>
                
                {% if document.fileSize %}
                <p class="mt-2 mb-0"><small class="text-muted">Size: {{ document.fileSize }}</small></p>
                {% endif %}
                
                {% if document.filePath ends with '-template.pdf' %}
                    <p class="mt-1 mb-0"><span class="badge bg-primary">Template File</span></p>
                {% endif %}
            </div>
        </div>
        {% endif %}

        <!-- Metadata -->
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="bi-clock me-2"></i>
                    Metadata
                </h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-bold text-muted small">ID:</label>
                    <p class="mb-0">#{{ document.id }}</p>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold text-muted small">Created:</label>
                    <p class="mb-0">{{ document.createdAt|date('F d, Y \\a\\t H:i') }}</p>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold text-muted small">Last Updated:</label>
                    <p class="mb-0">{{ document.updatedAt|date('F d, Y \\a\\t H:i') }}</p>
                </div>
                {% if document.mimeType %}
                <div class="mb-3">
                    <label class="form-label fw-bold text-muted small">File Type:</label>
                    <p class="mb-0"><code>{{ document.mimeType }}</code></p>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi-exclamation-triangle me-2"></i>
                    Confirm Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the document <strong>{{ document.name }}</strong>?</p>
                <p class="text-muted small">This action will deactivate the document and cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" action="{{ path('admin_document_delete', {'id': document.id}) }}" style="display: inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ document.id) }}">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi-trash me-1"></i>
                        Delete Document
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.delete-btn').forEach(function(button) {
        button.addEventListener('click', function() {
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        });
    });
});
</script>
{% endblock %}