<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MK Gov Dashboard Report - {{ "now"|date("Y-m-d H:i:s") }}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            line-height: 1.6;
            color: #333;
        }
        
        .header {
            text-align: center;
            border-bottom: 2px solid #1a4b8f;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }
        
        .header h1 {
            color: #1a4b8f;
            margin: 0;
            font-size: 2.5em;
        }
        
        .header .subtitle {
            color: #666;
            margin: 10px 0;
            font-size: 1.2em;
        }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 40px;
        }
        
        .stat-card {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 20px;
            text-align: center;
            background: #f9f9f9;
        }
        
        .stat-value {
            font-size: 2.5em;
            font-weight: bold;
            color: #1a4b8f;
            margin: 0;
        }
        
        .stat-label {
            color: #666;
            font-size: 0.9em;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-top: 10px;
        }
        
        .section {
            margin-bottom: 40px;
            page-break-inside: avoid;
        }
        
        .section-title {
            color: #1a4b8f;
            font-size: 1.5em;
            border-bottom: 1px solid #ddd;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        
        .data-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        
        .data-table th,
        .data-table td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: left;
        }
        
        .data-table th {
            background-color: #1a4b8f;
            color: white;
            font-weight: bold;
        }
        
        .data-table tr:nth-child(even) {
            background-color: #f9f9f9;
        }
        
        .chart-placeholder {
            border: 2px dashed #ccc;
            padding: 40px;
            text-align: center;
            color: #666;
            background: #f5f5f5;
            border-radius: 8px;
            margin: 20px 0;
        }
        
        .footer {
            margin-top: 50px;
            padding-top: 20px;
            border-top: 1px solid #ddd;
            text-align: center;
            color: #666;
            font-size: 0.9em;
        }
        
        .two-column {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 30px;
        }
        
        .highlight {
            background-color: #fff3cd;
            border: 1px solid #ffeaa7;
            border-radius: 4px;
            padding: 15px;
            margin: 15px 0;
        }
        
        .highlight strong {
            color: #856404;
        }
        
        @media print {
            body {
                margin: 0;
            }
            
            .section {
                page-break-inside: avoid;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <div class="header">
        <h1>MK Gov Dashboard Report</h1>
        <div class="subtitle">Government E-Services Portal Analytics</div>
        <div class="subtitle">Generated on {{ "now"|date("F d, Y at H:i:s") }}</div>
    </div>

    <!-- Main Statistics -->
    <div class="section">
        <h2 class="section-title">📊 Key Performance Indicators</h2>
        
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-value">{{ data.stats.institutions ?? 0 }}</div>
                <div class="stat-label">Public Institutions</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">{{ data.stats.procedures ?? 0 }}</div>
                <div class="stat-label">Active Procedures</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">{{ data.stats.families ?? 0 }}</div>
                <div class="stat-label">Service Families</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">{{ data.stats.requests ?? 0 }}</div>
                <div class="stat-label">Total Requests</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">{{ data.stats.pending_admin ?? 0 }}</div>
                <div class="stat-label">Pending (Admin)</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">{{ data.stats.pending_requestor ?? 0 }}</div>
                <div class="stat-label">Pending (Requestor)</div>
            </div>
        </div>
        
        {% if data.performanceMetrics is defined %}
        <div class="highlight">
            <strong>Performance Summary:</strong> 
            Completion Rate: {{ data.performanceMetrics.completion_rate }}% | 
            Average Processing Time: {{ data.performanceMetrics.avg_processing_time }} days
        </div>
        {% endif %}
    </div>

    <!-- Requests by Family -->
    <div class="section">
        <h2 class="section-title">📈 Requests by Service Family</h2>
        
        <table class="data-table">
            <thead>
                <tr>
                    <th>Service Family</th>
                    <th>Number of Requests</th>
                    <th>Percentage</th>
                </tr>
            </thead>
            <tbody>
                {% for family in data.requestsByFamily %}
                <tr>
                    <td>{{ family.family_name ?? 'Unassigned' }}</td>
                    <td>{{ family.count }}</td>
                    <td>{{ family.percentage ?? 0 }}%</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        
        <div class="chart-placeholder">
            📊 Donut Chart: Requests Distribution by Family<br>
            <small>(Chart visualization available in web dashboard)</small>
        </div>
    </div>

    <!-- Monthly Trends -->
    <div class="section">
        <h2 class="section-title">📅 Monthly Request Trends (Last 12 Months)</h2>
        
        <table class="data-table">
            <thead>
                <tr>
                    <th>Month</th>
                    <th>Number of Requests</th>
                </tr>
            </thead>
            <tbody>
                {% for key, month in data.monthlyRequests.labels %}
                <tr>
                    <td>{{ month }}</td>
                    <td>{{ data.monthlyRequests.data[key] ?? 0 }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        
        <div class="chart-placeholder">
            📈 Line Chart: Request Volume Over Time<br>
            <small>(Interactive chart available in web dashboard)</small>
        </div>
    </div>

    <!-- Gender and Location Analysis -->
    <div class="two-column">
        <div class="section">
            <h2 class="section-title">👥 Requests by Gender</h2>
            
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Gender</th>
                        <th>Count</th>
                        <th>Percentage</th>
                    </tr>
                </thead>
                <tbody>
                    {% for key, label in data.requestsByGender.labels %}
                    <tr>
                        <td>{{ label }}</td>
                        <td>{{ data.requestsByGender.data[key] ?? 0 }}</td>
                        <td>
                            {% if label == 'Male' %}
                                {{ data.requestsByGender.percentages.male ?? 0 }}%
                            {% else %}
                                {{ data.requestsByGender.percentages.female ?? 0 }}%
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="section">
            <h2 class="section-title">🗺️ Requests by Region</h2>
            
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Region</th>
                        <th>Count</th>
                    </tr>
                </thead>
                <tbody>
                    {% for location in data.requestsByLocation %}
                    <tr>
                        <td>{{ location.region }}</td>
                        <td>{{ location.count }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Top Procedures -->
    {% if data.topProcedures is defined %}
    <div class="section">
        <h2 class="section-title">🏆 Top Procedures by Request Volume</h2>
        
        <table class="data-table">
            <thead>
                <tr>
                    <th>Rank</th>
                    <th>Procedure Name</th>
                    <th>Number of Requests</th>
                </tr>
            </thead>
            <tbody>
                {% for procedure in data.topProcedures %}
                <tr>
                    <td>{{ loop.index }}</td>
                    <td>{{ procedure.procedure_name }}</td>
                    <td>{{ procedure.count }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}

    <!-- Recent Activity Summary -->
    {% if data.recentActivity is defined %}
    <div class="section">
        <h2 class="section-title">🕒 Recent Activity Summary</h2>
        
        <div class="two-column">
            <div>
                <h3>Recent Requests (Last 7 days)</h3>
                <ul>
                    {% for request in data.recentActivity.recent_requests|slice(0, 5) %}
                    <li>
                        <strong>{{ request.procedure.pname }}</strong><br>
                        Submitted by: {{ request.person.firstName }} {{ request.person.lastName }}<br>
                        Date: {{ request.submittedAt|date('M d, Y H:i') }}<br>
                        Status: {{ request.status|title }}
                    </li>
                    {% endfor %}
                </ul>
            </div>
            
            <div>
                <h3>New Users (Last 7 days)</h3>
                <ul>
                    {% for user in data.recentActivity.recent_users %}
                    <li>
                        <strong>{{ user.firstName }} {{ user.lastName }}</strong><br>
                        Username: {{ user.username }}<br>
                        Registered: {{ user.createdAt|date('M d, Y H:i') }}
                    </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Footer -->
    <div class="footer">
        <p><strong>MK Gov</strong> - Government E-Services Portal</p>
        <p>This report was automatically generated from the administrative dashboard</p>
        <p>For real-time data and interactive charts, visit the web dashboard</p>
        <p>Report generated on {{ "now"|date("Y-m-d H:i:s") }} UTC</p>
    </div>
</body>
</html>