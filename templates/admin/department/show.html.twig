{% extends 'admin/base.html.twig' %}
{% block title %}{{ department.name }}{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0"><i class="bi-eye me-2"></i>{{ department.name }}</h1>
    <div class="btn-group">
        <a href="{{ path('admin_department_edit', {'id': department.id}) }}" class="btn btn-warning">
            <i class="bi-pencil me-2"></i>Edit
        </a>
        <button type="button" class="btn btn-danger delete-btn" data-department-id="{{ department.id }}" data-department-name="{{ department.name }}">
            <i class="bi-trash me-2"></i>Delete
        </button>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0"><i class="bi-info-circle me-2"></i>Basic Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">Department Name:</label>
                            <p class="fs-5">{{ department.name }}</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">Code:</label>
                            <p>{% if department.code %}<span class="badge bg-info fs-6">{{ department.code }}</span>{% else %}<span class="text-muted">No code</span>{% endif %}</p>
                        </div>
                    </div>
                </div>
                {% if department.description %}
                <div class="mb-3">
                    <label class="form-label fw-bold text-muted">Description:</label>
                    <div class="border rounded p-3 bg-light">{{ department.description|nl2br }}</div>
                </div>
                {% endif %}
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">Status:</label>
                            <p><span class="badge bg-{{ department.isActive ? 'success' : 'danger' }} fs-6">
                                <i class="bi-{{ department.isActive ? 'check-circle' : 'x-circle' }} me-1"></i>
                                {{ department.isActive ? 'Active' : 'Inactive' }}</span></p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">Public Entities:</label>
                            <p><span class="badge bg-info fs-6">{{ department.publicEntities|length }}</span></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {% if department.publicEntities|length > 0 %}
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h5 class="card-title mb-0"><i class="bi-building me-2"></i>Public Entities ({{ department.publicEntities|length }})</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr><th>Institution Name</th><th>Contact</th><th>Status</th><th>Actions</th></tr>
                        </thead>
                        <tbody>
                            {% for entity in department.publicEntities %}
                            <tr>
                                <td><strong>{{ entity.institutionName }}</strong>
                                    <div class="text-muted small">{{ entity.code ?: 'No code' }}</div>
                                </td>
                                <td>
                                    {% if entity.email %}<div><i class="bi-envelope me-1"></i>{{ entity.email }}</div>{% endif %}
                                    {% if entity.phoneNumber %}<div><i class="bi-telephone me-1"></i>{{ entity.phoneNumber }}</div>{% endif %}
                                </td>
                                <td><span class="badge bg-{{ entity.isActive ? 'success' : 'danger' }}">{{ entity.isActive ? 'Active' : 'Inactive' }}</span></td>
                                <td><a href="{{ path('admin_public_entity_show', {'id': entity.id}) }}" class="btn btn-sm btn-outline-info"><i class="bi-eye"></i></a></td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        {% endif %}
    </div>
    
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0"><i class="bi-clock me-2"></i>Metadata</h6>
            </div>
            <div class="card-body">
                <div class="mb-3"><label class="form-label fw-bold text-muted small">ID:</label><p class="mb-0">#{{ department.id }}</p></div>
                <div class="mb-3"><label class="form-label fw-bold text-muted small">Created:</label><p class="mb-0">{{ department.createdAt|date('F d, Y \\a\\t H:i') }}</p></div>
                <div class="mb-3"><label class="form-label fw-bold text-muted small">Last Updated:</label><p class="mb-0">{{ department.updatedAt|date('F d, Y \\a\\t H:i') }}</p></div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi-exclamation-triangle me-2"></i>Confirm Deletion</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the department <strong>{{ department.name }}</strong>?</p>
                {% if department.publicEntities|length > 0 %}
                <div class="alert alert-warning">
                    <i class="bi-exclamation-triangle me-2"></i>This department has {{ department.publicEntities|length }} associated public entities.
                </div>
                {% endif %}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" action="{{ path('admin_department_delete', {'id': department.id}) }}" style="display: inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ department.id) }}">
                    <button type="submit" class="btn btn-danger"><i class="bi-trash me-1"></i>Delete Department</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.delete-btn').forEach(function(button) {
        button.addEventListener('click', function() {
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        });
    });
});
</script>
{% endblock %}