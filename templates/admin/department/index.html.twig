{% extends 'admin/base.html.twig' %}

{% block title %}Departments{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">
        <i class="bi-diagram-2 me-2"></i>
        Departments Management
    </h1>
    <a href="{{ path('admin_department_new') }}" class="btn btn-primary">
        <i class="bi-plus-circle me-2"></i>
        New Department
    </a>
</div>

{% if departments|length > 0 %}
<div class="card shadow-sm">
    <div class="card-header bg-light">
        <h5 class="card-title mb-0">
            <i class="bi-list-ul me-2"></i>
            All Departments ({{ departments|length }})
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th width="5%">#</th>
                        <th width="20%">Name</th>
                        <th width="15%">Code</th>
                        <th width="25%">Description</th>
                        <th width="8%">Public Entities</th>
                        <th width="8%">Order</th>
                        <th width="8%">Status</th>
                        <th width="11%">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for department in departments %}
                    <tr>
                        <td class="text-muted">#{{ department.id }}</td>
                        <td>
                            <strong>{{ department.name }}</strong>
                            <small class="text-muted d-block">
                                Created: {{ department.createdAt|date('M d, Y') }}
                            </small>
                        </td>
                        <td>
                            {% if department.code %}
                                <span class="badge bg-info">{{ department.code }}</span>
                            {% else %}
                                <span class="text-muted">-</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if department.description %}
                                <div class="text-truncate" style="max-width: 200px;" title="{{ department.description }}">
                                    {{ department.description|slice(0, 60) }}{% if department.description|length > 60 %}...{% endif %}
                                </div>
                            {% else %}
                                <span class="text-muted">No description</span>
                            {% endif %}
                        </td>
                        <td class="text-center">
                            <span class="badge bg-success">{{ department.publicEntities|length }}</span>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-secondary">{{ department.displayOrder }}</span>
                        </td>
                        <td>
                            <div class="form-check form-switch">
                                <input class="form-check-input status-toggle" 
                                       type="checkbox" 
                                       data-department-id="{{ department.id }}"
                                       {% if department.isActive %}checked{% endif %}>
                                <label class="form-check-label">
                                    <span class="badge bg-{{ department.isActive ? 'success' : 'danger' }}">
                                        {{ department.isActive ? 'Active' : 'Inactive' }}
                                    </span>
                                </label>
                            </div>
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm" role="group">
                                <a href="{{ path('admin_department_show', {'id': department.id}) }}" 
                                   class="btn btn-outline-info" title="View">
                                    <i class="bi-eye"></i>
                                </a>
                                <a href="{{ path('admin_department_edit', {'id': department.id}) }}" 
                                   class="btn btn-outline-warning" title="Edit">
                                    <i class="bi-pencil"></i>
                                </a>
                                <button type="button" 
                                        class="btn btn-outline-danger delete-btn" 
                                        data-department-id="{{ department.id }}"
                                        data-department-name="{{ department.name }}"
                                        title="Delete">
                                    <i class="bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% else %}
<div class="text-center py-5">
    <i class="bi-diagram-2 text-muted" style="font-size: 4rem;"></i>
    <h3 class="text-muted mt-3">No departments found</h3>
    <p class="text-muted">Start by creating your first department</p>
    <a href="{{ path('admin_department_new') }}" class="btn btn-primary">
        <i class="bi-plus-circle me-2"></i>
        Create First Department
    </a>
</div>
{% endif %}

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi-exclamation-triangle me-2"></i>
                    Confirm Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the department <strong id="departmentName"></strong>?</p>
                <p class="text-muted small">This action will deactivate the department and cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" style="display: inline;">
                    <input type="hidden" name="_token" id="deleteToken">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi-trash me-1"></i>
                        Delete Department
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Status toggle functionality
    document.querySelectorAll('.status-toggle').forEach(function(toggle) {
        toggle.addEventListener('change', function() {
            const departmentId = this.dataset.departmentId;
            
            fetch(`/admin/department/${departmentId}/toggle-status`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const badge = this.parentElement.querySelector('.badge');
                    badge.className = `badge bg-${data.status ? 'success' : 'danger'}`;
                    badge.textContent = data.status ? 'Active' : 'Inactive';
                } else {
                    this.checked = !this.checked;
                    alert('Error updating status: ' + data.message);
                }
            })
            .catch(error => {
                this.checked = !this.checked;
                alert('Error updating status');
            });
        });
    });

    // Delete modal functionality
    document.querySelectorAll('.delete-btn').forEach(function(button) {
        button.addEventListener('click', function() {
            const departmentId = this.dataset.departmentId;
            const departmentName = this.dataset.departmentName;
            
            document.getElementById('departmentName').textContent = departmentName;
            document.getElementById('deleteForm').action = `/admin/department/${departmentId}/delete`;
            document.getElementById('deleteToken').value = '{{ csrf_token("delete") }}';
            
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        });
    });
});
</script>
{% endblock %}