{% extends 'admin/base.html.twig' %}

{% block title %}Workflow Steps for {{ procedure.pname }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">
        <i class="bi-diagram-3 me-2"></i>
        Workflow Steps for "{{ procedure.pname }}"
    </h1>
    <div class="btn-group">
        <a href="{{ path('admin_workflow_new', {'procedure': procedure.id}) }}" class="btn btn-primary">
            <i class="bi-plus-circle me-2"></i>
            Add New Step
        </a>
        <a href="{{ path('admin_procedure_show', {'id': procedure.id}) }}" class="btn btn-info">
            <i class="bi-file-earmark-text me-2"></i>
            View Procedure
        </a>
    </div>
</div>

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('admin_workflow_index') }}">Workflow Steps</a></li>
        <li class="breadcrumb-item"><a href="{{ path('admin_procedure_index') }}">Procedures</a></li>
        <li class="breadcrumb-item"><a href="{{ path('admin_procedure_show', {'id': procedure.id}) }}">{{ procedure.pname }}</a></li>
        <li class="breadcrumb-item active" aria-current="page">Workflow Steps</li>
    </ol>
</nav>

<!-- Procedure Summary -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-info text-white">
        <h5 class="card-title mb-0">
            <i class="bi-file-earmark-text me-2"></i>
            Procedure Overview
        </h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-3">
                {% if procedure.image %}
                    <img src="{{ asset('uploads/procedures/' ~ procedure.image) }}" 
                         alt="{{ procedure.pname }}" 
                         class="img-fluid rounded border mb-3"
                         style="max-height: 120px;">
                {% else %}
                    <div class="text-center border rounded p-3 mb-3 bg-light">
                        <i class="bi-file-earmark-text" style="font-size: 3rem; color: #6c757d;"></i>
                    </div>
                {% endif %}
            </div>
            <div class="col-md-9">
                <h5 class="text-info">{{ procedure.pname }}</h5>
                {% if procedure.family %}
                    <p class="mb-2">
                        <span class="badge bg-primary">{{ procedure.family.fname }}</span>
                    </p>
                {% endif %}
                
                <p class="mb-3">{{ procedure.shortdesc }}</p>
                
                <div class="row">
                    <div class="col-md-4">
                        <strong class="small text-muted">Service Cost:</strong>
                        <div><span class="badge bg-success">{{ procedure.servicecost|number_format(0, '.', ',') }} XAF</span></div>
                    </div>
                    <div class="col-md-4">
                        <strong class="small text-muted">Processing Time:</strong>
                        <div><span class="badge bg-info">{{ procedure.processtime }}</span></div>
                    </div>
                    <div class="col-md-4">
                        <strong class="small text-muted">Total Steps:</strong>
                        <div><span class="badge bg-secondary">{{ workflows|length }}</span></div>
                    </div>
                </div>
                
                {% if procedure.providingAdministration %}
                <div class="mt-3 pt-3 border-top">
                    <strong class="small text-muted">Providing Administration:</strong>
                    <div>{{ procedure.providingAdministration.institutionName }}</div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{% if workflows|length > 0 %}
<!-- Workflow Timeline -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="card-title mb-0">
            <i class="bi-arrow-right-circle me-2"></i>
            Workflow Timeline ({{ workflows|length }} Steps)
        </h5>
    </div>
    <div class="card-body">
        <div class="timeline-container" style="overflow-x: auto;">
            <div class="d-flex align-items-center" style="min-width: {{ workflows|length * 300 }}px;">
                {% for workflow in workflows %}
                <div class="flex-fill text-center position-relative">
                    <!-- Timeline Step -->
                    <div class="timeline-step">
                        <div class="step-number bg-{{ workflow.isActive ? 'primary' : 'secondary' }} text-white rounded-circle d-inline-flex align-items-center justify-content-center"
                             style="width: 40px; height: 40px; font-weight: bold;">
                            {{ workflow.stepOrder }}
                        </div>
                        {% if not loop.last %}
                        <div class="step-connector position-absolute" style="top: 20px; left: 50%; width: 100%; height: 2px; background: #dee2e6; z-index: -1;"></div>
                        {% endif %}
                    </div>
                    
                    <!-- Step Info -->
                    <div class="mt-3">
                        <h6 class="mb-1">{{ workflow.name }}</h6>
                        <small class="text-muted d-block mb-2">{{ workflow.shortDescription|slice(0, 60) }}{% if workflow.shortDescription|length > 60 %}...{% endif %}</small>
                        
                        <div class="mb-2">
                            {% if workflow.isRequired %}
                                <span class="badge bg-warning badge-sm">Required</span>
                            {% else %}
                                <span class="badge bg-info badge-sm">Optional</span>
                            {% endif %}
                            {% if not workflow.isActive %}
                                <span class="badge bg-danger badge-sm">Inactive</span>
                            {% endif %}
                        </div>
                        
                        <div class="btn-group btn-group-sm">
                            <a href="{{ path('admin_workflow_show', {'id': workflow.id}) }}" 
                               class="btn btn-outline-primary btn-sm">
                                <i class="bi-eye"></i>
                            </a>
                            <a href="{{ path('admin_workflow_edit', {'id': workflow.id}) }}" 
                               class="btn btn-outline-warning btn-sm">
                                <i class="bi-pencil"></i>
                            </a>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

<!-- Detailed Steps Table -->
<div class="card shadow-sm">
    <div class="card-header bg-light">
        <h5 class="card-title mb-0">
            <i class="bi-list-ul me-2"></i>
            Detailed Workflow Steps
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0" id="workflowTable">
                <thead class="table-light">
                    <tr>
                        <th width="8%">Order</th>
                        <th width="20%">Step Name</th>
                        <th width="25%">Description</th>
                        <th width="20%">Required Inputs</th>
                        <th width="15%">Output</th>
                        <th width="7%">Status</th>
                        <th width="5%">Actions</th>
                    </tr>
                </thead>
                <tbody id="sortableWorkflows">
                    {% for workflow in workflows %}
                    <tr data-workflow-id="{{ workflow.id }}" class="sortable-row">
                        <td class="text-center">
                            <span class="badge bg-primary fs-6 drag-handle" style="cursor: move;">
                                <i class="bi-grip-vertical me-1"></i>{{ workflow.stepOrder }}
                            </span>
                        </td>
                        <td>
                            <strong>{{ workflow.name }}</strong>
                            <div class="small text-muted">
                                Created: {{ workflow.createdAt|date('M d, Y') }}
                            </div>
                        </td>
                        <td>
                            <div class="text-truncate" style="max-width: 250px;" title="{{ workflow.shortDescription }}">
                                {{ workflow.shortDescription }}
                            </div>
                        </td>
                        <td>
                            {% if workflow.inputs|length > 0 %}
                                <div class="d-flex flex-wrap gap-1">
                                    {% for input in workflow.inputsLabels|slice(0, 3) %}
                                        <span class="badge bg-warning badge-sm">{{ input|slice(0, 10) }}{% if input|length > 10 %}...{% endif %}</span>
                                    {% endfor %}
                                    {% if workflow.inputs|length > 3 %}
                                        <span class="badge bg-secondary badge-sm">+{{ workflow.inputs|length - 3 }}</span>
                                    {% endif %}
                                </div>
                            {% else %}
                                <span class="text-muted small">No inputs</span>
                            {% endif %}
                        </td>
                        <td>
                            <span class="badge bg-success badge-sm">{{ workflow.outputLabel|slice(0, 15) }}{% if workflow.outputLabel|length > 15 %}...{% endif %}</span>
                        </td>
                        <td>
                            <div class="d-flex flex-column gap-1">
                                <!-- Active Status -->
                                <div class="form-check form-switch form-check-sm">
                                    <input class="form-check-input status-toggle" 
                                           type="checkbox" 
                                           data-workflow-id="{{ workflow.id }}"
                                           {% if workflow.isActive %}checked{% endif %}>
                                    <label class="form-check-label small">
                                        {{ workflow.isActive ? 'Active' : 'Inactive' }}
                                    </label>
                                </div>
                                <!-- Required Status -->
                                <div class="form-check form-switch form-check-sm">
                                    <input class="form-check-input required-toggle" 
                                           type="checkbox" 
                                           data-workflow-id="{{ workflow.id }}"
                                           {% if workflow.isRequired %}checked{% endif %}>
                                    <label class="form-check-label small">
                                        {{ workflow.isRequired ? 'Required' : 'Optional' }}
                                    </label>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm" role="group">
                                <a href="{{ path('admin_workflow_show', {'id': workflow.id}) }}" 
                                   class="btn btn-outline-info" title="View">
                                    <i class="bi-eye"></i>
                                </a>
                                <a href="{{ path('admin_workflow_edit', {'id': workflow.id}) }}" 
                                   class="btn btn-outline-warning" title="Edit">
                                    <i class="bi-pencil"></i>
                                </a>
                                <button type="button" 
                                        class="btn btn-outline-danger delete-btn" 
                                        data-workflow-id="{{ workflow.id }}"
                                        data-workflow-name="{{ workflow.name }}"
                                        title="Delete">
                                    <i class="bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% else %}
<div class="text-center py-5">
    <i class="bi-diagram-3 text-muted" style="font-size: 4rem;"></i>
    <h3 class="text-muted mt-3">No workflow steps defined</h3>
    <p class="text-muted">This procedure doesn't have any workflow steps yet. Start by creating the first step.</p>
    <a href="{{ path('admin_workflow_new', {'procedure': procedure.id}) }}" class="btn btn-primary">
        <i class="bi-plus-circle me-2"></i>
        Create First Workflow Step
    </a>
</div>
{% endif %}

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi-exclamation-triangle me-2"></i>
                    Confirm Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the workflow step <strong id="workflowName"></strong>?</p>
                <p class="text-muted small">This action will deactivate the workflow step and cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" style="display: inline;">
                    <input type="hidden" name="_token" id="deleteToken">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi-trash me-1"></i>
                        Delete Workflow Step
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Sortable functionality for reordering steps
    const sortableWorkflows = document.getElementById('sortableWorkflows');
    if (sortableWorkflows) {
        // Simple drag and drop implementation
        let draggedElement = null;
        
        document.querySelectorAll('.drag-handle').forEach(function(handle) {
            handle.parentElement.parentElement.draggable = true;
            
            handle.parentElement.parentElement.addEventListener('dragstart', function(e) {
                draggedElement = this;
                this.style.opacity = '0.5';
            });
            
            handle.parentElement.parentElement.addEventListener('dragend', function(e) {
                this.style.opacity = '';
                draggedElement = null;
            });
            
            handle.parentElement.parentElement.addEventListener('dragover', function(e) {
                e.preventDefault();
            });
            
            handle.parentElement.parentElement.addEventListener('drop', function(e) {
                e.preventDefault();
                if (draggedElement && draggedElement !== this) {
                    const allRows = Array.from(sortableWorkflows.children);
                    const draggedIndex = allRows.indexOf(draggedElement);
                    const targetIndex = allRows.indexOf(this);
                    
                    if (draggedIndex < targetIndex) {
                        this.parentNode.insertBefore(draggedElement, this.nextSibling);
                    } else {
                        this.parentNode.insertBefore(draggedElement, this);
                    }
                    
                    updateStepOrder();
                }
            });
        });
    }
    
    function updateStepOrder() {
        const rows = document.querySelectorAll('#sortableWorkflows tr');
        const workflowIds = [];
        
        rows.forEach(function(row, index) {
            const workflowId = row.dataset.workflowId;
            workflowIds.push(workflowId);
            
            // Update visual order
            const orderBadge = row.querySelector('.badge');
            orderBadge.innerHTML = `<i class="bi-grip-vertical me-1"></i>${index + 1}`;
        });
        
        // Save new order
        fetch(`/admin/workflow/reorder/{{ procedure.id }}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: `workflow_ids=${JSON.stringify(workflowIds)}`
        })
        .then(response => response.json())
        .then(data => {
            if (!data.success) {
                alert('Error reordering steps: ' + data.message);
                location.reload();
            }
        })
        .catch(error => {
            alert('Error reordering steps');
            location.reload();
        });
    }

    // Status toggle functionality
    document.querySelectorAll('.status-toggle').forEach(function(toggle) {
        toggle.addEventListener('change', function() {
            const workflowId = this.dataset.workflowId;
            
            fetch(`/admin/workflow/${workflowId}/toggle-status`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const label = this.parentElement.querySelector('.form-check-label');
                    label.textContent = data.status ? 'Active' : 'Inactive';
                } else {
                    this.checked = !this.checked; 
                    alert('Error updating status: ' + data.message);
                }
            })
            .catch(error => {
                this.checked = !this.checked; 
                alert('Error updating status');
            });
        });
    });

    // Required toggle functionality
    document.querySelectorAll('.required-toggle').forEach(function(toggle) {
        toggle.addEventListener('change', function() {
            const workflowId = this.dataset.workflowId;
            
            fetch(`/admin/workflow/${workflowId}/toggle-required`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const label = this.parentElement.querySelector('.form-check-label');
                    label.textContent = data.required ? 'Required' : 'Optional';
                } else {
                    this.checked = !this.checked; 
                    alert('Error updating required status: ' + data.message);
                }
            })
            .catch(error => {
                this.checked = !this.checked; 
                alert('Error updating required status');
            });
        });
    });

    // Delete modal functionality
    document.querySelectorAll('.delete-btn').forEach(function(button) {
        button.addEventListener('click', function() {
            const workflowId = this.dataset.workflowId;
            const workflowName = this.dataset.workflowName;
            
            document.getElementById('workflowName').textContent = workflowName;
            document.getElementById('deleteForm').action = `/admin/workflow/${workflowId}/delete`;
            document.getElementById('deleteToken').value = '{{ csrf_token("delete") }}';
            
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        });
    });
});
</script>

<style>
.timeline-container {
    padding: 20px 0;
}

.timeline-step {
    position: relative;
}

.step-number {
    position: relative;
    z-index: 2;
}

.step-connector {
    transform: translateX(20px);
}

.sortable-row:hover {
    background-color: #f8f9fa;
}

.drag-handle:hover {
    background-color: #0d6efd !important;
    cursor: move;
}

.badge-sm {
    font-size: 0.7em;
}
</style>
{% endblock %}