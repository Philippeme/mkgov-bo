{% extends 'admin/base.html.twig' %}

{% block title %}Edit Workflow Step{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">
        <i class="bi-pencil me-2"></i>
        Edit Workflow Step: {{ workflow.name }}
    </h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="{{ path('admin_workflow_index') }}">Workflow Steps</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin_workflow_show', {'id': workflow.id}) }}">{{ workflow.name }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit</li>
        </ol>
    </nav>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-warning text-dark">
        <h5 class="card-title mb-0">
            <i class="bi-diagram-3 me-2"></i>
            Update Workflow Step Information
        </h5>
    </div>
    <div class="card-body">
        {{ include('admin/workflow/_form.html.twig', {'button_label': 'Update Workflow Step'}) }}
    </div>
</div>

<!-- Current Step Context -->
<div class="row mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h6 class="card-title mb-0">
                    <i class="bi-info-circle me-2"></i>
                    Current Step Information
                </h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-6">
                        <strong class="small text-muted">Step Order:</strong>
                        <div class="mb-2">
                            <span class="badge bg-primary"># {{ workflow.stepOrder }}</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <strong class="small text-muted">Status:</strong>
                        <div class="mb-2">
                            <span class="badge bg-{{ workflow.isActive ? 'success' : 'danger' }}">
                                {{ workflow.isActive ? 'Active' : 'Inactive' }}
                            </span>
                        </div>
                    </div>
                </div>
                
                <div class="mb-2">
                    <strong class="small text-muted">Step Type:</strong>
                    <div>
                        <span class="badge bg-{{ workflow.isRequired ? 'warning' : 'info' }}">
                            {{ workflow.isRequired ? 'Required' : 'Optional' }}
                        </span>
                    </div>
                </div>
                
                <div class="mb-2">
                    <strong class="small text-muted">Created:</strong>
                    <div class="small">{{ workflow.createdAt|date('F d, Y \\a\\t H:i') }}</div>
                </div>
                
                <div>
                    <strong class="small text-muted">Last Updated:</strong>
                    <div class="small">{{ workflow.updatedAt|date('F d, Y \\a\\t H:i') }}</div>
                </div>
            </div>
        </div>
    </div>
    
    {% if workflow.procedure %}
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h6 class="card-title mb-0">
                    <i class="bi-file-earmark-text me-2"></i>
                    Procedure Context
                </h6>
            </div>
            <div class="card-body">
                <div class="mb-2">
                    <strong>{{ workflow.procedure.pname }}</strong>
                    {% if workflow.procedure.family %}
                        <div class="small text-muted">{{ workflow.procedure.family.fname }}</div>
                    {% endif %}
                </div>
                
                {% if workflow.procedure.workflowCount > 1 %}
                <div class="mb-2">
                    <strong class="small text-muted">Steps in Procedure:</strong>
                    <div>
                        <span class="badge bg-secondary">{{ workflow.procedure.workflowCount }} total steps</span>
                    </div>
                </div>
                {% endif %}
                
                <div class="row">
                    <div class="col-6">
                        <strong class="small text-muted">Cost:</strong>
                        <div class="small">
                            <span class="badge bg-success">{{ workflow.procedure.servicecost|number_format(0, '.', ',') }} XAF</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <strong class="small text-muted">Time:</strong>
                        <div class="small">
                            <span class="badge bg-info">{{ workflow.procedure.processtime }}</span>
                        </div>
                    </div>
                </div>
                
                <div class="mt-3">
                    <a href="{{ path('admin_procedure_show', {'id': workflow.procedure.id}) }}" 
                       class="btn btn-success btn-sm">
                        <i class="bi-eye me-1"></i>View Procedure
                    </a>
                    {% if workflow.procedure.workflowCount > 1 %}
                    <a href="{{ path('admin_workflow_by_procedure', {'id': workflow.procedure.id}) }}" 
                       class="btn btn-outline-primary btn-sm">
                        <i class="bi-diagram-3 me-1"></i>All Steps
                    </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    {% endif %}
</div>

<!-- Step Inputs & Output Preview -->
<div class="row mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h6 class="card-title mb-0">
                    <i class="bi-arrow-down-circle me-2"></i>
                    Current Required Inputs ({{ workflow.inputs|length }})
                </h6>
            </div>
            <div class="card-body">
                {% if workflow.inputs|length > 0 %}
                    <div class="row">
                        {% for input in workflow.inputsLabels %}
                        <div class="col-12 mb-2">
                            <div class="d-flex align-items-center">
                                <i class="bi-file-earmark text-warning me-2"></i>
                                <span class="small">{{ input }}</span>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-muted small mb-0">No inputs currently defined</p>
                {% endif %}
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h6 class="card-title mb-0">
                    <i class="bi-arrow-up-circle me-2"></i>
                    Current Step Output
                </h6>
            </div>
            <div class="card-body">
                {% if workflow.output %}
                    <div class="d-flex align-items-center">
                        <i class="bi-check-circle text-success me-2" style="font-size: 1.5rem;"></i>
                        <div>
                            <strong class="text-success">{{ workflow.outputLabel }}</strong>
                            <div class="small text-muted">Step completion result</div>
                        </div>
                    </div>
                {% else %}
                    <p class="text-muted small mb-0">No output currently defined</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<!-- Actions -->
<div class="mt-4">
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-{{ workflow.isActive ? 'danger' : 'success' }} toggle-status-btn"
                data-workflow-id="{{ workflow.id }}">
            <i class="bi-{{ workflow.isActive ? 'pause' : 'play' }} me-2"></i>
            {{ workflow.isActive ? 'Deactivate' : 'Activate' }}
        </button>
        <button type="button" class="btn btn-outline-{{ workflow.isRequired ? 'info' : 'warning' }} toggle-required-btn"
                data-workflow-id="{{ workflow.id }}">
            <i class="bi-{{ workflow.isRequired ? 'info-circle' : 'exclamation-triangle' }} me-2"></i>
            Make {{ workflow.isRequired ? 'Optional' : 'Required' }}
        </button>
        <button type="button" class="btn btn-outline-success duplicate-btn"
                data-workflow-id="{{ workflow.id }}"
                data-workflow-name="{{ workflow.name }}">
            <i class="bi-files me-2"></i>
            Duplicate Step
        </button>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Toggle status functionality
    document.querySelectorAll('.toggle-status-btn').forEach(function(button) {
        button.addEventListener('click', function() {
            const workflowId = this.dataset.workflowId;
            
            fetch(`/admin/workflow/${workflowId}/toggle-status`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error updating status: ' + data.message);
                }
            })
            .catch(error => {
                alert('Error updating status');
            });
        });
    });

    // Toggle required functionality
    document.querySelectorAll('.toggle-required-btn').forEach(function(button) {
        button.addEventListener('click', function() {
            const workflowId = this.dataset.workflowId;
            
            fetch(`/admin/workflow/${workflowId}/toggle-required`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error updating required status: ' + data.message);
                }
            })
            .catch(error => {
                alert('Error updating required status');
            });
        });
    });

    // Duplicate functionality
    document.querySelectorAll('.duplicate-btn').forEach(function(button) {
        button.addEventListener('click', function() {
            const workflowId = this.dataset.workflowId;
            const workflowName = this.dataset.workflowName;
            
            if (confirm(`Are you sure you want to duplicate the workflow step "${workflowName}"?`)) {
                fetch(`/admin/workflow/duplicate/${workflowId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        window.location.href = `/admin/workflow/${data.new_id}`;
                    } else {
                        alert('Error duplicating workflow step: ' + data.message);
                    }
                })
                .catch(error => {
                    alert('Error duplicating workflow step');
                });
            }
        });
    });
});
</script>
{% endblock %}