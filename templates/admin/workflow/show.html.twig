{% extends 'admin/base.html.twig' %}

{% block title %}{{ workflow.name }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">
        <i class="bi-diagram-3 me-2"></i>
        {{ workflow.name }}
    </h1>
    <div class="btn-group">
        <a href="{{ path('admin_workflow_edit', {'id': workflow.id}) }}" class="btn btn-warning">
            <i class="bi-pencil me-2"></i>
            Edit
        </a>
        {% if workflow.procedure %}
        <a href="{{ path('admin_procedure_show', {'id': workflow.procedure.id}) }}" 
           class="btn btn-info">
            <i class="bi-file-earmark-text me-2"></i>
            View Procedure
        </a>
        {% endif %}
        <button type="button" 
                class="btn btn-success duplicate-btn" 
                data-workflow-id="{{ workflow.id }}"
                data-workflow-name="{{ workflow.name }}">
            <i class="bi-files me-2"></i>
            Duplicate
        </button>
        <button type="button" 
                class="btn btn-danger delete-btn" 
                data-workflow-id="{{ workflow.id }}"
                data-workflow-name="{{ workflow.name }}">
            <i class="bi-trash me-2"></i>
            Delete
        </button>
    </div>
</div>

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('admin_workflow_index') }}">Workflow Steps</a></li>
        <li class="breadcrumb-item active" aria-current="page">{{ workflow.name }}</li>
    </ol>
</nav>

<div class="row">
    <div class="col-md-8">
        <!-- Basic Information -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0">
                    <i class="bi-info-circle me-2"></i>
                    Step Information
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">Step Name:</label>
                            <p class="fs-5">{{ workflow.name }}</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">Step Order:</label>
                            <p><span class="badge bg-primary fs-6"># {{ workflow.stepOrder }}</span></p>
                        </div>
                    </div>
                </div>
                
                <div class="mb-3">
                    <label class="form-label fw-bold text-muted">Description:</label>
                    <div class="border rounded p-3 bg-light">
                        {{ workflow.shortDescription|nl2br }}
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">Display Order:</label>
                            <p><span class="badge bg-secondary fs-6">{{ workflow.displayOrder }}</span></p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">Status:</label>
                            <p>
                                <span class="badge bg-{{ workflow.isActive ? 'success' : 'danger' }} fs-6">
                                    <i class="bi-{{ workflow.isActive ? 'check-circle' : 'x-circle' }} me-1"></i>
                                    {{ workflow.isActive ? 'Active' : 'Inactive' }}
                                </span>
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">Step Type:</label>
                            <p>
                                <span class="badge bg-{{ workflow.isRequired ? 'warning' : 'info' }} fs-6">
                                    <i class="bi-{{ workflow.isRequired ? 'exclamation-triangle' : 'info-circle' }} me-1"></i>
                                    {{ workflow.isRequired ? 'Required' : 'Optional' }}
                                </span>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Procedure Information -->
        {% if workflow.procedure %}
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-info text-white">
                <h5 class="card-title mb-0">
                    <i class="bi-file-earmark-text me-2"></i>
                    Associated Procedure
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        {% if workflow.procedure.image %}
                            <img src="{{ asset('uploads/procedures/' ~ workflow.procedure.image) }}" 
                                 alt="{{ workflow.procedure.pname }}" 
                                 class="img-fluid rounded border mb-3"
                                 style="max-height: 100px;">
                        {% else %}
                            <div class="text-center border rounded p-3 mb-3 bg-light">
                                <i class="bi-file-earmark-text" style="font-size: 2rem; color: #6c757d;"></i>
                            </div>
                        {% endif %}
                    </div>
                    <div class="col-md-9">
                        <h6 class="text-info">{{ workflow.procedure.pname }}</h6>
                        {% if workflow.procedure.family %}
                            <p class="mb-2">
                                <span class="badge bg-primary">{{ workflow.procedure.family.fname }}</span>
                            </p>
                        {% endif %}
                        
                        <div class="mb-2">
                            <strong class="text-muted small">Description:</strong>
                            <p class="mb-1">{{ workflow.procedure.shortdesc|slice(0, 150) }}{% if workflow.procedure.shortdesc|length > 150 %}...{% endif %}</p>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <strong class="text-muted small">Cost:</strong>
                                <p class="mb-1">
                                    <span class="badge bg-success">{{ workflow.procedure.servicecost|number_format(0, '.', ',') }} XAF</span>
                                </p>
                            </div>
                            <div class="col-md-6">
                                <strong class="text-muted small">Processing Time:</strong>
                                <p class="mb-1">
                                    <span class="badge bg-info">{{ workflow.procedure.processtime }}</span>
                                </p>
                            </div>
                        </div>
                        
                        {% if workflow.procedure.providingAdministration %}
                        <div class="mt-3 pt-3 border-top">
                            <strong class="text-muted small">Providing Administration:</strong>
                            <p class="mb-1">{{ workflow.procedure.providingAdministration.institutionName }}</p>
                            {% if workflow.procedure.providingAdministration.department %}
                            <small class="text-muted">{{ workflow.procedure.providingAdministration.department.name }}</small>
                            {% endif %}
                        </div>
                        {% endif %}
                        
                        <div class="mt-3 pt-3 border-top">
                            <a href="{{ path('admin_procedure_show', {'id': workflow.procedure.id}) }}" 
                               class="btn btn-info btn-sm">
                                <i class="bi-eye me-1"></i>View Full Procedure Details
                            </a>
                            {% if workflow.procedure.activeWorkflows|length > 1 %}
                                <span class="ms-3 text-muted small">
                                    This procedure has {{ workflow.procedure.activeWorkflows|length }} workflow steps
                                </span>
                                <a href="{{ path('admin_workflow_by_procedure', {'id': workflow.procedure.id}) }}" 
                                   class="btn btn-outline-primary btn-sm ms-2">
                                    <i class="bi-diagram-3 me-1"></i>View All Steps
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}

        <!-- Input Requirements -->
        {% if workflow.inputs|length > 0 %}
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-warning text-dark">
                <h5 class="card-title mb-0">
                    <i class="bi-arrow-down-circle me-2"></i>
                    Required Inputs ({{ workflow.inputs|length }})
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    {% for input in workflow.inputsLabels %}
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="card border-warning">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center">
                                    <i class="bi-file-earmark text-warning me-2" style="font-size: 1.5rem;"></i>
                                    <div>
                                        <h6 class="mb-0">{{ input }}</h6>
                                        <small class="text-muted">Required document</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
        {% endif %}

        <!-- Output Information -->
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h5 class="card-title mb-0">
                    <i class="bi-arrow-up-circle me-2"></i>
                    Step Output
                </h5>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <i class="bi-check-circle text-success me-3" style="font-size: 3rem;"></i>
                    <div>
                        <h5 class="text-success mb-2">{{ workflow.outputLabel }}</h5>
                        <p class="text-muted mb-0">This is what will be achieved upon completion of this workflow step.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <!-- Metadata -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="bi-clock me-2"></i>
                    Metadata
                </h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-bold text-muted small">ID:</label>
                    <p class="mb-0">#{{ workflow.id }}</p>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold text-muted small">Created:</label>
                    <p class="mb-0">{{ workflow.createdAt|date('F d, Y \\a\\t H:i') }}</p>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold text-muted small">Last Updated:</label>
                    <p class="mb-0">{{ workflow.updatedAt|date('F d, Y \\a\\t H:i') }}</p>
                </div>
                {% if workflow.procedure %}
                <div class="mb-3">
                    <label class="form-label fw-bold text-muted small">Procedure Context:</label>
                    <div class="border rounded p-2 bg-light">
                        <strong>{{ workflow.procedure.pname }}</strong>
                        {% if workflow.procedure.workflowCount > 1 %}
                        <div class="text-muted small mt-1">
                            Step {{ workflow.stepOrder }} of {{ workflow.procedure.workflowCount }}
                        </div>
                        {% endif %}
                    </div>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="bi-lightning me-2"></i>
                    Quick Actions
                </h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-outline-{{ workflow.isActive ? 'danger' : 'success' }} toggle-status-btn"
                            data-workflow-id="{{ workflow.id }}">
                        <i class="bi-{{ workflow.isActive ? 'pause' : 'play' }} me-2"></i>
                        {{ workflow.isActive ? 'Deactivate' : 'Activate' }}
                    </button>
                    <button type="button" class="btn btn-outline-{{ workflow.isRequired ? 'info' : 'warning' }} toggle-required-btn"
                            data-workflow-id="{{ workflow.id }}">
                        <i class="bi-{{ workflow.isRequired ? 'info-circle' : 'exclamation-triangle' }} me-2"></i>
                        Make {{ workflow.isRequired ? 'Optional' : 'Required' }}
                    </button>
                    {% if workflow.procedure and workflow.procedure.workflowCount > 1 %}
                    <a href="{{ path('admin_workflow_by_procedure', {'id': workflow.procedure.id}) }}" class="btn btn-outline-primary">
                        <i class="bi-diagram-3 me-2"></i>
                        View All Steps
                    </a>
                    {% endif %}
                    <button type="button" class="btn btn-outline-success duplicate-action-btn"
                            data-workflow-id="{{ workflow.id }}">
                        <i class="bi-files me-2"></i>
                        Duplicate Step
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi-exclamation-triangle me-2"></i>
                    Confirm Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the workflow step <strong>{{ workflow.name }}</strong>?</p>
                <p class="text-muted small">This action will deactivate the workflow step and cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" action="{{ path('admin_workflow_delete', {'id': workflow.id}) }}" style="display: inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ workflow.id) }}">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi-trash me-1"></i>
                        Delete Workflow Step
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Delete button functionality
    document.querySelectorAll('.delete-btn').forEach(function(button) {
        button.addEventListener('click', function() {
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        });
    });

    // Toggle status functionality
    document.querySelectorAll('.toggle-status-btn').forEach(function(button) {
        button.addEventListener('click', function() {
            const workflowId = this.dataset.workflowId;
            
            fetch(`/admin/workflow/${workflowId}/toggle-status`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error updating status: ' + data.message);
                }
            })
            .catch(error => {
                alert('Error updating status');
            });
        });
    });

    // Toggle required functionality
    document.querySelectorAll('.toggle-required-btn').forEach(function(button) {
        button.addEventListener('click', function() {
            const workflowId = this.dataset.workflowId;
            
            fetch(`/admin/workflow/${workflowId}/toggle-required`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error updating required status: ' + data.message);
                }
            })
            .catch(error => {
                alert('Error updating required status');
            });
        });
    });

    // Duplicate functionality
    document.querySelectorAll('.duplicate-btn, .duplicate-action-btn').forEach(function(button) {
        button.addEventListener('click', function() {
            const workflowId = this.dataset.workflowId;
            const workflowName = this.dataset.workflowName || '{{ workflow.name }}';
            
            if (confirm(`Are you sure you want to duplicate the workflow step "${workflowName}"?`)) {
                fetch(`/admin/workflow/duplicate/${workflowId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        window.location.href = `/admin/workflow/${data.new_id}`;
                    } else {
                        alert('Error duplicating workflow step: ' + data.message);
                    }
                })
                .catch(error => {
                    alert('Error duplicating workflow step');
                });
            }
        });
    });
});
</script>
{% endblock %}