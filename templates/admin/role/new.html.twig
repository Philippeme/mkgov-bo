<!-- templates/admin/role/new.html.twig -->
{% extends 'admin/base.html.twig' %}

{% block title %}New Role{% endblock %}

{% block body %}
<h1>Create New Role</h1>

<div class="card">
    <div class="card-body">
        {{ include('admin/role/_form.html.twig') }}
    </div>
</div>
{% endblock %}

<!-- templates/admin/role/edit.html.twig -->
{% extends 'admin/base.html.twig' %}

{% block title %}Edit Role{% endblock %}

{% block body %}
<h1>Edit Role: {{ role.displayName }}</h1>

<div class="card">
    <div class="card-body">
        {{ include('admin/role/_form.html.twig', {'button_label': 'Update'}) }}
    </div>
</div>
{% endblock %}