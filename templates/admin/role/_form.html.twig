{{ form_start(form) }}
<div class="row">
    <div class="col-md-8">
        <div class="mb-3">
            {{ form_row(form.name) }}
        </div>
        
        <div class="mb-3">
            {{ form_row(form.displayName) }}
        </div>
        
        <div class="mb-3">
            {{ form_row(form.description) }}
        </div>
        
        <div class="mb-3">
            <label class="form-label">Permissions</label>
            <div class="permissions-container border rounded p-3" style="max-height: 300px; overflow-y: auto;">
                {{ form_widget(form.permissions) }}
            </div>
            <div class="form-text">{{ form.permissions.vars.help }}</div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="mb-3">
            {{ form_row(form.displayOrder) }}
        </div>
        
        <div class="form-check mb-3">
            {{ form_widget(form.isActive) }}
            {{ form_label(form.isActive) }}
            <div class="form-text">{{ form.isActive.vars.help }}</div>
        </div>
        
        <div class="form-check mb-3">
            {{ form_widget(form.isSystem) }}
            {{ form_label(form.isSystem) }}
            <div class="form-text text-warning">{{ form.isSystem.vars.help }}</div>
        </div>
    </div>
</div>

<div class="d-flex gap-2">
    <button class="btn btn-primary">{{ button_label|default('Save') }}</button>
    <a href="{{ path('admin_role_index') }}" class="btn btn-secondary">Cancel</a>
</div>
{{ form_end(form) }}