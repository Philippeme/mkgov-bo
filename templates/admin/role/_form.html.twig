{{ form_start(form, {'attr': {'class': 'role-form', 'novalidate': 'novalidate'}}) }}

<style>
.role-form .form-section {
    background: white;
    border-radius: 15px;
    padding: 25px;
    margin-bottom: 20px;
    box-shadow: 0 2px 15px rgba(0,0,0,0.08);
    border-left: 4px solid #1a4b8f;
}

.role-form .section-title {
    color: #1a4b8f;
    font-weight: 600;
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 2px solid #e9ecef;
    display: flex;
    align-items: center;
    gap: 10px;
}

.role-form .form-control,
.role-form .form-select {
    border: 2px solid #e9ecef;
    border-radius: 10px;
    padding: 12px 15px;
    transition: all 0.3s ease;
    font-size: 16px;
}

.role-form .form-control:focus,
.role-form .form-select:focus {
    border-color: #1a4b8f;
    box-shadow: 0 0 0 0.2rem rgba(26, 75, 143, 0.15);
    outline: none;
}

.role-form label {
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 5px;
}

.role-form .form-text {
    color: #6c757d;
    font-size: 0.875rem;
    margin-top: 5px;
}

.role-name-input {
    font-family: 'Courier New', monospace;
    font-weight: bold;
    text-transform: uppercase;
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
}

.role-preview {
    background: linear-gradient(135deg, #f0f7ff 0%, #e8f2ff 100%);
    border: 2px solid #1a4b8f;
    border-radius: 15px;
    padding: 20px;
    text-align: center;
    margin-top: 15px;
}

.role-preview-badge {
    display: inline-block;
    background: linear-gradient(135deg, #1a4b8f 0%, #2a5db3 100%);
    color: white;
    padding: 8px 16px;
    border-radius: 20px;
    font-weight: 600;
    margin-bottom: 10px;
}

.permissions-container {
    max-height: 500px;
    overflow-y: auto;
    border: 2px solid #e9ecef;
    border-radius: 15px;
    background: #f8f9fa;
    padding: 20px;
}

.permissions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 15px;
}

.permission-card {
    background: white;
    border: 2px solid #e9ecef;
    border-radius: 12px;
    padding: 15px;
    transition: all 0.3s ease;
    cursor: pointer;
    position: relative;
}

.permission-card:hover {
    border-color: #1a4b8f;
    box-shadow: 0 4px 15px rgba(26, 75, 143, 0.15);
    transform: translateY(-2px);
}

.permission-card.selected {
    border-color: #1a4b8f;
    background: linear-gradient(135deg, #f0f7ff 0%, #e8f2ff 100%);
}

.permission-card input[type="checkbox"] {
    position: absolute;
    top: 15px;
    right: 15px;
    transform: scale(1.3);
}

.permission-name {
    font-weight: 600;
    color: #1a4b8f;
    margin-bottom: 8px;
    margin-right: 30px;
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
}

.permission-description {
    color: #6c757d;
    font-size: 0.875rem;
    line-height: 1.4;
    margin-right: 30px;
}

.permission-order {
    position: absolute;
    bottom: 10px;
    right: 15px;
    background: #6c757d;
    color: white;
    border-radius: 50%;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: bold;
}

.permissions-header {
    display: flex;
    justify-content: between;
    align-items: center;
    margin-bottom: 20px;
}

.permissions-controls {
    display: flex;
    gap: 10px;
}

.permission-control-btn {
    background: #6c757d;
    color: white;
    border: none;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.3s ease;
}

.permission-control-btn:hover {
    background: #495057;
    transform: translateY(-1px);
}

.permission-control-btn.select-all {
    background: #28a745;
}

.permission-control-btn.select-all:hover {
    background: #218838;
}

.permission-control-btn.select-none {
    background: #dc3545;
}

.permission-control-btn.select-none:hover {
    background: #c82333;
}

.permissions-summary {
    background: linear-gradient(135deg, #e9ecef 0%, #dee2e6 100%);
    border-radius: 10px;
    padding: 15px;
    margin-top: 15px;
    text-align: center;
}

.selected-count {
    font-weight: bold;
    color: #1a4b8f;
    font-size: 1.1rem;
}

.settings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-top: 20px;
}

.setting-card {
    background: #f8f9fa;
    border: 2px solid #e9ecef;
    border-radius: 12px;
    padding: 20px;
    text-align: center;
    transition: all 0.3s ease;
}

.setting-card:hover {
    border-color: #1a4b8f;
    background: #f0f7ff;
}

.setting-icon {
    font-size: 2rem;
    margin-bottom: 10px;
    color: #1a4b8f;
}

.system-role-warning {
    background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
    border: 2px solid #ffc107;
    border-radius: 10px;
    padding: 15px;
    margin-top: 15px;
    display: none;
}

.system-role-warning.show {
    display: block;
}

.warning-icon {
    color: #856404;
    margin-right: 8px;
}

.form-actions {
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    border-radius: 15px;
    padding: 25px;
    margin-top: 30px;
    text-align: center;
    box-shadow: 0 2px 15px rgba(0,0,0,0.08);
}

.btn-primary-gradient {
    background: linear-gradient(135deg, #1a4b8f 0%, #2a5db3 100%);
    border: none;
    color: white;
    padding: 12px 30px;
    border-radius: 10px;
    font-weight: 600;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.btn-primary-gradient:hover {
    background: linear-gradient(135deg, #2a5db3 0%, #f18221 100%);
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(26, 75, 143, 0.4);
    color: white;
}

.btn-secondary-gradient {
    background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
    border: none;
    color: white;
    padding: 12px 30px;
    border-radius: 10px;
    font-weight: 600;
    transition: all 0.3s ease;
}

.btn-secondary-gradient:hover {
    background: linear-gradient(135deg, #495057 0%, #343a40 100%);
    transform: translateY(-2px);
    color: white;
}

.char-counter {
    font-size: 0.75rem;
    text-align: right;
    margin-top: 5px;
}
</style>

<div class="row">
    <!-- Left Column - Role Information -->
    <div class="col-lg-8">
        <!-- Basic Information Section -->
        <div class="form-section">
            <h4 class="section-title">
                <i class="fas fa-tag"></i>
                Role Information
            </h4>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="{{ form.name.vars.id }}">
                        <i class="fas fa-code"></i>
                        {{ form.name.vars.label }}
                        <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.name, {'attr': {'class': 'form-control role-name-input', 'onkeyup': 'updateRolePreview()'}}) }}
                    {{ form_errors(form.name) }}
                    {% if form.name.vars.help %}
                        <div class="form-text">{{ form.name.vars.help }}</div>
                    {% endif %}
                </div>
                
                <div class="col-md-6 mb-3">
                    <label for="{{ form.displayName.vars.id }}">
                        <i class="fas fa-tag"></i>
                        {{ form.displayName.vars.label }}
                        <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.displayName, {'attr': {'onkeyup': 'updateRolePreview()'}}) }}
                    {{ form_errors(form.displayName) }}
                    {% if form.displayName.vars.help %}
                        <div class="form-text">{{ form.displayName.vars.help }}</div>
                    {% endif %}
                </div>
            </div>
            
            <div class="mb-3">
                <label for="{{ form.description.vars.id }}">
                    <i class="fas fa-align-left"></i>
                    {{ form.description.vars.label }}
                </label>
                {{ form_widget(form.description, {'attr': {'onkeyup': 'updateCharCount(this, 1000); updateRolePreview()'}}) }}
                {{ form_errors(form.description) }}
                {% if form.description.vars.help %}
                    <div class="form-text">{{ form.description.vars.help }}</div>
                {% endif %}
            </div>
            
            <!-- Role Preview -->
            <div class="role-preview">
                <div class="role-preview-badge" id="rolePreviewBadge">
                    {{ form.displayName.vars.value ?: 'New Role' }}
                </div>
                <div class="text-muted" id="rolePreviewDescription">
                    {{ form.description.vars.value ?: 'Role description will appear here...' }}
                </div>
            </div>
        </div>

        <!-- Permissions Section -->
        <div class="form-section">
            <h4 class="section-title">
                <i class="fas fa-key"></i>
                Role Permissions
            </h4>
            
            <div class="permissions-header">
                <label>{{ form.permissions.vars.label }}</label>
                <div class="permissions-controls">
                    <button type="button" class="permission-control-btn select-all" onclick="selectAllPermissions()">
                        <i class="fas fa-check-double me-1"></i>Select All
                    </button>
                    <button type="button" class="permission-control-btn select-none" onclick="selectNoPermissions()">
                        <i class="fas fa-times me-1"></i>Select None
                    </button>
                </div>
            </div>
            
            <div class="permissions-container">
                <div class="permissions-grid">
                    {% for permission_choice in form.permissions %}
                        <div class="permission-card" onclick="togglePermissionSelection(this)">
                            {{ form_widget(permission_choice) }}
                            <div class="permission-name">{{ permission_choice.vars.label }}</div>
                            {% if permission_choice.vars.choice_attr.data_description is defined %}
                                <div class="permission-description">{{ permission_choice.vars.choice_attr.data_description }}</div>
                            {% endif %}
                            
                        </div>
                    {% endfor %}
                </div>
            </div>
            
            <div class="permissions-summary">
                <div class="selected-count" id="selectedCount">0</div>
                <div class="text-muted">permissions selected</div>
            </div>
            
            {{ form_errors(form.permissions) }}
            {% if form.permissions.vars.help %}
                <div class="form-text mt-2">{{ form.permissions.vars.help }}</div>
            {% endif %}
        </div>
    </div>
    
    <!-- Right Column - Settings -->
    <div class="col-lg-4">
        <!-- Role Settings Section -->
        <div class="form-section">
            <h4 class="section-title">
                <i class="fas fa-cog"></i>
                Role Settings
            </h4>
            
            <div class="mb-3">
                <label for="{{ form.displayOrder.vars.id }}">
                    <i class="fas fa-sort-numeric-down"></i>
                    {{ form.displayOrder.vars.label }}
                </label>
                {{ form_widget(form.displayOrder) }}
                {{ form_errors(form.displayOrder) }}
                {% if form.displayOrder.vars.help %}
                    <div class="form-text">{{ form.displayOrder.vars.help }}</div>
                {% endif %}
            </div>
            
            <div class="settings-grid">
                <div class="setting-card">
                    <div class="setting-icon">
                        <i class="fas fa-power-off"></i>
                    </div>
                    {{ form_widget(form.isActive) }}
                    <label for="{{ form.isActive.vars.id }}" class="mb-0">
                        {{ form.isActive.vars.label }}
                    </label>
                    {% if form.isActive.vars.help %}
                        <div class="form-text mt-2">{{ form.isActive.vars.help }}</div>
                    {% endif %}
                </div>
                
                <div class="setting-card">
                    <div class="setting-icon">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    {{ form_widget(form.isSystem, {'attr': {'onchange': 'toggleSystemRoleWarning(this)'}}) }}
                    <label for="{{ form.isSystem.vars.id }}" class="mb-0">
                        {{ form.isSystem.vars.label }}
                    </label>
                    {% if form.isSystem.vars.help %}
                        <div class="form-text mt-2 text-warning">{{ form.isSystem.vars.help }}</div>
                    {% endif %}
                </div>
            </div>
            
            <!-- System Role Warning -->
            <div class="system-role-warning" id="systemRoleWarning">
                <i class="fas fa-exclamation-triangle warning-icon"></i>
                <strong>System Role Warning:</strong><br>
                System roles are protected from deletion and cannot be modified by regular users. 
                Only enable this for critical system roles.
            </div>
        </div>
        
        <!-- Role Statistics (if editing) -->
        {% if role is defined and role.id %}
        <div class="form-section">
            <h4 class="section-title">
                <i class="fas fa-chart-bar"></i>
                Role Statistics
            </h4>
            
            <div class="settings-grid">
                <div class="setting-card">
                    <div class="setting-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="fw-bold">{{ role.usersCount }}</div>
                    <div class="text-muted">Users Assigned</div>
                </div>
                
                <div class="setting-card">
                    <div class="setting-icon">
                        <i class="fas fa-key"></i>
                    </div>
                    <div class="fw-bold" id="currentPermissionsCount">{{ role.permissionsCount }}</div>
                    <div class="text-muted">Permissions</div>
                </div>
            </div>
        </div>
        {% endif %}
    </div>
</div>

<!-- Form Actions -->
<div class="form-actions">
    <button type="submit" class="btn btn-primary-gradient me-3">
        <i class="fas fa-save me-2"></i>
        {{ button_label|default('Save Role') }}
    </button>
    <a href="{{ path('admin_role_index') }}" class="btn btn-secondary-gradient">
        <i class="fas fa-times me-2"></i>
        Cancel
    </a>
</div>

{{ form_end(form) }}

<script>
// Permission selection functionality
function togglePermissionSelection(element) {
    const checkbox = element.querySelector('input[type="checkbox"]');
    checkbox.checked = !checkbox.checked;
    
    if (checkbox.checked) {
        element.classList.add('selected');
    } else {
        element.classList.remove('selected');
    }
    
    updateSelectedCount();
}

function selectAllPermissions() {
    const checkboxes = document.querySelectorAll('.permission-card input[type="checkbox"]');
    const cards = document.querySelectorAll('.permission-card');
    
    checkboxes.forEach((checkbox, index) => {
        checkbox.checked = true;
        cards[index].classList.add('selected');
    });
    
    updateSelectedCount();
}

function selectNoPermissions() {
    const checkboxes = document.querySelectorAll('.permission-card input[type="checkbox"]');
    const cards = document.querySelectorAll('.permission-card');
    
    checkboxes.forEach((checkbox, index) => {
        checkbox.checked = false;
        cards[index].classList.remove('selected');
    });
    
    updateSelectedCount();
}

function updateSelectedCount() {
    const checkedBoxes = document.querySelectorAll('.permission-card input[type="checkbox"]:checked');
    const countElement = document.getElementById('selectedCount');
    const currentCountElement = document.getElementById('currentPermissionsCount');
    
    countElement.textContent = checkedBoxes.length;
    
    if (currentCountElement) {
        currentCountElement.textContent = checkedBoxes.length;
    }
}

// Role preview functionality
function updateRolePreview() {
    const roleName = document.getElementById('{{ form.name.vars.id }}').value;
    const displayName = document.getElementById('{{ form.displayName.vars.id }}').value;
    const description = document.getElementById('{{ form.description.vars.id }}').value;
    
    const badge = document.getElementById('rolePreviewBadge');
    const desc = document.getElementById('rolePreviewDescription');
    
    badge.textContent = displayName || roleName || 'New Role';
    desc.textContent = description || 'Role description will appear here...';
}

// System role warning
function toggleSystemRoleWarning(checkbox) {
    const warning = document.getElementById('systemRoleWarning');
    
    if (checkbox.checked) {
        warning.classList.add('show');
    } else {
        warning.classList.remove('show');
    }
}

// Character counter
function updateCharCount(element, maxLength) {
    const counter = element.parentNode.querySelector('.char-counter') || 
                   document.createElement('div');
    
    if (!element.parentNode.querySelector('.char-counter')) {
        counter.className = 'char-counter';
        element.parentNode.appendChild(counter);
    }
    
    const currentLength = element.value.length;
    counter.textContent = `${currentLength}/${maxLength} characters`;
    
    if (currentLength > maxLength * 0.9) {
        counter.style.color = '#dc3545';
    } else if (currentLength > maxLength * 0.7) {
        counter.style.color = '#ffc107';
    } else {
        counter.style.color = '#6c757d';
    }
}

// Initialize on page load
document.addEventListener('DOMContentLoaded', function() {
    // Initialize permission selections
    const permissionCards = document.querySelectorAll('.permission-card');
    permissionCards.forEach(card => {
        const checkbox = card.querySelector('input[type="checkbox"]');
        if (checkbox.checked) {
            card.classList.add('selected');
        }
        
        // Prevent double-toggle when clicking directly on checkbox
        checkbox.addEventListener('click', function(e) {
            e.stopPropagation();
            if (this.checked) {
                card.classList.add('selected');
            } else {
                card.classList.remove('selected');
            }
            updateSelectedCount();
        });
    });
    
    // Initialize count
    updateSelectedCount();
    
    // Initialize system role warning if needed
    const systemCheckbox = document.getElementById('{{ form.isSystem.vars.id }}');
    if (systemCheckbox && systemCheckbox.checked) {
        toggleSystemRoleWarning(systemCheckbox);
    }
    
    // Initialize role preview
    updateRolePreview();
});
</script>