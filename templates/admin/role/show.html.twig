<!-- templates/admin/role/show.html.twig -->
{% extends 'admin/base.html.twig' %}

{% block title %}{{ role.displayName }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>
        {{ role.displayName }}
        {% if role.isSystem %}
            <span class="badge bg-warning ms-2">System Role</span>
        {% endif %}
    </h1>
    <div>
        <a href="{{ path('admin_role_permissions', {'id': role.id}) }}" class="btn btn-primary">
            <i class="fas fa-key"></i> Manage Permissions
        </a>
        <a href="{{ path('admin_role_edit', {'id': role.id}) }}" class="btn btn-warning">
            <i class="fas fa-edit"></i> Edit
        </a>
        <a href="{{ path('admin_role_index') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Role Information</h5>
                <table class="table">
                    <tbody>
                        <tr>
                            <th style="width: 30%;">ID</th>
                            <td>{{ role.id }}</td>
                        </tr>
                        <tr>
                            <th>Role Name</th>
                            <td><code>{{ role.name }}</code></td>
                        </tr>
                        <tr>
                            <th>Display Name</th>
                            <td>{{ role.displayName }}</td>
                        </tr>
                        <tr>
                            <th>Description</th>
                            <td>{{ role.description ?: 'No description provided' }}</td>
                        </tr>
                        <tr>
                            <th>Type</th>
                            <td>
                                {% if role.isSystem %}
                                    <span class="badge bg-warning">System Role</span>
                                    <small class="text-muted ms-2">Protected from deletion</small>
                                {% else %}
                                    <span class="badge bg-info">Custom Role</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th>Status</th>
                            <td>
                                {% if role.isActive %}
                                    <span class="badge bg-success">Active</span>
                                {% else %}
                                    <span class="badge bg-danger">Inactive</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th>Assigned Users</th>
                            <td>
                                <span class="badge bg-secondary">{{ role.usersCount }}</span>
                                {% if role.usersCount > 0 %}
                                    <button type="button" class="btn btn-sm btn-outline-primary ms-2" 
                                            data-bs-toggle="modal" data-bs-target="#usersModal">
                                        View Users
                                    </button>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th>Permissions</th>
                            <td>
                                <span class="badge bg-primary">{{ role.permissionsCount }}</span>
                                <a href="{{ path('admin_role_permissions', {'id': role.id}) }}" 
                                   class="btn btn-sm btn-outline-primary ms-2">
                                    Manage Permissions
                                </a>
                            </td>
                        </tr>
                        <tr>
                            <th>Created</th>
                            <td>{{ role.createdAt|date('d/m/Y H:i:s') }}</td>
                        </tr>
                        <tr>
                            <th>Updated</th>
                            <td>{{ role.updatedAt|date('d/m/Y H:i:s') }}</td>
                        </tr>
                        <tr>
                            <th>Display Order</th>
                            <td>{{ role.displayOrder }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <!-- Role Permissions -->
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">
                    Permissions 
                    <span class="badge bg-primary">{{ role.permissions|length }}</span>
                </h5>
                {% if role.permissions|length > 0 %}
                    <div class="permissions-list" style="max-height: 300px; overflow-y: auto;">
                        {% for permission in role.permissions %}
                            <div class="d-flex justify-content-between align-items-center mb-2 p-2 border rounded">
                                <div>
                                    <strong>{{ permission.name }}</strong>
                                    {% if permission.description %}
                                        <br><small class="text-muted">{{ permission.description }}</small>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-muted mb-0">No permissions assigned</p>
                {% endif %}
                <div class="mt-3">
                    <a href="{{ path('admin_role_permissions', {'id': role.id}) }}" 
                       class="btn btn-primary w-100">
                        <i class="fas fa-key"></i> Manage Permissions
                    </a>
                </div>
            </div>
        </div>
        
        <!-- Quick Actions -->
        {% if not role.isSystem %}
        <div class="card mt-3">
            <div class="card-body">
                <h5 class="card-title">Quick Actions</h5>
                <div class="d-grid gap-2">
                    <form method="post" action="{{ path('admin_role_toggle_status', {'id': role.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ role.id) }}">
                        <button type="submit" class="btn btn-{{ role.isActive ? 'warning' : 'success' }} w-100">
                            <i class="fas fa-{{ role.isActive ? 'pause' : 'play' }}"></i> 
                            {{ role.isActive ? 'Deactivate' : 'Activate' }} Role
                        </button>
                    </form>
                    
                    {% if role.usersCount == 0 %}
                        <form method="post" action="{{ path('admin_role_delete', {'id': role.id}) }}" 
                              onsubmit="return confirm('Are you sure you want to delete this role?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ role.id) }}">
                            <button type="submit" class="btn btn-danger w-100">
                                <i class="fas fa-trash"></i> Delete Role
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endif %}
    </div>
</div>

<!-- Users Modal -->
{% if role.usersCount > 0 %}
<div class="modal fade" id="usersModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Users with {{ role.displayName }} Role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Email</th>
                                <th>Status</th>
                                <th>Last Login</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for user in role.users %}
                                <tr>
                                    <td>
                                        <strong>{{ user.fullName }}</strong><br>
                                        <small class="text-muted">@{{ user.username }}</small>
                                    </td>
                                    <td>{{ user.email }}</td>
                                    <td>
                                        {% if user.isActive %}
                                            <span class="badge bg-success">Active</span>
                                        {% else %}
                                            <span class="badge bg-danger">Inactive</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if user.lastLoginAt %}
                                            {{ user.lastLoginAt|date('d/m/Y') }}
                                        {% else %}
                                            <span class="text-muted">Never</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endif %}