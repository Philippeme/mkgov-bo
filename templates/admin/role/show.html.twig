{# templates/admin/role/show.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block title %}{{ role.label }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>
            <span class="badge bg-{{ role.badgeColor }} me-2">{{ role.label }}</span>
            {% if role.isSystem %}
                <span class="badge bg-secondary">System</span>
            {% endif %}
        </h1>
        <p class="text-muted mb-0">Role details and permissions</p>
    </div>
    <div class="d-flex gap-2">
        {% if not role.isSystem %}
            <a href="{{ path('admin_role_edit', {'id': role.id}) }}" class="btn btn-warning">
                <i class="fas fa-edit me-1"></i> Edit Role
            </a>
        {% endif %}
        <a href="{{ path('admin_role_permissions', {'id': role.id}) }}" class="btn btn-info">
            <i class="fas fa-key me-1"></i> Manage Permissions
        </a>
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="fas fa-cog me-1"></i> Actions
            </button>
            <ul class="dropdown-menu">
                <li>
                    <form method="post" action="{{ path('admin_role_clone', {'id': role.id}) }}" style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('clone' ~ role.id) }}">
                        <button type="submit" class="dropdown-item">
                            <i class="fas fa-copy me-2"></i> Clone Role
                        </button>
                    </form>
                </li>
                {% if not role.isSystem %}
                    <li>
                        <form method="post" action="{{ path('admin_role_toggle_status', {'id': role.id}) }}" style="display: inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle_status' ~ role.id) }}">
                            <button type="submit" class="dropdown-item">
                                <i class="fas fa-{{ role.isActive ? 'ban' : 'check' }} me-2"></i>
                                {{ role.isActive ? 'Deactivate' : 'Activate' }} Role
                            </button>
                        </form>
                    </li>
                    {% if role.usersCount == 0 %}
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form method="post" action="{{ path('admin_role_delete', {'id': role.id}) }}" 
                                  onsubmit="return confirm('Are you sure you want to delete this role? This action cannot be undone.');" style="display: inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ role.id) }}">
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="fas fa-trash me-2"></i> Delete Role
                                </button>
                            </form>
                        </li>
                    {% endif %}
                {% endif %}
            </ul>
        </div>
        <a href="{{ path('admin_role_index') }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to Roles
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <!-- Role Information -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-info-circle me-2"></i>Role Information
                </h5>
            </div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tr>
                        <td class="text-muted" style="width: 40%;">Name:</td>
                        <td><code>{{ role.name }}</code></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Label:</td>
                        <td><strong>{{ role.label }}</strong></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Status:</td>
                        <td>
                            {% if role.isActive %}
                                <span class="badge bg-success">Active</span>
                            {% else %}
                                <span class="badge bg-danger">Inactive</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">Type:</td>
                        <td>
                            {% if role.isSystem %}
                                <span class="badge bg-secondary">System Role</span>
                            {% else %}
                                <span class="badge bg-primary">Custom Role</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">Badge Color:</td>
                        <td><span class="badge bg-{{ role.badgeColor }}">{{ role.badgeColor|title }}</span></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Created:</td>
                        <td>{{ role.createdAt|date('d/m/Y H:i') }}</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Last Updated:</td>
                        <td>{{ role.updatedAt|date('d/m/Y H:i') }}</td>
                    </tr>
                </table>
                {% if role.description %}
                    <hr>
                    <h6 class="text-muted">Description:</h6>
                    <p>{{ role.description }}</p>
                {% endif %}
            </div>
        </div>

        <!-- Statistics -->
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-chart-bar me-2"></i>Statistics
                </h5>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-6">
                        <div class="border-end">
                            <h4 class="text-primary">{{ role.usersCount }}</h4>
                            <small class="text-muted">Users</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <h4 class="text-info">{{ role.permissionsCount }}</h4>
                        <small class="text-muted">Permissions</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <!-- Permissions -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                    <i class="fas fa-key me-2"></i>Permissions ({{ role.permissionsCount }})
                </h5>
                <a href="{{ path('admin_role_permissions', {'id': role.id}) }}" class="btn btn-outline-primary btn-sm">
                    <i class="fas fa-edit me-1"></i> Manage Permissions
                </a>
            </div>
            <div class="card-body">
                {% if role.permissions|length > 0 %}
                    {% set permissionsByCategory = {} %}
                    {% for permission in role.permissions %}
                        {% set category = permission.category %}
                        {% if permissionsByCategory[category] is not defined %}
                            {% set permissionsByCategory = permissionsByCategory|merge({(category): []}) %}
                        {% endif %}
                        {% set permissionsByCategory = permissionsByCategory|merge({(category): permissionsByCategory[category]|merge([permission])}) %}
                    {% endfor %}

                    {% for category, permissions in permissionsByCategory %}
                        <div class="mb-4">
                            <h6 class="text-primary border-bottom pb-2">{{ category|title|replace({'_': ' '}) }}</h6>
                            <div class="row">
                                {% for permission in permissions %}
                                    <div class="col-md-6 mb-2">
                                        <div class="d-flex align-items-center">
                                            <span class="badge {{ permission.badgeClass }} me-2">{{ permission.action|default('general') }}</span>
                                            <span>{{ permission.label }}</span>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="text-center py-4">
                        <i class="fas fa-key fa-3x text-muted mb-3"></i>
                        <h6 class="text-muted">No permissions assigned</h6>
                        <p class="text-muted">This role has no permissions assigned to it.</p>
                        <a href="{{ path('admin_role_permissions', {'id': role.id}) }}" class="btn btn-primary">
                            <i class="fas fa-plus me-1"></i> Add Permissions
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Users with this role -->
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-users me-2"></i>Users with this Role ({{ role.usersCount }})
                </h5>
            </div>
            <div class="card-body">
                {% if role.users|length > 0 %}
                    <div class="row">
                        {% for user in role.users %}
                            <div class="col-md-6 mb-3">
                                <div class="card border">
                                    <div class="card-body py-2">
                                        <div class="d-flex align-items-center">
                                            <div class="me-3">
                                                {% if user.avatar %}
                                                    <img src="{{ asset('uploads/avatars/' ~ user.avatar) }}" alt="{{ user.fullName }}" class="rounded-circle" width="40" height="40">
                                                {% else %}
                                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; font-weight: bold; font-size: 14px;">
                                                        {{ user.initials }}
                                                    </div>
                                                {% endif %}
                                            </div>
                                            <div class="flex-grow-1">
                                                <h6 class="mb-0">{{ user.fullName }}</h6>
                                                <small class="text-muted">@{{ user.username }}</small>
                                                {% if not user.isActive %}
                                                    <span class="badge bg-danger">Inactive</span>
                                                {% endif %}
                                            </div>
                                            <div>
                                                <a href="{{ path('admin_user_show', {'id': user.id}) }}" class="btn btn-outline-primary btn-sm">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center py-4">
                        <i class="fas fa-users fa-3x text-muted mb-3"></i>
                        <h6 class="text-muted">No users assigned</h6>
                        <p class="text-muted">No users currently have this role assigned.</p>
                        <a href="{{ path('admin_user_index') }}" class="btn btn-primary">
                            <i class="fas fa-plus me-1"></i> Assign Users
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}