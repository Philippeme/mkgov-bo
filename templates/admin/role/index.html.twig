{# templates/admin/role/index.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block title %}Roles Management{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1><i class="fas fa-shield-alt me-2"></i>Roles Management</h1>
        <p class="text-muted mb-0">Manage user roles and their permissions</p>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_role_new') }}" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> New Role
        </a>
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="fas fa-download me-1"></i> Export
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="#"><i class="fas fa-file-csv me-2"></i>Export as CSV</a></li>
                <li><a class="dropdown-item" href="#"><i class="fas fa-file-excel me-2"></i>Export as Excel</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title text-white-50">Total Roles</h6>
                        <h3 class="mb-0">{{ statistics.total }}</h3>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-shield-alt fa-2x text-white-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title text-white-50">Active Roles</h6>
                        <h3 class="mb-0">{{ statistics.active }}</h3>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-check-circle fa-2x text-white-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title text-white-50">System Roles</h6>
                        <h3 class="mb-0">{{ statistics.system }}</h3>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-cog fa-2x text-white-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title text-white-50">Custom Roles</h6>
                        <h3 class="mb-0">{{ statistics.custom }}</h3>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-user-edit fa-2x text-white-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-5">
                <label for="search" class="form-label">Search</label>
                <input type="text" class="form-control" id="search" name="search" 
                       value="{{ filters.search ?? '' }}" placeholder="Search by name, label or description">
            </div>
            <div class="col-md-3">
                <label for="active" class="form-label">Status</label>
                <select class="form-select" id="active" name="active">
                    <option value="">All Status</option>
                    <option value="1" {{ filters.active == true ? 'selected' : '' }}>Active</option>
                    <option value="0" {{ filters.active == false ? 'selected' : '' }}>Inactive</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="system" class="form-label">Type</label>
                <select class="form-select" id="system" name="system">
                    <option value="">All Types</option>
                    <option value="1" {{ filters.system == true ? 'selected' : '' }}>System</option>
                    <option value="0" {{ filters.system == false ? 'selected' : '' }}>Custom</option>
                </select>
            </div>
            <div class="col-md-1">
                <label class="form-label">&nbsp;</label>
                <div class="d-flex gap-1">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search"></i>
                    </button>
                    <a href="{{ path('admin_role_index') }}" class="btn btn-outline-secondary">
                        <i class="fas fa-times"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Most Used Roles -->
{% if most_used|length > 0 %}
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Most Used Roles</h5>
        </div>
        <div class="card-body">
            <div class="row">
                {% for item in most_used %}
                    {% set role = item[0] %}
                    {% set userCount = item.userCount %}
                    <div class="col-md-2 text-center mb-3">
                        <div class="card border">
                            <div class="card-body py-3">
                                <span class="badge bg-{{ role.badgeColor }} mb-2">{{ role.label }}</span>
                                <h5 class="mb-0">{{ userCount }}</h5>
                                <small class="text-muted">users</small>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endif %}

<!-- Roles Table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Roles List</h5>
        <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#bulkActionModal">
            <i class="fas fa-tasks me-1"></i> Bulk Actions
        </button>
    </div>
    <div class="card-body p-0">
        {% if roles %}
            <form id="rolesForm">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th width="50">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="selectAll">
                                    </div>
                                </th>
                                <th>Role</th>
                                <th>Description</th>
                                <th>Users</th>
                                <th>Permissions</th>
                                <th>Status</th>
                                <th width="150">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for role in roles %}
                            <tr>
                                <td>
                                    <div class="form-check">
                                        <input class="form-check-input role-checkbox" type="checkbox" name="roles[]" value="{{ role.id }}"
                                               {{ role.isSystem ? 'disabled title="System roles cannot be bulk-edited"' : '' }}>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <span class="badge bg-{{ role.badgeColor }} me-2">{{ role.label }}</span>
                                        <div>
                                            <div class="fw-semibold">{{ role.label }}</div>
                                            <small class="text-muted font-monospace">{{ role.name }}</small>
                                        </div>
                                        {% if role.isSystem %}
                                            <span class="badge bg-secondary ms-2">System</span>
                                        {% endif %}
                                    </div>
                                </td>
                                <td>
                                    {% if role.description %}
                                        <span class="text-truncate d-inline-block" style="max-width: 200px;" title="{{ role.description }}">
                                            {{ role.description }}
                                        </span>
                                    {% else %}
                                        <span class="text-muted">No description</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark">{{ role.usersCount }} users</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark">{{ role.permissionsCount }} permissions</span>
                                </td>
                                <td>
                                    {% if role.isActive %}
                                        <span class="badge bg-success">Active</span>
                                    {% else %}
                                        <span class="badge bg-danger">Inactive</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="{{ path('admin_role_show', {'id': role.id}) }}" class="btn btn-outline-info" title="View">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        {% if not role.isSystem %}
                                            <a href="{{ path('admin_role_edit', {'id': role.id}) }}" class="btn btn-outline-warning" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        {% endif %}
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" title="More actions">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <a href="{{ path('admin_role_permissions', {'id': role.id}) }}" class="dropdown-item">
                                                        <i class="fas fa-key me-2"></i> Manage Permissions
                                                    </a>
                                                </li>
                                                <li>
                                                    <form method="post" action="{{ path('admin_role_clone', {'id': role.id}) }}" style="display: inline;">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('clone' ~ role.id) }}">
                                                        <button type="submit" class="dropdown-item">
                                                            <i class="fas fa-copy me-2"></i> Clone Role
                                                        </button>
                                                    </form>
                                                </li>
                                                {% if not role.isSystem %}
                                                    <li>
                                                        <form method="post" action="{{ path('admin_role_toggle_status', {'id': role.id}) }}" style="display: inline;">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('toggle_status' ~ role.id) }}">
                                                            <button type="submit" class="dropdown-item">
                                                                <i class="fas fa-{{ role.isActive ? 'ban' : 'check' }} me-2"></i>
                                                                {{ role.isActive ? 'Deactivate' : 'Activate' }}
                                                            </button>
                                                        </form>
                                                    </li>
                                                    {% if role.usersCount == 0 %}
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li>
                                                            <form method="post" action="{{ path('admin_role_delete', {'id': role.id}) }}" 
                                                                  onsubmit="return confirm('Are you sure you want to delete this role?');" style="display: inline;">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ role.id) }}">
                                                                <button type="submit" class="dropdown-item text-danger">
                                                                    <i class="fas fa-trash me-2"></i> Delete
                                                                </button>
                                                            </form>
                                                        </li>
                                                    {% endif %}
                                                {% endif %}
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </form>
        {% else %}
            <div class="text-center py-5">
                <i class="fas fa-shield-alt fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">No roles found</h5>
                <p class="text-muted">Start by creating your first role.</p>
                <a href="{{ path('admin_role_new') }}" class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i> Create Role
                </a>
            </div>
        {% endif %}
    </div>
</div>

<!-- Bulk Action Modal -->
<div class="modal fade" id="bulkActionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bulk Actions</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="{{ path('admin_role_bulk_action') }}">
                <div class="modal-body">
                    <p>Select an action to apply to the selected roles:</p>
                    <div class="mb-3">
                        <select name="action" class="form-select" required>
                            <option value="">Choose an action...</option>
                            <option value="activate">Activate</option>
                            <option value="deactivate">Deactivate</option>
                            <option value="delete">Delete (only roles without users)</option>
                        </select>
                    </div>
                    <div id="selectedRolesCount" class="text-info">
                        <i class="fas fa-info-circle me-1"></i> No roles selected
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Apply Action</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const selectAllCheckbox = document.getElementById('selectAll');
    const roleCheckboxes = document.querySelectorAll('.role-checkbox:not(:disabled)');
    const selectedCountElement = document.getElementById('selectedRolesCount');
    const bulkActionModal = document.getElementById('bulkActionModal');

    // Select all functionality
    selectAllCheckbox.addEventListener('change', function() {
        roleCheckboxes.forEach(checkbox => {
            checkbox.checked = this.checked;
        });
        updateSelectedCount();
    });

    // Individual checkbox change
    roleCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', function() {
            updateSelectAllState();
            updateSelectedCount();
        });
    });

    function updateSelectAllState() {
        const checkedBoxes = document.querySelectorAll('.role-checkbox:checked');
        selectAllCheckbox.checked = checkedBoxes.length === roleCheckboxes.length;
        selectAllCheckbox.indeterminate = checkedBoxes.length > 0 && checkedBoxes.length < roleCheckboxes.length;
    }

    function updateSelectedCount() {
        const checkedBoxes = document.querySelectorAll('.role-checkbox:checked');
        const count = checkedBoxes.length;
        
        if (count === 0) {
            selectedCountElement.innerHTML = '<i class="fas fa-info-circle me-1"></i> No roles selected';
            selectedCountElement.className = 'text-info';
        } else {
            selectedCountElement.innerHTML = `<i class="fas fa-check-circle me-1"></i> ${count} role${count > 1 ? 's' : ''} selected`;
            selectedCountElement.className = 'text-success';
        }
    }

    // Copy selected role IDs to bulk action form
    bulkActionModal.addEventListener('show.bs.modal', function() {
        const checkedBoxes = document.querySelectorAll('.role-checkbox:checked');
        const form = bulkActionModal.querySelector('form');
        
        // Remove existing hidden inputs
        form.querySelectorAll('input[name="roles[]"]').forEach(input => input.remove());
        
        // Add selected role IDs
        checkedBoxes.forEach(checkbox => {
            const hiddenInput = document.createElement('input');
            hiddenInput.type = 'hidden';
            hiddenInput.name = 'roles[]';
            hiddenInput.value = checkbox.value;
            form.appendChild(hiddenInput);
        });
    });
});
</script>
{% endblock %}