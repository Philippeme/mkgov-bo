{% extends 'admin/base.html.twig' %}

{% block title %}Role Management{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0"><i class="bi-shield-check me-2"></i>Role Management</h1>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_role_new') }}" class="btn btn-primary">
            <i class="fas fa-plus"></i> New Role
        </a>
        <form method="post" action="{{ path('admin_role_create_defaults') }}" style="display: inline;">
            <input type="hidden" name="_token" value="{{ csrf_token('create_defaults') }}">
            <button type="submit" class="btn btn-outline-info" 
                    onclick="return confirm('Create default system roles?');">
                <i class="fas fa-cogs"></i> Create Default Roles
            </button>
        </form>
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="fas fa-download"></i> Export
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="#"><i class="fas fa-file-csv me-2"></i>Export CSV</a></li>
                <li><a class="dropdown-item" href="#"><i class="fas fa-file-excel me-2"></i>Export Excel</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h5 class="card-title">Total Roles</h5>
                        <h3 class="mb-0">{{ statistics.total }}</h3>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-user-tag fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h5 class="card-title">Active Roles</h5>
                        <h3 class="mb-0">{{ statistics.active }}</h3>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-check-circle fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h5 class="card-title">System Roles</h5>
                        <h3 class="mb-0">{{ statistics.system }}</h3>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-shield-alt fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h5 class="card-title">Custom Roles</h5>
                        <h3 class="mb-0">{{ statistics.custom }}</h3>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-user-cog fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body">
        <form method="GET" class="row g-3">
            <div class="col-md-4">
                <label for="search" class="form-label">Search</label>
                <input type="text" class="form-control" id="search" name="search" 
                       value="{{ filters.search }}" placeholder="Search roles...">
            </div>
            <div class="col-md-3">
                <label for="system" class="form-label">Role Type</label>
                <select class="form-select" id="system" name="system">
                    <option value="">All Types</option>
                    <option value="1" {{ filters.system == '1' ? 'selected' : '' }}>System Roles</option>
                    <option value="0" {{ filters.system == '0' ? 'selected' : '' }}>Custom Roles</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="permission" class="form-label">Has Permission</label>
                <input type="text" class="form-control" id="permission" name="permission" 
                       value="{{ filters.permission }}" placeholder="Permission name...">
            </div>
            <div class="col-md-2">
                <label class="form-label">&nbsp;</label>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="fas fa-search"></i> Filter
                    </button>
                    <a href="{{ path('admin_role_index') }}" class="btn btn-outline-secondary">
                        <i class="fas fa-times"></i> Clear
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Roles Table -->
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Role</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Type</th>
                        <th>Users</th>
                        <th>Permissions</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for role in roles %}
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="role-icon me-2">
                                    {% if role.isSystem %}
                                        <i class="fas fa-shield-alt text-warning" title="System Role"></i>
                                    {% else %}
                                        <i class="fas fa-user-tag text-primary" title="Custom Role"></i>
                                    {% endif %}
                                </div>
                                <div>
                                    <strong>{{ role.displayName }}</strong><br>
                                    <small class="text-muted">{{ role.name }}</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <code class="text-dark">{{ role.name }}</code>
                        </td>
                        <td>
                            <span title="{{ role.description }}">
                                {{ role.description|length > 50 ? role.description|slice(0, 50) ~ '...' : role.description }}
                            </span>
                        </td>
                        <td>
                            {% if role.isSystem %}
                                <span class="badge bg-warning">System</span>
                            {% else %}
                                <span class="badge bg-info">Custom</span>
                            {% endif %}
                        </td>
                        <td>
                            <span class="badge bg-secondary">{{ role.usersCount }}</span>
                            {% if role.usersCount > 0 %}
                                <small class="text-muted">users</small>
                            {% endif %}
                        </td>
                        <td>
                            <span class="badge bg-primary">{{ role.permissionsCount }}</span>
                            {% if role.permissionsCount > 0 %}
                                <small class="text-muted">permissions</small>
                            {% endif %}
                        </td>
                        <td>
                            {% if role.isActive %}
                                <span class="badge bg-success">Active</span>
                            {% else %}
                                <span class="badge bg-danger">Inactive</span>
                            {% endif %}
                        </td>
                        <td>
                            <span title="{{ role.createdAt|date('d/m/Y H:i:s') }}">
                                {{ role.createdAt|date('d/m/Y') }}
                            </span>
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm" role="group">
                                <a href="{{ path('admin_role_show', {'id': role.id}) }}" 
                                   class="btn btn-outline-info" title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('admin_role_edit', {'id': role.id}) }}" 
                                   class="btn btn-outline-warning" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="{{ path('admin_role_permissions', {'id': role.id}) }}" 
                                   class="btn btn-outline-primary" title="Manage Permissions">
                                    <i class="fas fa-key"></i>
                                </a>
                                
                                <!-- Status Toggle -->
                                {% if not role.isSystem %}
                                    <form method="post" action="{{ path('admin_role_toggle_status', {'id': role.id}) }}" 
                                          style="display: inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ role.id) }}">
                                        <button type="submit" 
                                                class="btn btn-outline-{{ role.isActive ? 'warning' : 'success' }}" 
                                                title="{{ role.isActive ? 'Deactivate' : 'Activate' }}">
                                            <i class="fas fa-{{ role.isActive ? 'pause' : 'play' }}"></i>
                                        </button>
                                    </form>
                                    
                                    <!-- Delete Button -->
                                    {% if role.usersCount == 0 %}
                                        <form method="post" action="{{ path('admin_role_delete', {'id': role.id}) }}" 
                                              onsubmit="return confirm('Are you sure you want to delete this role?');" 
                                              style="display: inline;">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ role.id) }}">
                                            <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    {% endif %}
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">
                            <i class="fas fa-user-tag fa-3x mb-3"></i><br>
                            No roles found
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}