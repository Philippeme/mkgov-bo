!-- templates/admin/role/permissions.html.twig -->
{% extends 'admin/base.html.twig' %}

{% block title %}Manage Permissions - {{ role.displayName }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Manage Permissions: {{ role.displayName }}</h1>
    <div>
        <a href="{{ path('admin_role_show', {'id': role.id}) }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Role
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Available Permissions</h5>
                <form method="post">
                    <input type="hidden" name="_token" value="{{ csrf_token('permissions' ~ role.id) }}">
                    
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span>Select permissions for this role:</span>
                            <div>
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="selectAll()">
                                    Select All
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectNone()">
                                    Select None
                                </button>
                            </div>
                        </div>
                        
                        <div class="permissions-grid" style="max-height: 400px; overflow-y: auto;">
                            {% for permission in all_permissions %}
                                <div class="form-check mb-2 p-2 border rounded">
                                    <input class="form-check-input" type="checkbox" 
                                           name="permissions[]" 
                                           value="{{ permission.id }}" 
                                           id="permission_{{ permission.id }}"
                                           {% if permission in role.permissions %}checked{% endif %}>
                                    <label class="form-check-label w-100" for="permission_{{ permission.id }}">
                                        <strong>{{ permission.name }}</strong>
                                        {% if permission.description %}
                                            <br><small class="text-muted">{{ permission.description }}</small>
                                        {% endif %}
                                    </label>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                    
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Save Permissions
                        </button>
                        <a href="{{ path('admin_role_show', {'id': role.id}) }}" class="btn btn-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Role Summary</h5>
                <table class="table table-sm">
                    <tr>
                        <th>Role:</th>
                        <td>{{ role.displayName }}</td>
                    </tr>
                    <tr>
                        <th>Name:</th>
                        <td><code>{{ role.name }}</code></td>
                    </tr>
                    <tr>
                        <th>Type:</th>
                        <td>
                            {% if role.isSystem %}
                                <span class="badge bg-warning">System</span>
                            {% else %}
                                <span class="badge bg-info">Custom</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>Users:</th>
                        <td>{{ role.usersCount }}</td>
                    </tr>
                    <tr>
                        <th>Current Permissions:</th>
                        <td id="current-count">{{ role.permissionsCount }}</td>
                    </tr>
                </table>
            </div>
        </div>
        
        <div class="card mt-3">
            <div class="card-body">
                <h6 class="card-title">Current Permissions</h6>
                <div id="current-permissions" style="max-height: 200px; overflow-y: auto;">
                    {% for permission in role.permissions %}
                        <span class="badge bg-primary me-1 mb-1">{{ permission.name }}</span>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function selectAll() {
    document.querySelectorAll('input[name="permissions[]"]').forEach(checkbox => {
        checkbox.checked = true;
    });
    updateCount();
}

function selectNone() {
    document.querySelectorAll('input[name="permissions[]"]').forEach(checkbox => {
        checkbox.checked = false;
    });
    updateCount();
}

function updateCount() {
    const checked = document.querySelectorAll('input[name="permissions[]"]:checked').length;
    document.getElementById('current-count').textContent = checked;
}

// Add event listeners to checkboxes
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('input[name="permissions[]"]').forEach(checkbox => {
        checkbox.addEventListener('change', updateCount);
    });
});
</script>
{% endblock %}