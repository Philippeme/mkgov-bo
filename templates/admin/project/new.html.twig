                "linkTypes.repo": "Repository",
                "linkTypes.website": "Website",
                "linkTypes.other": "Other",
                "navigation.previous": "Previous",
                "navigation.next": "Next",
                "navigation.skip": "Skip this step",
                "navigation.submit": "Save project"
            }
        };

        // ========== VARIABLES GLOBALES ==========
        let currentStep = 1;
        let currentLang = 'fr';
        let memberIndex = 1;
        let linkIndex = 1;
        let uploadedFiles = [];

        // ========== INITIALISATION ==========
        document.addEventListener('DOMContentLoaded', function() {
            initializeForm();
            setupEventListeners();
            setupFileUpload();
            initializeSearchableSelects();
            updateNavigationButtons();
        });

        function initializeForm() {
            // Initialiser la langue
            const savedLang = localStorage.getItem('mkba_lang') || 'fr';
            setLanguage(savedLang);
        }

        // ========== GESTION DES ÉTAPES ==========
        function goToStep(step) {
            // Validation de l'étape actuelle avant de passer à la suivante
            if (step > currentStep && !validateCurrentStep()) {
                return false;
            }

            // Masquer l'étape actuelle
            document.querySelector(`[data-step-content="${currentStep}"]`).classList.remove('active');
            document.querySelector(`[data-step="${currentStep}"]`).classList.remove('active');
            
            // Si on passe une étape complétée
            if (step > currentStep) {
                document.querySelector(`[data-step="${currentStep}"]`).classList.add('completed');
            }

            // Afficher la nouvelle étape
            currentStep = step;
            document.querySelector(`[data-step-content="${currentStep}"]`).classList.add('active');
            document.querySelector(`[data-step="${currentStep}"]`).classList.add('active');

            // Activer les boutons de navigation des étapes
            for (let i = 1; i <= currentStep; i++) {
                document.querySelector(`[data-step-btn="${i}"]`).disabled = false;
            }

            // Mettre à jour la barre de progression
            updateProgress();
            
            // Mettre à jour les boutons de navigation
            updateNavigationButtons();

            // Scroll vers le haut
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function updateProgress() {
            const percent = (currentStep / 4) * 100;
            document.querySelector('.progress-bar').style.width = percent + '%';
            document.getElementById('currentStep').textContent = currentStep;
            document.getElementById('progressPercent').textContent = Math.round(percent);
        }

        function updateNavigationButtons() {
            const btnPrev = document.getElementById('btnPrev');
            const btnNext = document.getElementById('btnNext');
            const btnSkip = document.getElementById('btnSkip');
            const btnSubmit = document.getElementById('btnSubmit');

            // Bouton précédent
            btnPrev.style.display = currentStep > 1 ? 'inline-flex' : 'none';

            // Boutons suivant et passer
            if (currentStep === 1) {
                btnNext.style.display = 'inline-flex';
                btnSkip.style.display = 'none';
                btnSubmit.style.display = 'none';
            } else if (currentStep === 4) {
                btnNext.style.display = 'none';
                btnSkip.style.display = 'none';
                btnSubmit.style.display = 'inline-flex';
            } else {
                btnNext.style.display = 'inline-flex';
                btnSkip.style.display = 'inline-flex';
                btnSubmit.style.display = 'none';
            }
        }

        function validateCurrentStep() {
            if (currentStep === 1) {
                // Validation des champs obligatoires de l'étape 1
                const requiredFields = document.querySelectorAll('[data-step-content="1"] [required]');
                let isValid = true;
                
                requiredFields.forEach(field => {
                    if (!field.value.trim()) {
                        field.classList.add('is-invalid');
                        isValid = false;
                    } else {
                        field.classList.remove('is-invalid');
                    }
                });

                if (!isValid) {
                    showNotification('Veuillez remplir tous les champs obligatoires', 'error');
                    return false;
                }
            }

            return true;
        }

        // ========== EVENT LISTENERS ==========
        function setupEventListeners() {
            // Navigation par boutons
            document.getElementById('btnNext').addEventListener('click', () => goToStep(currentStep + 1));
            document.getElementById('btnPrev').addEventListener('click', () => goToStep(currentStep - 1));
            document.getElementById('btnSkip').addEventListener('click', () => goToStep(currentStep + 1));

            // Navigation par étapes
            document.querySelectorAll('[data-step-btn]').forEach(btn => {
                btn.addEventListener('click', function() {
                    const step = parseInt(this.dataset.stepBtn);
                    if (!this.disabled) {
                        goToStep(step);
                    }
                });
            });

            // Switch de langue
            document.querySelectorAll('.lang-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const lang = this.dataset.lang;
                    setLanguage(lang);
                });
            });

            // Soumission du formulaire
            document.getElementById('projectForm').addEventListener('submit', handleFormSubmit);
        }

        // ========== GESTION DE LA LANGUE ==========
        function setLanguage(lang) {
            currentLang = lang;
            localStorage.setItem('mkba_lang', lang);

            // Mettre à jour les boutons de langue
            document.querySelectorAll('.lang-btn').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.lang === lang);
            });

            // Traduire tous les éléments
            document.querySelectorAll('[data-i18n]').forEach(element => {
                const key = element.dataset.i18n;
                if (translations[lang][key]) {
                    // Gérer les éléments avec enfants (comme les spans avec numéros)
                    if (element.childElementCount > 0 && element.querySelector('#currentStep')) {
                        const stepNum = element.querySelector('#currentStep').textContent;
                        element.innerHTML = translations[lang][key].replace('<span id="currentStep">1</span>', `<span id="currentStep">${stepNum}</span>`);
                    } else {
                        element.textContent = translations[lang][key];
                    }
                }
            });
        }

        // ========== GESTION DES COLLECTIONS ==========
        function addMember() {
            const collection = document.getElementById('membersCollection');
            const newItem = document.createElement('div');
            newItem.className = 'collection-item';
            newItem.innerHTML = `
                <button type="button" class="btn-remove-item" onclick="removeMember(this)">
                    <i class="bi-trash"></i>
                </button>
                <div class="row">
                    <div class="col-md-4">
                        <label class="form-label" data-i18n="fields.memberName">${translations[currentLang]['fields.memberName']}</label>
                        <input type="text" class="form-control" name="members[${memberIndex}][name]">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" data-i18n="fields.memberEmail">${translations[currentLang]['fields.memberEmail']}</label>
                        <input type="email" class="form-control" name="members[${memberIndex}][email]">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" data-i18n="fields.memberRole">${translations[currentLang]['fields.memberRole']}</label>
                        <select class="form-select" name="members[${memberIndex}][role]">
                            <option value="developer">${translations[currentLang]['roles.developer']}</option>
                            <option value="designer">${translations[currentLang]['roles.designer']}</option>
                            <option value="manager">${translations[currentLang]['roles.manager']}</option>
                            <option value="analyst">${translations[currentLang]['roles.analyst']}</option>
                            <option value="tester">${translations[currentLang]['roles.tester']}</option>
                        </select>
                    </div>
                </div>
            `;
            collection.appendChild(newItem);
            memberIndex++;
        }

        function removeMember(button) {
            button.closest('.collection-item').remove();
        }

        function addLink() {
            const collection = document.getElementById('linksCollection');
            const newItem = document.createElement('div');
            newItem.className = 'collection-item';
            newItem.innerHTML = `
                <button type="button" class="btn-remove-item" onclick="removeLink(this)">
                    <i class="bi-trash"></i>
                </button>
                <div class="row">
                    <div class="col-md-4">
                        <label class="form-label" data-i18n="fields.linkTitle">${translations[currentLang]['fields.linkTitle']}</label>
                        <input type="text" class="form-control" name="links[${linkIndex}][title]">
                    </div>
                    <div class="col-md-5">
                        <label class="form-label" data-i18n="fields.linkUrl">${translations[currentLang]['fields.linkUrl']}</label>
                        <input type="url" class="form-control" name="links[${linkIndex}][url]" placeholder="https://">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" data-i18n="fields.linkType">${translations[currentLang]['fields.linkType']}</label>
                        <select class="form-select" name="links[${linkIndex}][type]">
                            <option value="documentation">${translations[currentLang]['linkTypes.doc']}</option>
                            <option value="repository">${translations[currentLang]['linkTypes.repo']}</option>
                            <option value="website">${translations[currentLang]['linkTypes.website']}</option>
                            <option value="other">${translations[currentLang]['linkTypes.other']}</option>
                        </select>
                    </div>
                </div>
            `;
            collection.appendChild(newItem);
            linkIndex++;
        }

        function removeLink(button) {
            button.closest('.collection-item').remove();
        }

        // ========== GESTION DES FICHIERS ==========
        function setupFileUpload() {
            const fileUploadArea = document.getElementById('fileUploadArea');
            const fileInput = document.getElementById('fileInput');

            // Drag & Drop
            fileUploadArea.addEventListener('dragover', (e) => {
                e.preventDefault();
                fileUploadArea.classList.add('dragover');
            });

            fileUploadArea.addEventListener('dragleave', () => {
                fileUploadArea.classList.remove('dragover');
            });

            fileUploadArea.addEventListener('drop', (e) => {
                e.preventDefault();
                fileUploadArea.classList.remove('dragover');
                handleFiles(e.dataTransfer.files);
            });

            // Input file
            fileInput.addEventListener('change', (e) => {
                handleFiles(e.target.files);
            });
        }

        function handleFiles(files) {
            Array.from(files).forEach(file => {
                if (file.size > 10 * 1024 * 1024) {
                    showNotification(`Le fichier ${file.name} dépasse 10MB`, 'error');
                    return;
                }
                uploadedFiles.push(file);
                displayFile(file);
            });
        }

        function displayFile(file) {
            const filesList = document.getElementById('filesList');
            const fileItem = document.createElement('div');
            fileItem.className = 'file-item';
            fileItem.innerHTML = `
                <div class="file-info">
                    <i class="bi-file-earmark file-icon"></i>
                    <div class="file-details">
                        <div class="file-name">${file.name}</div>
                        <div class="file-size">${formatFileSize(file.size)}</div>
                    </div>
                </div>
                <button type="button" class="btn-remove-item" onclick="removeFile(this, '${file.name}')">
                    <i class="bi-trash"></i>
                </button>
            `;
            filesList.appendChild(fileItem);
        }

        function removeFile(button, fileName) {
            uploadedFiles = uploadedFiles.filter(f => f.name !== fileName);
            button.closest('.file-item').remove();
        }

        function formatFileSize(bytes) {
            if (bytes === 0) return '0 B';
            const k = 1024;
            const sizes = ['B', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }

        // ========== SELECT2 ==========
        function initializeSearchableSelects() {
            $('.searchable-select').select2({
                placeholder: function() {
                    return $(this).data('placeholder') || '';
                },
                allowClear: true,
                width: '100%'
            });
        }

        // ========== SOUMISSION DU FORMULAIRE ==========
        function handleFormSubmit(e) {
            e.preventDefault();
            
            if (!validateCurrentStep()) {
                return false;
            }

            // Collecter toutes les données
            const formData = new FormData(e.target);
            
            // Ajouter les fichiers
            uploadedFiles.forEach(file => {
                formData.append('files[]', file);
            });

            showNotification('Projet enregistré avec succès!', 'success');
            
            // Redirection après succès
            setTimeout(() => {
                window.location.href = '{{ path("admin_document_index") }}';
            }, 2000);
        }

        // ========== NOTIFICATIONS ==========
        function showNotification(message, type = 'info') {
            const alertClass = type === 'error' ? 'danger' : type;
            const alertHtml = `
                <div class="alert alert-${alertClass} alert-dismissible fade show position-fixed" 
                     style="top: 20px; right: 20px; z-index: 9999; min-width: 300px;" role="alert">
                    <i class="bi-${type === 'success' ? 'check-circle' : 'exclamation-triangle'} me-2"></i>
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            
            document.body.insertAdjacentHTML('beforeend', alertHtml);
            
            setTimeout(() => {
                const alert = document.querySelector('.alert:last-of-type');
                if (alert) {
                    alert.remove();
                }
            }, 3000);
        }
    </script>
{% endblock %}