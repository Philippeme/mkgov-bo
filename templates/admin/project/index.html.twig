{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des projets{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Gestion des projets</h1>
    <a href="{{ path('admin_project_new') }}" class="btn btn-primary">
        <i class="fas fa-plus"></i> Nouveau projet
    </a>
</div>

<div class="card">
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Image</th>
                    <th>Titre</th>
                    <th>Catégorie</th>
                    <th>Statut</th>
                    <th>Ordre</th>
                    <th>Date création</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for project in projects %}
                <tr>
                    <td>{{ project.id }}</td>
                    <td>
                        {% if project.image %}
                            <img src="{{ asset('uploads/projects/' ~ project.image) }}" alt="{{ project.title }}" style="height: 50px;">
                        {% else %}
                            <span class="text-muted">Pas d'image</span>
                        {% endif %}
                    </td>
                    <td>{{ project.title }}</td>
                    <td>{{ project.category }}</td>
                    <td>
                        {% if project.published %}
                            <span class="badge bg-success">Publié</span>
                        {% else %}
                            <span class="badge bg-secondary">Brouillon</span>
                        {% endif %}
                        {% if project.featured %}
                            <span class="badge bg-warning">En vedette</span>
                        {% endif %}
                    </td>
                    <td>{{ project.displayOrder }}</td>
                    <td>{{ project.createdAt ? project.createdAt|date('d/m/Y') : '' }}</td>
                    <td>
                        <a href="{{ path('admin_project_show', {'id': project.id}) }}" class="btn btn-sm btn-info">
                            <i class="fas fa-eye"></i>
                        </a>
                        <a href="{{ path('admin_project_edit', {'id': project.id}) }}" class="btn btn-sm btn-warning">
                            <i class="fas fa-edit"></i>
                        </a>
                        <form method="post" action="{{ path('admin_project_delete', {'id': project.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce projet ?');" style="display: inline-block;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
                            <button class="btn btn-sm btn-danger">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8" class="text-center">Aucun projet trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}