{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des Projets{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/select/1.7.0/css/select.bootstrap5.min.css">
    
    <style>
        :root {
            --primary-color: #2c3e50;
            --secondary-color: #3498db;
            --accent-color: #e74c3c;
            --success-color: #27ae60;
            --warning-color: #f39c12;
            --light-bg: #f8f9fa;
            --border-color: #dee2e6;
        }

        .mkba-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            overflow: hidden;
            margin: 20px 0;
        }

        .mkba-header {
            background: linear-gradient(135deg, #f18221 0%, #0071BC 100%);
            color: white;
            padding: 20px 25px;
            border-bottom: none;
            position: relative;
            z-index: 50;
        }

        .mkba-header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .mkba-header-center {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .mkba-header h2 {
            margin: 0 0 15px 0;
            font-weight: 600;
            font-size: 1.5rem;
        }

        .mkba-stats-badges {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .mkba-add-button {
            background: rgba(255, 255, 255, 0.2);
            border: 2px solid rgba(255, 255, 255, 0.3);
            color: white;
            padding: 10px 20px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .mkba-add-button:hover {
            background: #6D5192;
            border-color: var(--primary-color);
            color: white;
            transform: translateY(-2px);
        }

        /* DataTables personnalisé */
        .dataTables_wrapper {
            padding: 20px 25px;
        }

        .dataTables_length {
            margin-bottom: 20px;
        }

        .dataTables_filter {
            margin-bottom: 20px;
        }

        .dataTables_filter input {
            border: 2px solid #e9ecef;
            border-radius: 25px;
            padding: 8px 16px;
            margin-left: 8px;
            transition: all 0.3s ease;
        }

        .dataTables_filter input:focus {
            border-color: var(--secondary-color);
            box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            outline: none;
        }

        .dt-buttons {
            margin-bottom: 20px;
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .dt-button {
            background: var(--secondary-color);
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-weight: 500;
            transition: all 0.3s ease;
            font-size: 0.9rem;
        }

        .dt-button:hover {
            background: #2980b9;
            transform: translateY(-1px);
            color: white;
        }

        .dt-button.buttons-excel {
            background: var(--success-color);
        }

        .dt-button.buttons-excel:hover {
            background: #219a52;
        }

        .dt-button.buttons-pdf {
            background: var(--accent-color);
        }

        .dt-button.buttons-pdf:hover {
            background: #c0392b;
        }

        .dt-button.buttons-print {
            background: var(--warning-color);
        }

        .dt-button.buttons-print:hover {
            background: #e67e22;
        }

        .dt-button.buttons-select-all,
        .dt-button.buttons-select-none {
            background: #6c757d;
        }

        .dt-button.buttons-select-all:hover,
        .dt-button.buttons-select-none:hover {
            background: #5a6268;
        }

        .dt-button.bulk-delete {
            background: var(--accent-color);
            display: none;
        }

        .dt-button.bulk-delete:hover {
            background: #c0392b;
        }

        .dt-button.bulk-delete.show {
            display: inline-block;
        }

        /* Table DataTables */
        .dataTable {
            border: none;
            margin-top: 0 !important;
        }

        .dataTable thead th {
            background: #0071BC;
            color: white;
            border: none;
            font-weight: 600;
            padding: 15px 12px;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .dataTable thead th:hover {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        }

        .dataTable tbody tr {
            transition: all 0.2s ease;
            position: relative;
        }

        .dataTable tbody tr:hover {
            background-color: #f8f9fa;
            transform: translateX(2px);
        }

        .dataTable tbody tr.selected {
            background-color: rgba(52, 152, 219, 0.1) !important;
            border-left: 4px solid var(--secondary-color);
        }

        .dataTable tbody td {
            padding: 12px;
            vertical-align: middle;
            border-top: 1px solid #f1f3f4;
        }

        /* Badges */
        .mkba-badge {
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .mkba-badge.planning {
            background: rgba(108, 117, 125, 0.2);
            color: #6c757d;
        }

        .mkba-badge.in_progress {
            background: rgba(52, 152, 219, 0.2);
            color: #3498db;
        }

        .mkba-badge.on_hold {
            background: rgba(243, 156, 18, 0.2);
            color: #f39c12;
        }

        .mkba-badge.completed {
            background: rgba(39, 174, 96, 0.2);
            color: #27ae60;
        }

        .mkba-badge.cancelled {
            background: rgba(231, 76, 60, 0.2);
            color: #e74c3c;
        }

        .priority-badge {
            padding: 2px 6px;
            border-radius: 8px;
            font-size: 0.7rem;
            font-weight: 600;
        }

        .priority-low { background: #e9ecef; color: #495057; }
        .priority-medium { background: #fff3cd; color: #856404; }
        .priority-high { background: #f8d7da; color: #721c24; }
        .priority-critical { background: #f5c6cb; color: #721c24; }

        /* Actions */
        .mkba-actions-group {
            display: flex;
            align-items: center;
            gap: 5px;
            justify-content: center;
            flex-wrap: nowrap;
        }

        .mkba-actions-group .btn {
            padding: 4px 8px;
            font-size: 0.8rem;
            border-radius: 4px;
            transition: all 0.3s ease;
            min-width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .mkba-actions-group .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        }

        /* Modal personnalisé de suppression */
        .delete-modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 10000;
            display: none;
            animation: fadeInOverlay 0.3s ease;
        }

        .delete-modal-overlay.show {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        @keyframes fadeInOverlay {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .delete-modal {
            background: white;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            max-width: 500px;
            width: 90%;
            margin: 20px;
            overflow: hidden;
            transform: scale(0.9);
            animation: modalSlideIn 0.3s ease forwards;
        }

        @keyframes modalSlideIn {
            from {
                transform: scale(0.9) translateY(-20px);
                opacity: 0;
            }
            to {
                transform: scale(1) translateY(0);
                opacity: 1;
            }
        }

        .delete-modal-header {
            background: linear-gradient(135deg, #dc3545, #c82333);
            color: white;
            padding: 20px 25px;
            text-align: center;
        }

        .delete-modal-icon {
            font-size: 3rem;
            margin-bottom: 10px;
            opacity: 0.9;
        }

        .delete-modal-title {
            font-size: 1.3rem;
            font-weight: 700;
            margin: 0;
        }

        .delete-modal-body {
            padding: 30px 25px;
            text-align: center;
        }

        .delete-modal-message {
            font-size: 1.1rem;
            color: #333;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .delete-modal-warning {
            background: linear-gradient(45deg, #f8d7da, #f5c6cb);
            border: 1px solid #dc3545;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 25px;
            color: #721c24;
        }

        .delete-modal-warning i {
            margin-right: 8px;
            font-size: 1.2rem;
        }

        .delete-modal-project-info {
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
            text-align: left;
        }

        .delete-modal-project-info strong {
            display: block;
            margin-bottom: 8px;
            color: #6d5192;
        }

        .delete-modal-actions {
            display: flex;
            gap: 12px;
            justify-content: center;
        }

        .delete-modal-btn {
            padding: 12px 25px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s ease;
            min-width: 120px;
        }

        .delete-modal-btn-cancel {
            background: #6c757d;
            color: white;
        }

        .delete-modal-btn-cancel:hover {
            background: #5a6268;
            transform: translateY(-1px);
        }

        .delete-modal-btn-confirm {
            background: #dc3545;
            color: white;
        }

        .delete-modal-btn-confirm:hover {
            background: #c82333;
            transform: translateY(-1px);
        }

        @media (max-width: 768px) {
            .mkba-header-content {
                flex-direction: column;
                gap: 15px;
            }
            
            .dt-buttons {
                flex-direction: column;
                align-items: stretch;
            }
            
            .dt-button {
                margin-bottom: 5px;
                text-align: center;
            }
            
            .mkba-actions-group {
                flex-direction: column;
                gap: 4px;
            }

            .delete-modal {
                width: 95%;
                margin: 10px;
            }

            .delete-modal-body {
                padding: 25px 20px;
            }

            .delete-modal-actions {
                flex-direction: column;
            }

            .delete-modal-btn {
                width: 100%;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <!-- Modal personnalisé de suppression -->
    <div class="delete-modal-overlay" id="deleteModal">
        <div class="delete-modal">
            <div class="delete-modal-header">
                <i class="fas fa-exclamation-triangle delete-modal-icon"></i>
                <h3 class="delete-modal-title">Supprimer le projet</h3>
            </div>
            <div class="delete-modal-body">
                <div class="delete-modal-message">
                    Êtes-vous sûr de vouloir supprimer ce projet ?
                </div>
                <div class="delete-modal-warning">
                    <i class="fas fa-exclamation-triangle"></i>
                    <strong>Attention !</strong> Cette action désactivera le projet de manière permanente. 
                    Toutes les données associées seront conservées mais le projet ne sera plus visible.
                </div>
                <div class="delete-modal-project-info" id="projectInfo">
                    <!-- Les détails du projet seront injectés ici -->
                </div>
                <div class="delete-modal-actions">
                    <button class="delete-modal-btn delete-modal-btn-cancel" onclick="cancelDelete()">
                        <i class="fas fa-times me-2"></i>
                        Annuler
                    </button>
                    <button class="delete-modal-btn delete-modal-btn-confirm" onclick="confirmDelete()" id="confirmDeleteBtn">
                        <i class="fas fa-trash me-2"></i>
                        Supprimer
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="mkba-container">
        <!-- En-tête -->
        <div class="mkba-header">
            <div class="mkba-header-content">
                <div style="width: 200px;"></div> <!-- Spacer gauche -->
                <div class="mkba-header-center">
                    <h2><i class="fas fa-folder-open me-2"></i>Gestion des Projets MK BA</h2>
                    <div class="mkba-stats-badges">
                        <span class="badge bg-light text-dark">
                            <span id="totalRecords">{{ stats.total }}</span> projets
                        </span>
                        <span class="badge bg-info text-white">
                            <span id="activeRecords">{{ stats.active }}</span> actifs
                        </span>
                        <span class="badge bg-primary text-white">
                            <span id="inProgressRecords">{{ stats.in_progress }}</span> en cours
                        </span>
                        <span class="badge bg-success text-white">
                            <span id="completedRecords">{{ stats.completed }}</span> terminés
                        </span>
                        <span class="badge bg-warning text-dark">
                            <span id="selectedCount">0</span> sélectionnés
                        </span>
                    </div>
                </div>
                <div>
                    <a href="{{ path('admin_project_new') }}" class="mkba-add-button">
                        <i class="fas fa-plus"></i>
                        Nouveau projet
                    </a>
                </div>
            </div>
        </div>

        <!-- Table DataTables -->
        <div class="table-responsive">
            <table class="table table-striped table-hover" id="projectsTable">
                <thead>
                    <tr>
                        <th width="50">
                            <input type="checkbox" class="form-check-input" id="selectAll">
                        </th>
                        <th>Code</th>
                        <th>Nom</th>
                        <th>Catégorie</th>
                        <th>Priorité</th>
                        <th>Statut</th>
                        <th>Responsable</th>
                        <th>Date début</th>
                        <th>Créé le</th>
                        <th width="100" data-orderable="false">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for project in projects %}
                    <tr data-project-id="{{ project.id }}">
                        <td>
                            <input type="checkbox" class="form-check-input row-select" value="{{ project.id }}">
                        </td>
                        <td><strong>{{ project.code }}</strong></td>
                        <td>{{ project.getName(currentLocale) ?: 'N/A' }}</td>
                        <td>{{ project.categoryLabel }}</td>
                        <td><span class="priority-badge priority-{{ project.priority }}">{{ project.priorityLabel }}</span></td>
                        <td><span class="mkba-badge {{ project.status }}">{{ project.statusLabel }}</span></td>
                        <td>{{ project.responsible ?: 'N/A' }}</td>
                        <td>{{ project.startDate ? project.startDate|date('d/m/Y') : 'N/A' }}</td>
                        <td>{{ project.createdAt|date('d/m/Y H:i') }}</td>
                        <td>
                            <div class="mkba-actions-group">
                                <a href="{{ path('admin_project_show', {id: project.id}) }}" 
                                   class="btn btn-sm btn-outline-info" 
                                   title="Voir les détails">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('admin_project_edit', {id: project.id}) }}" 
                                   class="btn btn-sm btn-outline-warning" 
                                   title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button" 
                                        class="btn btn-sm btn-outline-danger" 
                                        onclick="showDeleteModal({{ project.id }}, '{{ project.code|e('js') }}', '{{ project.getName(currentLocale)|e('js') }}')"
                                        title="Supprimer">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="10" class="text-center py-4">
                            <i class="fas fa-folder-open text-muted mb-2" style="font-size: 2rem;"></i>
                            <p class="text-muted mb-0">Aucun projet trouvé</p>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Formulaires cachés pour les actions -->
    <div id="hiddenForms" style="display: none;"></div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <!-- DataTables JS avec extensions -->
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/select/1.7.0/js/dataTables.select.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    
    <script>
        // Variables globales
        let projectsTable;
        let projectToDelete = null;
        
        // NOUVEAU: Tokens CSRF du contrôleur
        const csrfTokens = {{ csrfTokens|json_encode|raw }};

        // URLs pour les actions
        const projectUrls = {
            deleteBase: '{{ path('admin_project_index') }}'.replace('/index', '/'),
            bulkDelete: '{{ path('admin_project_bulk_delete') }}',
            exportDataTable: '{{ path('admin_project_export_datatable') }}',
            exportSelection: '{{ path('admin_project_export_datatable_selection') }}'
        };

        // Initialisation
        document.addEventListener('DOMContentLoaded', function() {
            console.log('📋 Initialisation du module Project avec DataTables...');
            initializeDataTable();
        });

        function initializeDataTable() {
            // Configuration DataTables avec exports natifs
            projectsTable = $('#projectsTable').DataTable({
                responsive: true,
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json'
                },
                dom: 'Bfrtip',
                buttons: [
                    {
                        text: '<i class="fas fa-check-square me-2"></i>Tout sélectionner',
                        className: 'dt-button buttons-select-all',
                        action: function () {
                            projectsTable.rows({search: 'applied'}).select();
                            updateSelectionInfo();
                        }
                    },
                    {
                        text: '<i class="fas fa-square me-2"></i>Tout désélectionner',
                        className: 'dt-button buttons-select-none',
                        action: function () {
                            projectsTable.rows().deselect();
                            updateSelectionInfo();
                        }
                    },
                    {
                        extend: 'excel',
                        text: '<i class="fas fa-file-excel me-2"></i>Excel - Tout',
                        className: 'dt-button buttons-excel',
                        title: 'Projets MK BA',
                        filename: function() {
                            return 'projets_complet_' + new Date().toISOString().slice(0,10);
                        },
                        exportOptions: {
                            columns: [1, 2, 3, 4, 5, 6, 7, 8], // Exclure checkbox et actions
                            modifier: {
                                search: 'applied',
                                order: 'applied'
                            }
                        }
                    },
                    {
                        extend: 'pdf',
                        text: '<i class="fas fa-file-pdf me-2"></i>PDF - Tout',
                        className: 'dt-button buttons-pdf',
                        title: 'Projets MK BA',
                        filename: function() {
                            return 'projets_complet_' + new Date().toISOString().slice(0,10);
                        },
                        orientation: 'landscape',
                        pageSize: 'A4',
                        exportOptions: {
                            columns: [1, 2, 3, 4, 5, 6, 7, 8],
                            modifier: {
                                search: 'applied',
                                order: 'applied'
                            }
                        },
                        customize: function(doc) {
                            doc.defaultStyle.fontSize = 8;
                            doc.styles.tableHeader.fontSize = 9;
                            doc.styles.tableHeader.fillColor = '#0071BC';
                        }
                    },
                    {
                        text: '<i class="fas fa-file-excel me-2"></i>Excel - Sélection',
                        className: 'dt-button buttons-excel bulk-export-excel',
                        action: function () {
                            exportSelection('excel');
                        }
                    },
                    {
                        text: '<i class="fas fa-file-pdf me-2"></i>PDF - Sélection',
                        className: 'dt-button buttons-pdf bulk-export-pdf',
                        action: function () {
                            exportSelection('pdf');
                        }
                    },
                    {
                        text: '<i class="fas fa-trash me-2"></i>Supprimer sélection',
                        className: 'dt-button bulk-delete',
                        action: function () {
                            bulkDelete();
                        }
                    }
                ],
                select: {
                    style: 'multi',
                    selector: 'td:not(:last-child)', // Éviter la sélection sur la colonne actions
                    className: 'selected'
                },
                columnDefs: [
                    {
                        targets: 0,
                        orderable: false,
                        render: function(data, type, row) {
                            return '<input type="checkbox" class="form-check-input row-select" value="' + $(row).data('project-id') + '">';
                        }
                    },
                    {
                        targets: -1, // Dernière colonne (actions)
                        orderable: false
                    }
                ],
                order: [[8, 'desc']], // Trier par date de création
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Tout"]],
                drawCallback: function() {
                    // Réattacher les événements après redraw
                    attachRowEvents();
                    updateBulkActionButtons();
                }
            });

            // Événements de sélection
            projectsTable.on('select deselect', function() {
                updateSelectionInfo();
                updateBulkActionButtons();
            });

            // Checkbox "Tout sélectionner" dans l'en-tête
            $('#selectAll').on('change', function() {
                if (this.checked) {
                    projectsTable.rows({search: 'applied'}).select();
                } else {
                    projectsTable.rows().deselect();
                }
            });

            attachRowEvents();
            updateBulkActionButtons();
            
            console.log('✅ DataTables initialisé avec exports natifs');
        }

        function attachRowEvents() {
            // Gestion des checkboxes individuelles
            $('.row-select').off('change').on('change', function() {
                const row = projectsTable.row($(this).closest('tr'));
                if (this.checked) {
                    row.select();
                } else {
                    row.deselect();
                }
            });
        }

        function updateSelectionInfo() {
            const selectedCount = projectsTable.rows({selected: true}).count();
            $('#selectedCount').text(selectedCount);
            
            // Mettre à jour le checkbox "Tout sélectionner"
            const totalVisible = projectsTable.rows({search: 'applied'}).count();
            const selectAllCheckbox = $('#selectAll')[0];
            
            if (selectedCount === 0) {
                selectAllCheckbox.checked = false;
                selectAllCheckbox.indeterminate = false;
            } else if (selectedCount === totalVisible) {
                selectAllCheckbox.checked = true;
                selectAllCheckbox.indeterminate = false;
            } else {
                selectAllCheckbox.checked = false;
                selectAllCheckbox.indeterminate = true;
            }
        }

        function updateBulkActionButtons() {
            const selectedCount = projectsTable.rows({selected: true}).count();
            const bulkButtons = $('.bulk-delete, .bulk-export-excel, .bulk-export-pdf');
            
            if (selectedCount > 0) {
                bulkButtons.show().addClass('show');
            } else {
                bulkButtons.hide().removeClass('show');
            }
        }

        // Export de la sélection
        function exportSelection(format) {
            const selectedRows = projectsTable.rows({selected: true});
            if (selectedRows.count() === 0) {
                if (window.showFlashMessage) {
                    window.showFlashMessage('Veuillez sélectionner au moins un projet', 'warning');
                }
                return;
            }

            const selectedIds = [];
            selectedRows.every(function() {
                const rowNode = this.node();
                const projectId = $(rowNode).data('project-id');
                if (projectId) {
                    selectedIds.push(projectId);
                }
            });

            if (format === 'excel') {
                exportSelectionExcel(selectedIds);
            } else if (format === 'pdf') {
                exportSelectionPdf(selectedIds);
            }
        }

        function exportSelectionExcel(selectedIds) {
            // Préparer les données pour l'export Excel personnalisé
            const data = [];
            const headers = ['Code', 'Nom', 'Catégorie', 'Priorité', 'Statut', 'Responsable', 'Département', 'Date début', 'Date fin', 'Budget', 'Créé le'];
            
            projectsTable.rows({selected: true}).every(function() {
                const rowData = this.data();
                const cleanData = [
                    $(rowData[1]).text(), // Code
                    $(rowData[2]).text(), // Nom  
                    $(rowData[3]).text(), // Catégorie
                    $(rowData[4]).text(), // Priorité
                    $(rowData[5]).text(), // Statut
                    $(rowData[6]).text(), // Responsable
                    '', // Département (à ajouter si disponible)
                    $(rowData[7]).text(), // Date début
                    '', // Date fin (à ajouter si disponible)
                    '', // Budget (à ajouter si disponible)
                    $(rowData[8]).text()  // Créé le
                ];
                data.push(cleanData);
            });

            // Créer et télécharger le fichier Excel
            const wb = XLSX.utils.book_new();
            const ws = XLSX.utils.aoa_to_sheet([headers, ...data]);
            XLSX.utils.book_append_sheet(wb, ws, 'Projets sélectionnés');
            
            const filename = 'projets_selection_' + new Date().toISOString().slice(0,10) + '.xlsx';
            XLSX.writeFile(wb, filename);

            if (window.showFlashMessage) {
                window.showFlashMessage(`Export Excel réussi: ${selectedIds.length} projet(s)`, 'success');
            }
        }

        function exportSelectionPdf(selectedIds) {
            const selectedData = [];
            
            projectsTable.rows({selected: true}).every(function() {
                const rowData = this.data();
                selectedData.push([
                    $(rowData[1]).text(), // Code
                    $(rowData[2]).text(), // Nom
                    $(rowData[3]).text(), // Catégorie
                    $(rowData[4]).text(), // Priorité
                    $(rowData[5]).text(), // Statut
                    $(rowData[6]).text(), // Responsable
                    $(rowData[7]).text(), // Date début
                    $(rowData[8]).text()  // Créé le
                ]);
            });

            const docDefinition = {
                pageOrientation: 'landscape',
                pageSize: 'A4',
                content: [
                    {
                        text: 'Projets MK BA - Sélection',
                        style: 'header',
                        alignment: 'center',
                        margin: [0, 0, 0, 20]
                    },
                    {
                        table: {
                            headerRows: 1,
                            widths: ['auto', '*', 'auto', 'auto', 'auto', 'auto', 'auto', 'auto'],
                            body: [
                                ['Code', 'Nom', 'Catégorie', 'Priorité', 'Statut', 'Responsable', 'Date début', 'Créé le'],
                                ...selectedData
                            ]
                        },
                        layout: {
                            fillColor: function (rowIndex, node, columnIndex) {
                                return (rowIndex === 0) ? '#0071BC' : null;
                            }
                        }
                    }
                ],
                styles: {
                    header: {
                        fontSize: 16,
                        bold: true,
                        color: '#0071BC'
                    }
                },
                defaultStyle: {
                    fontSize: 8
                }
            };

            const filename = 'projets_selection_' + new Date().toISOString().slice(0,10) + '.pdf';
            pdfMake.createPdf(docDefinition).download(filename);

            if (window.showFlashMessage) {
                window.showFlashMessage(`Export PDF réussi: ${selectedIds.length} projet(s)`, 'success');
            }
        }

        // Suppression groupée
        function bulkDelete() {
            const selectedRows = projectsTable.rows({selected: true});
            if (selectedRows.count() === 0) {
                if (window.showFlashMessage) {
                    window.showFlashMessage('Veuillez sélectionner au moins un projet', 'warning');
                }
                return;
            }

            const selectedIds = [];
            selectedRows.every(function() {
                const rowNode = this.node();
                const projectId = $(rowNode).data('project-id');
                if (projectId) {
                    selectedIds.push(projectId);
                }
            });

            if (confirm(`Êtes-vous sûr de vouloir supprimer ${selectedIds.length} projet(s) sélectionné(s) ?`)) {
                fetch(projectUrls.bulkDelete, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: 'ids=' + encodeURIComponent(JSON.stringify(selectedIds))
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        if (window.showFlashMessage) {
                            window.showFlashMessage(data.message, 'success');
                        }
                        // Recharger la page après un court délai
                        setTimeout(() => {
                            window.location.reload();
                        }, 1000);
                    } else {
                        if (window.showFlashMessage) {
                            window.showFlashMessage('Erreur: ' + data.message, 'error');
                        }
                    }
                })
                .catch(error => {
                    console.error('Erreur:', error);
                    if (window.showFlashMessage) {
                        window.showFlashMessage('Une erreur est survenue lors de la suppression', 'error');
                    }
                });
            }
        }

        // Modal de suppression individuelle
        function showDeleteModal(projectId, projectCode, projectName) {
            projectToDelete = {
                id: projectId,
                code: projectCode,
                name: projectName || 'N/A'
            };

            const projectInfo = document.getElementById('projectInfo');
            projectInfo.innerHTML = `
                <div style="margin-top: 8px;">
                    <strong>Code :</strong> ${projectCode}<br>
                    <strong>Nom :</strong> ${projectName || 'Non traduit'}
                </div>
            `;

            const modal = document.getElementById('deleteModal');
            modal.classList.add('show');
            document.body.style.overflow = 'hidden';
        }

        function cancelDelete() {
            const modal = document.getElementById('deleteModal');
            modal.classList.remove('show');
            document.body.style.overflow = '';
            projectToDelete = null;
        }

        function confirmDelete() {
            if (!projectToDelete) {
                console.error('Aucun projet à supprimer');
                return;
            }

            const csrfToken = csrfTokens[projectToDelete.id];
            
            if (!csrfToken) {
                console.error('Token CSRF non trouvé pour le projet:', projectToDelete.id);
                if (window.showFlashMessage) {
                    window.showFlashMessage('Erreur: Token de sécurité non trouvé. Rechargez la page.', 'error');
                }
                return;
            }
            
            // Créer et soumettre le formulaire de suppression
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = projectUrls.deleteBase + projectToDelete.id + '/delete';
            
            const tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '_token';
            tokenInput.value = csrfToken;
            
            form.appendChild(tokenInput);
            document.body.appendChild(form);
            
            // Fermer le modal avant soumission
            cancelDelete();
            
            // Soumettre le formulaire
            form.submit();
        }

        // Fermer le modal en cliquant sur l'overlay
        document.getElementById('deleteModal').addEventListener('click', function(e) {
            if (e.target === this) {
                cancelDelete();
            }
        });

        console.log('%c🚀 Module Project MK BA avec DataTables et exports natifs!', 'color: #6d5192; font-size: 16px; font-weight: bold;');
        console.log('✅ NOUVEAU: Exports Excel/PDF natifs DataTables');
        console.log('✅ NOUVEAU: Actions groupées avec sélection multiple');
        console.log('✅ NOUVEAU: Messages centralisés depuis le controller');
        console.log('✅ Interface DataTables complète et moderne');
    </script>
