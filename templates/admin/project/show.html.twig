{% extends 'admin/base.html.twig' %}

{% block title %}{{ project.title }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>{{ project.title }}</h1>
    <div>
        <a href="{{ path('admin_project_edit', {'id': project.id}) }}" class="btn btn-warning">
            <i class="fas fa-edit"></i> Modifier
        </a>
        <a href="{{ path('admin_project_index') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Retour à la liste
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Informations du projet</h5>
                <table class="table">
                    <tbody>
                        <tr>
                            <th>ID</th>
                            <td>{{ project.id }}</td>
                        </tr>
                        <tr>
                            <th>Catégorie</th>
                            <td>{{ project.category }}</td>
                        </tr>
                        <tr>
                            <th>Extrait</th>
                            <td>{{ project.excerpt }}</td>
                        </tr>
                        <tr>
                            <th>Description</th>
                            <td>{{ project.description|nl2br }}</td>
                        </tr>
                        <tr>
                            <th>Statut</th>
                            <td>
                                {% if project.published %}
                                    <span class="badge bg-success">Publié</span>
                                {% else %}
                                    <span class="badge bg-secondary">Brouillon</span>
                                {% endif %}
                                {% if project.featured %}
                                    <span class="badge bg-warning">En vedette</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th>Ordre d'affichage</th>
                            <td>{{ project.displayOrder }}</td>
                        </tr>
                        <tr>
                            <th>Créé le</th>
                            <td>{{ project.createdAt ? project.createdAt|date('d/m/Y H:i') : '' }}</td>
                        </tr>
                        <tr>
                            <th>Modifié le</th>
                            <td>{{ project.updatedAt ? project.updatedAt|date('d/m/Y H:i') : '' }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        {% if project.image %}
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Image</h5>
                    <img src="{{ asset('uploads/projects/' ~ project.image) }}" alt="{{ project.title }}" class="img-fluid">
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}