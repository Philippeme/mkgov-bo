{{ form_start(form, {'attr': {'id': 'personForm', 'enctype': 'multipart/form-data', 'novalidate': 'novalidate'}}) }}

<div class="row g-4">
    <div class="col-lg-8">
        <!-- Personal Information Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="d-flex align-items-center">
                    <div class="icon-wrapper me-3">
                        <i class="bi-person-fill fs-4"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0 fw-bold">Personal Information</h5>
                        <small class="opacity-75">Basic citizen details and identification</small>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <!-- Name Fields Row -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="form-floating">
                            {{ form_widget(form.firstName, {
                                'attr': {
                                    'class': 'form-control form-control-lg',
                                    'placeholder': 'First Name'
                                }
                            }) }}
                            <label for="{{ form.firstName.vars.id }}" class="text-muted">
                                <i class="bi-person me-1"></i>{{ form_label(form.firstName) }}*
                            </label>
                        </div>
                        {{ form_errors(form.firstName) }}
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            {{ form_widget(form.lastName, {
                                'attr': {
                                    'class': 'form-control form-control-lg',
                                    'placeholder': 'Last Name'
                                }
                            }) }}
                            <label for="{{ form.lastName.vars.id }}" class="text-muted">
                                <i class="bi-person me-1"></i>{{ form_label(form.lastName) }}*
                            </label>
                        </div>
                        {{ form_errors(form.lastName) }}
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            {{ form_widget(form.middleName, {
                                'attr': {
                                    'class': 'form-control form-control-lg',
                                    'placeholder': 'Middle Name'
                                }
                            }) }}
                            <label for="{{ form.middleName.vars.id }}" class="text-muted">
                                <i class="bi-person me-1"></i>{{ form_label(form.middleName) }}
                            </label>
                        </div>
                        {{ form_errors(form.middleName) }}
                    </div>
                </div>
                
                <!-- Gender, Birth, Place Row -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-gender-ambiguous me-1 text-primary"></i>Gender*
                        </label>
                        {{ form_widget(form.gender, {
                            'attr': {'class': 'form-select form-select-lg'}
                        }) }}
                        {{ form_errors(form.gender) }}
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-calendar-date me-1 text-primary"></i>Date of Birth*
                        </label>
                        {{ form_widget(form.dateOfBirth, {
                            'attr': {'class': 'form-control form-control-lg'}
                        }) }}
                        {{ form_errors(form.dateOfBirth) }}
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            {{ form_widget(form.placeOfBirth, {
                                'attr': {
                                    'class': 'form-control form-control-lg',
                                    'placeholder': 'Place of Birth'
                                }
                            }) }}
                            <label for="{{ form.placeOfBirth.vars.id }}" class="text-muted">
                                <i class="bi-geo-alt me-1"></i>{{ form_label(form.placeOfBirth) }}
                            </label>
                        </div>
                        {{ form_errors(form.placeOfBirth) }}
                    </div>
                </div>

                <!-- ID and Nationality Row -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="form-floating">
                            {{ form_widget(form.nationalId, {
                                'attr': {
                                    'class': 'form-control form-control-lg',
                                    'placeholder': 'National ID'
                                }
                            }) }}
                            <label for="{{ form.nationalId.vars.id }}" class="text-muted">
                                <i class="bi-credit-card me-1"></i>{{ form_label(form.nationalId) }}*
                            </label>
                        </div>
                        {{ form_errors(form.nationalId) }}
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            {{ form_widget(form.nationality, {
                                'attr': {
                                    'class': 'form-control form-control-lg',
                                    'placeholder': 'Nationality'
                                }
                            }) }}
                            <label for="{{ form.nationality.vars.id }}" class="text-muted">
                                <i class="bi-flag me-1"></i>{{ form_label(form.nationality) }}
                            </label>
                        </div>
                        {{ form_errors(form.nationality) }}
                    </div>
                </div>

                <!-- Professional Information Row -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="form-floating">
                            {{ form_widget(form.profession, {
                                'attr': {
                                    'class': 'form-control form-control-lg',
                                    'placeholder': 'Profession'
                                }
                            }) }}
                            <label for="{{ form.profession.vars.id }}" class="text-muted">
                                <i class="bi-briefcase me-1"></i>{{ form_label(form.profession) }}
                            </label>
                        </div>
                        {{ form_errors(form.profession) }}
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            {{ form_widget(form.employer, {
                                'attr': {
                                    'class': 'form-control form-control-lg',
                                    'placeholder': 'Employer'
                                }
                            }) }}
                            <label for="{{ form.employer.vars.id }}" class="text-muted">
                                <i class="bi-building me-1"></i>{{ form_label(form.employer) }}
                            </label>
                        </div>
                        {{ form_errors(form.employer) }}
                    </div>
                </div>

                <!-- Marital Status -->
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-heart me-1 text-primary"></i>Marital Status
                        </label>
                        {{ form_widget(form.maritalStatus, {
                            'attr': {'class': 'form-select form-select-lg'}
                        }) }}
                        {{ form_errors(form.maritalStatus) }}
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact Information Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                <div class="d-flex align-items-center">
                    <div class="icon-wrapper me-3">
                        <i class="bi-telephone-fill fs-4"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0 fw-bold">Contact Information</h5>
                        <small class="opacity-75">Communication details and address</small>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <!-- Email and Phone Row -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="form-floating">
                            {{ form_widget(form.email, {
                                'attr': {
                                    'class': 'form-control form-control-lg',
                                    'placeholder': 'Email Address'
                                }
                            }) }}
                            <label for="{{ form.email.vars.id }}" class="text-muted">
                                <i class="bi-envelope me-1"></i>{{ form_label(form.email) }}*
                            </label>
                        </div>
                        {{ form_errors(form.email) }}
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            {{ form_widget(form.phoneNumber, {
                                'attr': {
                                    'class': 'form-control form-control-lg',
                                    'placeholder': 'Phone Number'
                                }
                            }) }}
                            <label for="{{ form.phoneNumber.vars.id }}" class="text-muted">
                                <i class="bi-phone me-1"></i>{{ form_label(form.phoneNumber) }}*
                            </label>
                        </div>
                        {{ form_errors(form.phoneNumber) }}
                    </div>
                </div>

                <!-- Address -->
                <div class="mb-4">
                    <label class="form-label fw-semibold text-dark mb-2">
                        <i class="bi-geo-alt-fill me-1 text-primary"></i>Complete Address*
                    </label>
                    {{ form_widget(form.address, {
                        'attr': {
                            'class': 'form-control form-control-lg',
                            'rows': 3,
                            'placeholder': 'Enter complete address including street, neighborhood, etc.'
                        }
                    }) }}
                    {{ form_errors(form.address) }}
                </div>

                <!-- Location Details Row -->
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="form-floating">
                            {{ form_widget(form.city, {
                                'attr': {
                                    'class': 'form-control form-control-lg',
                                    'placeholder': 'City'
                                }
                            }) }}
                            <label for="{{ form.city.vars.id }}" class="text-muted">
                                <i class="bi-building me-1"></i>{{ form_label(form.city) }}
                            </label>
                        </div>
                        {{ form_errors(form.city) }}
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-map me-1 text-primary"></i>Region
                        </label>
                        {{ form_widget(form.region, {
                            'attr': {'class': 'form-select form-select-lg'}
                        }) }}
                        {{ form_errors(form.region) }}
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            {{ form_widget(form.postalCode, {
                                'attr': {
                                    'class': 'form-control form-control-lg',
                                    'placeholder': 'Postal Code'
                                }
                            }) }}
                            <label for="{{ form.postalCode.vars.id }}" class="text-muted">
                                <i class="bi-mailbox me-1"></i>{{ form_label(form.postalCode) }}
                            </label>
                        </div>
                        {{ form_errors(form.postalCode) }}
                    </div>
                </div>
            </div>
        </div>

        <!-- Emergency Contact Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%); color: #333 !important;">
                <div class="d-flex align-items-center">
                    <div class="icon-wrapper me-3">
                        <i class="bi-exclamation-triangle-fill fs-4 text-warning"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0 fw-bold text-dark">Emergency Contact</h5>
                        <small class="text-muted">Person to contact in case of emergency</small>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <!-- Contact Name and Relation Row -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="form-floating">
                            {{ form_widget(form.emergencyContactName, {
                                'attr': {
                                    'class': 'form-control form-control-lg',
                                    'placeholder': 'Emergency Contact Name'
                                }
                            }) }}
                            <label for="{{ form.emergencyContactName.vars.id }}" class="text-muted">
                                <i class="bi-person-plus me-1"></i>{{ form_label(form.emergencyContactName) }}
                            </label>
                        </div>
                        {{ form_errors(form.emergencyContactName) }}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-people me-1 text-primary"></i>Relationship
                        </label>
                        {{ form_widget(form.emergencyContactRelation, {
                            'attr': {'class': 'form-select form-select-lg'}
                        }) }}
                        {{ form_errors(form.emergencyContactRelation) }}
                    </div>
                </div>

                <!-- Emergency Contact Details Row -->
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            {{ form_widget(form.emergencyContactPhone, {
                                'attr': {
                                    'class': 'form-control form-control-lg',
                                    'placeholder': 'Emergency Contact Phone'
                                }
                            }) }}
                            <label for="{{ form.emergencyContactPhone.vars.id }}" class="text-muted">
                                <i class="bi-telephone me-1"></i>{{ form_label(form.emergencyContactPhone) }}
                            </label>
                        </div>
                        {{ form_errors(form.emergencyContactPhone) }}
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            {{ form_widget(form.emergencyContactEmail, {
                                'attr': {
                                    'class': 'form-control form-control-lg',
                                    'placeholder': 'Emergency Contact Email'
                                }
                            }) }}
                            <label for="{{ form.emergencyContactEmail.vars.id }}" class="text-muted">
                                <i class="bi-envelope me-1"></i>{{ form_label(form.emergencyContactEmail) }}
                            </label>
                        </div>
                        {{ form_errors(form.emergencyContactEmail) }}
                    </div>
                </div>
            </div>
        </div>

        <!-- Administrative Settings Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%); color: #333 !important;">
                <div class="d-flex align-items-center">
                    <div class="icon-wrapper me-3">
                        <i class="bi-gear-fill fs-4 text-secondary"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0 fw-bold text-dark">Administrative Settings</h5>
                        <small class="text-muted">System configuration options</small>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-dark mb-2">
                            <i class="bi-sort-numeric-up me-1 text-primary"></i>Display Order
                        </label>
                        {{ form_widget(form.displayOrder, {
                            'attr': {'class': 'form-control form-control-lg'}
                        }) }}
                        {{ form_errors(form.displayOrder) }}
                        <div class="form-text">
                            <small class="text-muted">
                                <i class="bi-info-circle me-1"></i>
                                Used for sorting citizens in lists and reports
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Photo Management Sidebar -->
    <div class="col-lg-4">
        <div class="position-sticky" style="top: 2rem;">
            <!-- Photo Upload Card -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <div class="d-flex align-items-center">
                        <div class="icon-wrapper me-3">
                            <i class="bi-camera-fill fs-4"></i>
                        </div>
                        <div>
                            <h5 class="card-title mb-0 fw-bold">Citizen Photo</h5>
                            <small class="opacity-75">Profile picture management</small>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4 text-center">
                    <!-- Photo Preview Container -->
                    <div class="photo-preview-container mb-4">
                        <div id="photoPreview" class="photo-preview-circle mx-auto">
                            {% if person.image %}
                                <img src="{{ asset('uploads/persons/' ~ person.image) }}" 
                                     alt="{{ person.fullName }}" 
                                     class="photo-preview-img">
                                <div class="photo-overlay">
                                    <i class="bi-camera text-white fs-4"></i>
                                </div>
                            {% else %}
                                <div class="photo-placeholder">
                                    <i class="bi-person-circle text-muted" style="font-size: 5rem;"></i>
                                    <div class="photo-overlay">
                                        <i class="bi-camera text-white fs-4"></i>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                        <div class="mt-3">
                            {% if person.image %}
                                <p class="mb-0 fw-semibold text-success">
                                    <i class="bi-check-circle me-1"></i>Photo Uploaded
                                </p>
                                <small class="text-muted">Click to change photo</small>
                            {% else %}
                                <p class="mb-0 text-muted">No photo uploaded</p>
                                <small class="text-muted">Upload a clear profile photo</small>
                            {% endif %}
                        </div>
                    </div>
                    
                    <!-- Photo Upload Controls -->
                    <div class="photo-controls">
                        <div class="mb-3">
                            {{ form_widget(form.photoFile, {
                                'attr': {
                                    'class': 'form-control',
                                    'accept': 'image/*',
                                    'onchange': 'previewPhoto(this)',
                                    'style': 'display: none;'
                                }
                            }) }}
                            <button type="button" class="btn btn-primary btn-lg w-100" onclick="document.getElementById('{{ form.photoFile.vars.id }}').click()">
                                <i class="bi-cloud-upload me-2"></i>Choose Photo
                            </button>
                            {{ form_errors(form.photoFile) }}
                        </div>

                        
                        <div class="mb-3">
                            <div class="form-check d-flex align-items-center justify-content-center">
                                {{ form_widget(form.removePhoto, {'attr': {'class': 'form-check-input me-2'}}) }}
                                {{ form_label(form.removePhoto, 'Remove current photo', {
                                    'label_attr': {'class': 'form-check-label text-danger fw-semibold'}
                                }) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Photo Guidelines Card -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <div class="d-flex align-items-center">
                        <i class="bi-lightbulb me-2 text-warning"></i>
                        <h6 class="card-title mb-0 fw-bold">Photo Guidelines</h6>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="guidelines-list">
                        <div class="guideline-item mb-3">
                            <div class="d-flex align-items-start">
                                <i class="bi-check-circle text-success me-2 mt-1"></i>
                                <div>
                                    <strong class="text-dark">Clear & Recent</strong>
                                    <p class="mb-0 small text-muted">High-quality, recent photo of the person</p>
                                </div>
                            </div>
                        </div>
                        <div class="guideline-item mb-3">
                            <div class="d-flex align-items-start">
                                <i class="bi-check-circle text-success me-2 mt-1"></i>
                                <div>
                                    <strong class="text-dark">Proper Framing</strong>
                                    <p class="mb-0 small text-muted">Face clearly visible and centered</p>
                                </div>
                            </div>
                        </div>
                        <div class="guideline-item mb-3">
                            <div class="d-flex align-items-start">
                                <i class="bi-check-circle text-success me-2 mt-1"></i>
                                <div>
                                    <strong class="text-dark">Neutral Background</strong>
                                    <p class="mb-0 small text-muted">Plain or simple background preferred</p>
                                </div>
                            </div>
                        </div>
                        <div class="guideline-item mb-3">
                            <div class="d-flex align-items-start">
                                <i class="bi-check-circle text-success me-2 mt-1"></i>
                                <div>
                                    <strong class="text-dark">No Accessories</strong>
                                    <p class="mb-0 small text-muted">No sunglasses, hats, or headwear</p>
                                </div>
                            </div>
                        </div>
                        <div class="guideline-item">
                            <div class="d-flex align-items-start">
                                <i class="bi-info-circle text-info me-2 mt-1"></i>
                                <div>
                                    <strong class="text-dark">File Requirements</strong>
                                    <p class="mb-0 small text-muted">JPEG, PNG, WEBP • Max 2MB • Min 300x300px</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Form Actions -->
<div class="row mt-5">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center p-4 bg-light rounded-3 border">
            <div class="form-actions-info">
                <h6 class="mb-1 fw-bold text-dark">Ready to save?</h6>
                <small class="text-muted">Make sure all required fields are completed</small>
            </div>
            <div class="form-actions-buttons">
                <a href="{{ path('admin_person_index') }}" class="btn btn-outline-secondary btn-lg me-3">
                    <i class="bi-arrow-left me-2"></i>Cancel
                </a>
                <button type="submit" class="btn btn-primary btn-lg px-4">
                    <i class="bi-check-circle me-2"></i>
                    {{ button_label|default('Save Citizen') }}
                </button>
            </div>
        </div>
    </div>
</div>

{{ form_end(form) }}

<style>
/* Custom styles for enhanced form */
.form-floating > .form-control:focus ~ label,
.form-floating > .form-control:not(:placeholder-shown) ~ label {
    opacity: .65;
    transform: scale(.85) translateY(-0.5rem) translateX(0.15rem);
}

.form-floating > label {
    padding: 1rem 0.75rem;
    transition: all 0.3s ease;
}

.form-control:focus {
    border-color: #667eea;
    box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
}

.form-select:focus {
    border-color: #667eea;
    box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
}

.icon-wrapper {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(10px);
}

.card {
    border-radius: 15px;
    overflow: hidden;
    transition: all 0.3s ease;
}

.card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 40px rgba(0,0,0,0.1) !important;
}

.card-header.bg-gradient {
    border: none;
    position: relative;
    overflow: hidden;
}

.card-header.bg-gradient::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 100px;
    height: 100px;
    background: rgba(255,255,255,0.1);
    border-radius: 50%;
    transform: translate(30px, -30px);
}

/* Photo Preview Styles */
.photo-preview-container {
    position: relative;
}

.photo-preview-circle {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    border: 4px solid #e9ecef;
    overflow: hidden;
    position: relative;
    cursor: pointer;
    transition: all 0.3s ease;
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
}

.photo-preview-circle:hover {
    border-color: #667eea;
    transform: scale(1.05);
}

.photo-preview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
}

.photo-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
}

.photo-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0,0,0,0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
}

.photo-preview-circle:hover .photo-overlay {
    opacity: 1;
}

.guideline-item {
    padding: 0.75rem;
    border-radius: 8px;
    background: rgba(102, 126, 234, 0.05);
    border-left: 3px solid #667eea;
    transition: all 0.3s ease;
}

.guideline-item:hover {
    background: rgba(102, 126, 234, 0.1);
    transform: translateX(3px);
}

.form-actions-buttons .btn {
    min-width: 120px;
}

/* Responsive adjustments */
@media (max-width: 768px) {
    .col-lg-4 .position-sticky {
        position: relative !important;
        top: auto !important;
    }
    
    .form-actions-buttons {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    
    .form-actions-info {
        text-align: center;
        margin-bottom: 1rem;
    }
}

/* Form validation styles */
.is-invalid {
    border-color: #dc3545;
}

.is-valid {
    border-color: #28a745;
}

.invalid-feedback {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: #dc3545;
}

/* Loading state for photo upload */
.photo-preview-circle.loading::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 30px;
    height: 30px;
    margin: -15px 0 0 -15px;
    border: 3px solid #f3f3f3;
    border-top: 3px solid #667eea;
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}
</style>

<script>
function previewPhoto(input) {
    const preview = document.getElementById('photoPreview');
    
    if (input.files && input.files[0]) {
        const file = input.files[0];
        
        // Validate file type
        if (!file.type.match('image.*')) {
            alert('Please select a valid image file.');
            input.value = '';
            return;
        }
        
        // Validate file size (2MB)
        if (file.size > 2 * 1024 * 1024) {
            alert('File size must be less than 2MB.');
            input.value = '';
            return;
        }
        
        const reader = new FileReader();
        
        // Add loading state
        preview.classList.add('loading');
        
        reader.onload = function(e) {
            preview.innerHTML = `
                <img src="${e.target.result}" 
                     class="photo-preview-img" 
                     alt="Photo preview">
                <div class="photo-overlay">
                    <i class="bi-camera text-white fs-4"></i>
                </div>
            `;
            preview.classList.remove('loading');
        };
        
        reader.readAsDataURL(file);
        
        // Clear remove checkbox if checked
        const removeCheckbox = document.querySelector('input[name="person[removePhoto]"]');
        if (removeCheckbox) removeCheckbox.checked = false;
        
        // Update status text
        const statusContainer = preview.parentElement.querySelector('.mt-3');
        if (statusContainer) {
            statusContainer.innerHTML = `
                <p class="mb-0 fw-semibold text-info">
                    <i class="bi-cloud-upload me-1"></i>New Photo Selected
                </p>
                <small class="text-muted">Photo will be saved when form is submitted</small>
            `;
        }
    }
}

// Form validation
document.getElementById('personForm').addEventListener('submit', function(e) {
    const firstName = document.querySelector('input[name="person[firstName]"]').value.trim();
    const lastName = document.querySelector('input[name="person[lastName]"]').value.trim();
    const email = document.querySelector('input[name="person[email]"]').value.trim();
    const phone = document.querySelector('input[name="person[phoneNumber]"]').value.trim();
    const nationalId = document.querySelector('input[name="person[nationalId]"]').value.trim();
    const address = document.querySelector('textarea[name="person[address]"]').value.trim();
    
    if (!firstName || !lastName || !email || !phone || !nationalId || !address) {
        e.preventDefault();
        alert('Please fill in all required fields (marked with *).');
        return false;
    }
    
    // Email validation
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
        e.preventDefault();
        alert('Please enter a valid email address.');
        return false;
    }
});

// Real-time validation feedback
document.querySelectorAll('input[required], textarea[required], select[required]').forEach(function(field) {
    field.addEventListener('blur', function() {
        if (this.value.trim() === '') {
            this.classList.add('is-invalid');
            this.classList.remove('is-valid');
        } else {
            this.classList.remove('is-invalid');
            this.classList.add('is-valid');
        }
    });
});

// Auto-format phone number
document.querySelector('input[name="person[phoneNumber]"]').addEventListener('input', function(e) {
    let value = e.target.value.replace(/\D/g, '');
    if (value.length > 0) {
        if (value.length <= 3) {
            value = value;
        } else if (value.length <= 6) {
            value = value.slice(0, 3) + '-' + value.slice(3);
        } else if (value.length <= 10) {
            value = value.slice(0, 3) + '-' + value.slice(3, 6) + '-' + value.slice(6);
        }
    }
    e.target.value = value;
});

// Click to upload photo
document.getElementById('photoPreview').addEventListener('click', function() {
    document.getElementById('{{ form.photoFile.vars.id }}').click();
});
</script>