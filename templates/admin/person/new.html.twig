{% extends 'admin/base.html.twig' %}

{% block title %}Register New Citizen{% endblock %}

{% block stylesheets %}
<style>
    .registration-container {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
        padding: 2rem 0;
    }
    
    .registration-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.1);
        overflow: hidden;
        border: none;
    }
    
    .registration-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        position: relative;
        overflow: hidden;
    }
    
    .registration-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        animation: float 8s ease-in-out infinite;
    }
    
    @keyframes float {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-20px) rotate(3deg); }
    }
    
    .progress-steps {
        display: flex;
        justify-content: center;
        margin-bottom: 2rem;
        position: relative;
    }
    
    .progress-step {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #e9ecef;
        color: #6c757d;
        font-weight: bold;
        position: relative;
        z-index: 2;
        transition: all 0.3s ease;
    }
    
    .progress-step.active {
        background: #667eea;
        color: white;
        transform: scale(1.1);
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
    }
    
    .progress-step.completed {
        background: #28a745;
        color: white;
    }
    
    .progress-step:not(:last-child)::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 100%;
        width: 100px;
        height: 2px;
        background: #e9ecef;
        z-index: 1;
        transition: all 0.3s ease;
    }
    
    .progress-step.completed:not(:last-child)::after {
        background: #28a745;
    }
    
    .step-content {
        display: none;
        animation: fadeInUp 0.5s ease;
    }
    
    .step-content.active {
        display: block;
    }
    
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .form-section {
        background: #f8f9fa;
        border-radius: 15px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        border: 1px solid #e9ecef;
        transition: all 0.3s ease;
    }
    
    .form-section:hover {
        border-color: #667eea;
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.1);
    }
    
    .section-title {
        color: #495057;
        font-weight: 600;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        font-size: 1.1rem;
    }
    
    .section-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 1rem;
        font-size: 1.2rem;
    }
    
    .form-control, .form-select {
        border-radius: 10px;
        border: 2px solid #e9ecef;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
        font-size: 0.95rem;
    }
    
    .form-control:focus, .form-select:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        transform: translateY(-1px);
    }
    
    .form-label {
        font-weight: 600;
        color: #495057;
        margin-bottom: 0.5rem;
    }
    
    .required-field::after {
        content: ' *';
        color: #dc3545;
        font-weight: bold;
    }
    
    .photo-upload-area {
        border: 2px dashed #dee2e6;
        border-radius: 15px;
        padding: 2rem;
        text-align: center;
        transition: all 0.3s ease;
        background: #f8f9fa;
        cursor: pointer;
    }
    
    .photo-upload-area:hover {
        border-color: #667eea;
        background: rgba(102, 126, 234, 0.05);
    }
    
    .photo-upload-area.dragover {
        border-color: #667eea;
        background: rgba(102, 126, 234, 0.1);
        transform: scale(1.02);
    }
    
    .photo-preview {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid white;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        margin-bottom: 1rem;
    }
    
    .guidelines-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 15px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }
    
    .guideline-item {
        display: flex;
        align-items: center;
        margin-bottom: 0.75rem;
        font-size: 0.9rem;
    }
    
    .guideline-item:last-child {
        margin-bottom: 0;
    }
    
    .navigation-buttons {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem;
        background: #f8f9fa;
        border-top: 1px solid #dee2e6;
    }
    
    .btn-nav {
        border-radius: 25px;
        padding: 0.75rem 2rem;
        font-weight: 600;
        transition: all 0.3s ease;
        border: none;
    }
    
    .btn-nav:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.15);
    }
    
    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
    }
    
    .validation-feedback {
        display: block;
        font-size: 0.875rem;
        margin-top: 0.25rem;
        border-radius: 5px;
        padding: 0.25rem 0.5rem;
    }
    
    .is-invalid {
        border-color: #dc3545;
        animation: shake 0.5s ease-in-out;
    }
    
    .is-valid {
        border-color: #28a745;
    }
    
    @keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-5px); }
        75% { transform: translateX(5px); }
    }
    
    .alert-info-custom {
        background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
        color: white;
        border: none;
        border-radius: 15px;
        padding: 1.5rem;
        margin-bottom: 2rem;
    }
    
    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255,255,255,0.9);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }
    
    .loading-spinner {
        width: 50px;
        height: 50px;
        border: 4px solid #f3f3f3;
        border-top: 4px solid #667eea;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }
    
    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    
    @media (max-width: 768px) {
        .registration-header {
            padding: 1.5rem;
        }
        
        .form-section {
            padding: 1rem;
            margin-bottom: 1rem;
        }
        
        .progress-steps {
            flex-wrap: wrap;
            gap: 0.5rem;
        }
        
        .progress-step:not(:last-child)::after {
            display: none;
        }
        
        .navigation-buttons {
            flex-direction: column;
            gap: 1rem;
        }
        
        .btn-nav {
            width: 100%;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="registration-container">
    <div class="container">
        <!-- Header -->
        <div class="registration-card">
            <div class="registration-header">
                <div class="text-center">
                    <h1 class="mb-2 fw-bold">
                        <i class="bi-person-plus me-3"></i>
                        Register New Citizen
                    </h1>
                    <p class="mb-0 opacity-75">Complete the registration process to add a new citizen to the registry</p>
                </div>
            </div>
            
            <!-- Progress Steps -->
            <div class="p-4">
                <div class="progress-steps">
                    <div class="progress-step active" data-step="1">1</div>
                    <div class="progress-step" data-step="2">2</div>
                    <div class="progress-step" data-step="3">3</div>
                    <div class="progress-step" data-step="4">4</div>
                </div>
                
                <!-- Registration Guidelines Alert -->
                <div class="alert-info-custom">
                    <div class="d-flex align-items-center">
                        <i class="bi-info-circle me-3" style="font-size: 1.5rem;"></i>
                        <div>
                            <h6 class="mb-1 fw-bold">Registration Guidelines</h6>
                            <p class="mb-0">Please ensure all required information is accurate. Fields marked with <span class="text-warning">*</span> are mandatory. The citizen will receive a confirmation email once registered.</p>
                        </div>
                    </div>
                </div>
                
                {{ form_start(form, {'attr': {'id': 'registrationForm', 'enctype': 'multipart/form-data', 'novalidate': 'novalidate'}}) }}
                
                <!-- Step 1: Personal Information -->
                <div class="step-content active" data-step="1">
                    <div class="form-section">
                        <div class="section-title">
                            <div class="section-icon bg-primary-subtle text-primary">
                                <i class="bi-person-fill"></i>
                            </div>
                            Personal Information
                        </div>
                        
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label required-field">First Name</label>
                                {{ form_widget(form.firstName, {'attr': {'class': 'form-control', 'placeholder': 'Enter first name'}}) }}
                                <div class="invalid-feedback"></div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label required-field">Last Name</label>
                                {{ form_widget(form.lastName, {'attr': {'class': 'form-control', 'placeholder': 'Enter last name'}}) }}
                                <div class="invalid-feedback"></div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Middle Name</label>
                                {{ form_widget(form.middleName, {'attr': {'class': 'form-control', 'placeholder': 'Enter middle name (optional)'}}) }}
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label required-field">Gender</label>
                                {{ form_widget(form.gender, {'attr': {'class': 'form-select'}}) }}
                                <div class="invalid-feedback"></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label required-field">Date of Birth</label>
                                {{ form_widget(form.dateOfBirth, {'attr': {'class': 'form-control'}}) }}
                                <div class="invalid-feedback"></div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Place of Birth</label>
                                {{ form_widget(form.placeOfBirth, {'attr': {'class': 'form-control', 'placeholder': 'Enter place of birth'}}) }}
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nationality</label>
                                {{ form_widget(form.nationality, {'attr': {'class': 'form-control', 'placeholder': 'Enter nationality'}}) }}
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label required-field">National ID Number</label>
                                {{ form_widget(form.nationalId, {'attr': {'class': 'form-control', 'placeholder': 'Enter national ID number'}}) }}
                                <div class="invalid-feedback"></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Marital Status</label>
                                {{ form_widget(form.maritalStatus, {'attr': {'class': 'form-select'}}) }}
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Step 2: Contact Information -->
                <div class="step-content" data-step="2">
                    <div class="form-section">
                        <div class="section-title">
                            <div class="section-icon bg-info-subtle text-info">
                                <i class="bi-telephone-fill"></i>
                            </div>
                            Contact Information
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label required-field">Email Address</label>
                                {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Enter email address'}}) }}
                                <div class="invalid-feedback"></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label required-field">Phone Number</label>
                                {{ form_widget(form.phoneNumber, {'attr': {'class': 'form-control', 'placeholder': 'Enter phone number'}}) }}
                                <div class="invalid-feedback"></div>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label required-field">Address</label>
                            {{ form_widget(form.address, {'attr': {'class': 'form-control', 'rows': 3, 'placeholder': 'Enter complete address'}}) }}
                            <div class="invalid-feedback"></div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">City</label>
                                {{ form_widget(form.city, {'attr': {'class': 'form-control', 'placeholder': 'Enter city'}}) }}
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Region</label>
                                {{ form_widget(form.region, {'attr': {'class': 'form-select'}}) }}
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Postal Code</label>
                                {{ form_widget(form.postalCode, {'attr': {'class': 'form-control', 'placeholder': 'Enter postal code'}}) }}
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Step 3: Professional & Emergency Contact -->
                <div class="step-content" data-step="3">
                    <!-- Professional Information -->
                    <div class="form-section">
                        <div class="section-title">
                            <div class="section-icon bg-success-subtle text-success">
                                <i class="bi-briefcase-fill"></i>
                            </div>
                            Professional Information
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Profession</label>
                                {{ form_widget(form.profession, {'attr': {'class': 'form-control', 'placeholder': 'Enter profession'}}) }}
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Employer</label>
                                {{ form_widget(form.employer, {'attr': {'class': 'form-control', 'placeholder': 'Enter employer name'}}) }}
                            </div>
                        </div>
                    </div>
                    
                    <!-- Emergency Contact -->
                    <div class="form-section">
                        <div class="section-title">
                            <div class="section-icon bg-warning-subtle text-warning">
                                <i class="bi-exclamation-triangle-fill"></i>
                            </div>
                            Emergency Contact
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Contact Name</label>
                                {{ form_widget(form.emergencyContactName, {'attr': {'class': 'form-control', 'placeholder': 'Enter emergency contact name'}}) }}
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Relationship</label>
                                {{ form_widget(form.emergencyContactRelation, {'attr': {'class': 'form-select'}}) }}
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Contact Phone</label>
                                {{ form_widget(form.emergencyContactPhone, {'attr': {'class': 'form-control', 'placeholder': 'Enter emergency contact phone'}}) }}
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Contact Email</label>
                                {{ form_widget(form.emergencyContactEmail, {'attr': {'class': 'form-control', 'placeholder': 'Enter emergency contact email'}}) }}
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Step 4: Photo & Final Settings -->
                <div class="step-content" data-step="4">
                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-section">
                                <div class="section-title">
                                    <div class="section-icon bg-secondary-subtle text-secondary">
                                        <i class="bi-gear-fill"></i>
                                    </div>
                                    Administrative Settings
                                </div>
                                
                                <div class="mb-3">
                                    <label class="form-label">Display Order</label>
                                    {{ form_widget(form.displayOrder, {'attr': {'class': 'form-control'}}) }}
                                    <div class="form-text">Lower numbers appear first in listings</div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-4">
                            <!-- Photo Upload -->
                            <div class="form-section">
                                <div class="section-title">
                                    <div class="section-icon bg-primary-subtle text-primary">
                                        <i class="bi-camera-fill"></i>
                                    </div>
                                    Citizen Photo
                                </div>
                                
                                <div class="photo-upload-area" id="photoUploadArea">
                                    <div id="photoPreview" class="text-center">
                                        <i class="bi-person-circle text-muted" style="font-size: 4rem;"></i>
                                        <h6 class="mt-3 mb-2">Upload Photo</h6>
                                        <p class="text-muted small mb-3">Drag & drop or click to browse</p>
                                        <div class="mb-3">
                                            {{ form_widget(form.photoFile, {'attr': {'class': 'form-control', 'accept': 'image/*', 'style': 'display: none;'}}) }}
                                            <button type="button" class="btn btn-outline-primary btn-sm" onclick="document.getElementById('person_photoFile').click()">
                                                <i class="bi-upload me-1"></i>Browse Files
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Photo Guidelines -->
                            <div class="guidelines-card">
                                <h6 class="fw-bold mb-3">
                                    <i class="bi-lightbulb me-2"></i>Photo Guidelines
                                </h6>
                                <div class="guideline-item">
                                    <i class="bi-check-circle me-2"></i>
                                    Clear, recent photo
                                </div>
                                <div class="guideline-item">
                                    <i class="bi-check-circle me-2"></i>
                                    Neutral background
                                </div>
                                <div class="guideline-item">
                                    <i class="bi-check-circle me-2"></i>
                                    Face clearly visible
                                </div>
                                <div class="guideline-item">
                                    <i class="bi-check-circle me-2"></i>
                                    No sunglasses/headwear
                                </div>
                                <div class="guideline-item">
                                    <i class="bi-check-circle me-2"></i>
                                    Max size: 2MB
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                {{ form_end(form, {'render_rest': false}) }}
            </div>
            
            <!-- Navigation Buttons -->
            <div class="navigation-buttons">
                <button type="button" class="btn btn-outline-secondary btn-nav" id="prevBtn" onclick="changeStep(-1)" style="display: none;">
                    <i class="bi-arrow-left me-2"></i>Previous
                </button>
                
                <div class="text-center">
                    <span class="text-muted small">Step <span id="currentStepText">1</span> of 4</span>
                </div>
                
                <button type="button" class="btn btn-primary btn-nav" id="nextBtn" onclick="changeStep(1)">
                    Next<i class="bi-arrow-right ms-2"></i>
                </button>
                
                <button type="submit" class="btn btn-success btn-nav" id="submitBtn" style="display: none;" form="registrationForm">
                    <i class="bi-check-circle me-2"></i>Register Citizen
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Loading Overlay -->
<div class="loading-overlay" id="loadingOverlay">
    <div class="text-center">
        <div class="loading-spinner"></div>
        <p class="mt-3 text-muted">Registering citizen...</p>
    </div>
</div>

{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    let currentStep = 1;
    const totalSteps = 4;
    
    // Initialize form
    initializeForm();
    initializePhotoUpload();
    initializeValidation();
    
    // Step navigation
    window.changeStep = function(direction) {
        if (direction === 1 && !validateCurrentStep()) {
            return;
        }
        
        const newStep = currentStep + direction;
        if (newStep >= 1 && newStep <= totalSteps) {
            showStep(newStep);
        }
    };
    
    function showStep(step) {
        // Hide all steps
        document.querySelectorAll('.step-content').forEach(content => {
            content.classList.remove('active');
        });
        
        // Show current step
        document.querySelector(`.step-content[data-step="${step}"]`).classList.add('active');
        
        // Update progress
        updateProgress(step);
        
        // Update navigation buttons
        updateNavigationButtons(step);
        
        currentStep = step;
        
        // Animate step transition
        animateStepTransition();
    }
    
    function updateProgress(step) {
        document.querySelectorAll('.progress-step').forEach((stepEl, index) => {
            const stepNumber = index + 1;
            stepEl.classList.remove('active', 'completed');
            
            if (stepNumber < step) {
                stepEl.classList.add('completed');
                stepEl.innerHTML = '<i class="bi-check"></i>';
            } else if (stepNumber === step) {
                stepEl.classList.add('active');
                stepEl.innerHTML = stepNumber;
            } else {
                stepEl.innerHTML = stepNumber;
            }
        });
        
        document.getElementById('currentStepText').textContent = step;
    }
    
    function updateNavigationButtons(step) {
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');
        const submitBtn = document.getElementById('submitBtn');
        
        prevBtn.style.display = step > 1 ? 'block' : 'none';
        nextBtn.style.display = step < totalSteps ? 'block' : 'none';
        submitBtn.style.display = step === totalSteps ? 'block' : 'none';
    }
    
    function animateStepTransition() {
        const activeContent = document.querySelector('.step-content.active');
        activeContent.style.opacity = '0';
        activeContent.style.transform = 'translateY(20px)';
        
        setTimeout(() => {
            activeContent.style.transition = 'all 0.3s ease';
            activeContent.style.opacity = '1';
            activeContent.style.transform = 'translateY(0)';
        }, 50);
    }
    
    // Form initialization
    function initializeForm() {
        // Auto-generate display order
        const displayOrderField = document.querySelector('input[name="person[displayOrder]"]');
        if (displayOrderField && !displayOrderField.value) {
            displayOrderField.value = Math.floor(Date.now() / 1000);
        }
        
        // Auto-format phone number
        const phoneField = document.querySelector('input[name="person[phoneNumber]"]');
        if (phoneField) {
            phoneField.addEventListener('input', function(e) {
                let value = e.target.value.replace(/\D/g, '');
                if (value.length > 0) {
                    if (value.length <= 3) {
                        value = value;
                    } else if (value.length <= 6) {
                        value = value.slice(0, 3) + '-' + value.slice(3);
                    } else if (value.length <= 10) {
                        value = value.slice(0, 3) + '-' + value.slice(3, 6) + '-' + value.slice(6);
                    }
                }
                e.target.value = value;
            });
        }
        
        // Emergency contact phone formatting
        const emergencyPhoneField = document.querySelector('input[name="person[emergencyContactPhone]"]');
        if (emergencyPhoneField) {
            emergencyPhoneField.addEventListener('input', function(e) {
                let value = e.target.value.replace(/\D/g, '');
                if (value.length > 0) {
                    if (value.length <= 3) {
                        value = value;
                    } else if (value.length <= 6) {
                        value = value.slice(0, 3) + '-' + value.slice(3);
                    } else if (value.length <= 10) {
                        value = value.slice(0, 3) + '-' + value.slice(3, 6) + '-' + value.slice(6);
                    }
                }
                e.target.value = value;
            });
        }
    }
    
    // Photo upload functionality
    function initializePhotoUpload() {
        const uploadArea = document.getElementById('photoUploadArea');
        const fileInput = document.getElementById('person_photoFile');
        const preview = document.getElementById('photoPreview');
        
        // Click to upload
        uploadArea.addEventListener('click', function() {
            fileInput.click();
        });
        
        // File input change
        fileInput.addEventListener('change', function(e) {
            if (e.target.files && e.target.files[0]) {
                previewPhoto(e.target.files[0]);
            }
        });
        
        // Drag and drop
        uploadArea.addEventListener('dragover', function(e) {
            e.preventDefault();
            uploadArea.classList.add('dragover');
        });
        
        uploadArea.addEventListener('dragleave', function(e) {
            e.preventDefault();
            uploadArea.classList.remove('dragover');
        });
        
        uploadArea.addEventListener('drop', function(e) {
            e.preventDefault();
            uploadArea.classList.remove('dragover');
            
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                const file = files[0];
                if (file.type.startsWith('image/')) {
                    fileInput.files = files;
                    previewPhoto(file);
                } else {
                    showToast('error', 'Please upload a valid image file');
                }
            }
        });
        
        function previewPhoto(file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                preview.innerHTML = `
                    <img src="${e.target.result}" class="photo-preview" alt="Photo preview">
                    <h6 class="mt-2 mb-1">Photo Uploaded</h6>
                    <p class="text-muted small mb-2">${file.name}</p>
                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="removePhoto()">
                        <i class="bi-trash me-1"></i>Remove
                    </button>
                `;
            };
            reader.readAsDataURL(file);
        }
        
        window.removePhoto = function() {
            fileInput.value = '';
            preview.innerHTML = `
                <i class="bi-person-circle text-muted" style="font-size: 4rem;"></i>
                <h6 class="mt-3 mb-2">Upload Photo</h6>
                <p class="text-muted small mb-3">Drag & drop or click to browse</p>
                <button type="button" class="btn btn-outline-primary btn-sm" onclick="document.getElementById('person_photoFile').click()">
                    <i class="bi-upload me-1"></i>Browse Files
                </button>
            `;
        };
    }
    
    // Validation
    function initializeValidation() {
        const requiredFields = document.querySelectorAll('input[required], select[required], textarea[required]');
        
        requiredFields.forEach(field => {
            field.addEventListener('blur', validateField);
            field.addEventListener('input', clearValidation);
        });
        
        // Email validation
        const emailField = document.querySelector('input[name="person[email]"]');
        if (emailField) {
            emailField.addEventListener('blur', function() {
                validateEmail(this);
            });
        }
        
        // Emergency contact email validation
        const emergencyEmailField = document.querySelector('input[name="person[emergencyContactEmail]"]');
        if (emergencyEmailField) {
            emergencyEmailField.addEventListener('blur', function() {
                if (this.value) {
                    validateEmail(this);
                }
            });
        }
    }
    
    function validateField(e) {
        const field = e.target;
        const value = field.value.trim();
        
        if (field.hasAttribute('required') && !value) {
            showFieldError(field, 'This field is required');
            return false;
        }
        
        clearFieldError(field);
        return true;
    }
    
    function validateEmail(field) {
        const email = field.value.trim();
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        
        if (email && !emailRegex.test(email)) {
            showFieldError(field, 'Please enter a valid email address');
            return false;
        }
        
        clearFieldError(field);
        return true;
    }
    
    function validateCurrentStep() {
        const currentStepEl = document.querySelector(`.step-content[data-step="${currentStep}"]`);
        const requiredFields = currentStepEl.querySelectorAll('input[required], select[required], textarea[required]');
        let isValid = true;
        
        requiredFields.forEach(field => {
            if (!validateField({target: field})) {
                isValid = false;
            }
        });
        
        // Email validation for current step
        const emailFields = currentStepEl.querySelectorAll('input[type="email"]');
        emailFields.forEach(field => {
            if (field.value && !validateEmail(field)) {
                isValid = false;
            }
        });
        
        if (!isValid) {
            showToast('error', 'Please fill in all required fields correctly');
        }
        
        return isValid;
    }
    
    function showFieldError(field, message) {
        field.classList.add('is-invalid');
        field.classList.remove('is-valid');
        
        const feedback = field.parentElement.querySelector('.invalid-feedback');
        if (feedback) {
            feedback.textContent = message;
        }
    }
    
    function clearFieldError(field) {
        field.classList.remove('is-invalid');
        if (field.value.trim()) {
            field.classList.add('is-valid');
        }
        
        const feedback = field.parentElement.querySelector('.invalid-feedback');
        if (feedback) {
            feedback.textContent = '';
        }
    }
    
    function clearValidation(e) {
        const field = e.target;
        field.classList.remove('is-invalid');
        
        const feedback = field.parentElement.querySelector('.invalid-feedback');
        if (feedback) {
            feedback.textContent = '';
        }
    }
    
    // Form submission
    document.getElementById('registrationForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        if (!validateCurrentStep()) {
            return;
        }
        
        // Show loading overlay
        document.getElementById('loadingOverlay').style.display = 'flex';
        
        // Simulate processing time
        setTimeout(() => {
            this.submit();
        }, 1000);
    });
    
    // Toast notifications
    function showToast(type, message) {
        const toastContainer = getOrCreateToastContainer();
        const toast = document.createElement('div');
        toast.className = `toast align-items-center text-white bg-${type === 'success' ? 'success' : 'danger'} border-0`;
        toast.setAttribute('role', 'alert');
        toast.innerHTML = `
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi-${type === 'success' ? 'check-circle' : 'exclamation-triangle'} me-2"></i>
                    ${message}
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        `;
        
        toastContainer.appendChild(toast);
        const bsToast = new bootstrap.Toast(toast);
        bsToast.show();
        
        toast.addEventListener('hidden.bs.toast', () => {
            toast.remove();
        });
    }
    
    function getOrCreateToastContainer() {
        let container = document.querySelector('.toast-container');
        if (!container) {
            container = document.createElement('div');
            container.className = 'toast-container position-fixed top-0 end-0 p-3';
            container.style.zIndex = '1055';
            document.body.appendChild(container);
        }
        return container;
    }
    
    // Keyboard shortcuts
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && e.ctrlKey) {
            if (currentStep < totalSteps) {
                changeStep(1);
            } else {
                document.getElementById('submitBtn').click();
            }
        }
        
        if (e.key === 'Escape') {
            window.location.href = '{{ path('admin_person_index') }}';
        }
    });
});
</script>
{% endblock %}