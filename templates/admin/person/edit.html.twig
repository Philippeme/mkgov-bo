{% extends 'admin/base.html.twig' %}

{% block title %}Edit Citizen - {{ person.fullName }}{% endblock %}

{% block stylesheets %}
<style>
    .edit-container {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
        padding: 2rem 0;
    }
    
    .edit-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.1);
        overflow: hidden;
        border: none;
    }
    
    .edit-header {
        background: linear-gradient(135deg, #ff9a56 0%, #ff6b6b 100%);
        color: white;
        padding: 2rem;
        position: relative;
        overflow: hidden;
    }
    
    .edit-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        animation: float 8s ease-in-out infinite;
    }
    
    @keyframes float {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-20px) rotate(3deg); }
    }
    
    .verification-alert {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        border: none;
        border-radius: 15px;
        padding: 1.5rem;
        margin-bottom: 2rem;
    }
    
    .citizen-preview {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 15px;
        color: white;
        padding: 1.5rem;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
    }
    
    .citizen-preview::before {
        content: '';
        position: absolute;
        top: -30%;
        right: -30%;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 50%);
    }
    
    .citizen-avatar-large {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        border: 3px solid white;
        object-fit: cover;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }
    
    .citizen-avatar-placeholder-large {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        border: 3px solid white;
        background: rgba(255,255,255,0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        font-weight: bold;
        color: white;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }
    
    .progress-tabs {
        display: flex;
        justify-content: center;
        margin-bottom: 2rem;
        background: #f8f9fa;
        border-radius: 15px;
        padding: 0.5rem;
        position: relative;
    }
    
    .progress-tab {
        flex: 1;
        text-align: center;
        padding: 1rem 1.5rem;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        color: #6c757d;
        font-weight: 600;
        border: none;
        background: transparent;
    }
    
    .progress-tab.active {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
    }
    
    .progress-tab:hover:not(.active) {
        background: rgba(102, 126, 234, 0.1);
        color: #667eea;
    }
    
    .tab-content {
        display: none;
        animation: fadeInUp 0.5s ease;
    }
    
    .tab-content.active {
        display: block;
    }
    
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .form-section {
        background: #f8f9fa;
        border-radius: 15px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        border: 1px solid #e9ecef;
        transition: all 0.3s ease;
        position: relative;
    }
    
    .form-section:hover {
        border-color: #667eea;
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.1);
        transform: translateY(-1px);
    }
    
    .form-section.changed {
        border-color: #ffc107;
        background: rgba(255, 193, 7, 0.05);
    }
    
    .form-section.changed::before {
        content: 'Modified';
        position: absolute;
        top: -8px;
        right: 15px;
        background: #ffc107;
        color: white;
        padding: 2px 8px;
        border-radius: 10px;
        font-size: 0.75rem;
        font-weight: bold;
    }
    
    .section-title {
        color: #495057;
        font-weight: 600;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        font-size: 1.1rem;
    }
    
    .section-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 1rem;
        font-size: 1.2rem;
    }
    
    .form-control, .form-select {
        border-radius: 10px;
        border: 2px solid #e9ecef;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
        font-size: 0.95rem;
    }
    
    .form-control:focus, .form-select:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        transform: translateY(-1px);
    }
    
    .form-control.changed, .form-select.changed {
        border-color: #ffc107;
        background-color: rgba(255, 193, 7, 0.05);
    }
    
    .form-label {
        font-weight: 600;
        color: #495057;
        margin-bottom: 0.5rem;
    }
    
    .required-field::after {
        content: ' *';
        color: #dc3545;
        font-weight: bold;
    }
    
    .photo-management-area {
        border: 2px solid #e9ecef;
        border-radius: 15px;
        padding: 1.5rem;
        text-align: center;
        transition: all 0.3s ease;
        background: #f8f9fa;
        position: relative;
    }
    
    .photo-management-area:hover {
        border-color: #667eea;
        background: rgba(102, 126, 234, 0.05);
    }
    
    .current-photo {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid white;
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        margin-bottom: 1rem;
    }
    
    .photo-placeholder-large {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        font-weight: bold;
        color: white;
        margin: 0 auto 1rem;
        border: 4px solid white;
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
    }
    
    .quick-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }
    
    .stat-item {
        background: white;
        border-radius: 12px;
        padding: 1rem;
        text-align: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border: 1px solid #e9ecef;
        transition: all 0.3s ease;
    }
    
    .stat-item:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
    }
    
    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 0.5rem;
        font-size: 1.25rem;
    }
    
    .changes-indicator {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        background: linear-gradient(135deg, #ffc107 0%, #ff8c00 100%);
        color: white;
        padding: 1rem 1.5rem;
        border-radius: 50px;
        box-shadow: 0 8px 25px rgba(255, 193, 7, 0.4);
        display: none;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        z-index: 1000;
        animation: pulse 2s infinite;
    }
    
    @keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }
    
    .action-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        padding: 2rem;
        background: #f8f9fa;
        border-top: 1px solid #dee2e6;
    }
    
    .btn-action {
        border-radius: 25px;
        padding: 0.75rem 2rem;
        font-weight: 600;
        transition: all 0.3s ease;
        border: none;
        min-width: 150px;
    }
    
    .btn-action:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.15);
    }
    
    .verification-toggle {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: rgba(255,255,255,0.2);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 25px;
        padding: 0.5rem 1rem;
        color: white;
        font-weight: 600;
        transition: all 0.3s ease;
    }
    
    .verification-toggle:hover {
        background: rgba(255,255,255,0.3);
        transform: scale(1.05);
    }
    
    @media (max-width: 768px) {
        .edit-header {
            padding: 1.5rem;
        }
        
        .form-section {
            padding: 1rem;
            margin-bottom: 1rem;
        }
        
        .progress-tabs {
            flex-direction: column;
        }
        
        .progress-tab {
            margin-bottom: 0.5rem;
        }
        
        .quick-stats {
            grid-template-columns: repeat(2, 1fr);
            gap: 0.75rem;
        }
        
        .action-buttons {
            flex-direction: column;
        }
        
        .btn-action {
            width: 100%;
        }
        
        .changes-indicator {
            bottom: 1rem;
            right: 1rem;
            left: 1rem;
            justify-content: center;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="edit-container">
    <div class="container">
        <div class="edit-card">
            <!-- Header -->
            <div class="edit-header">
                <button class="verification-toggle" data-person-id="{{ person.id }}">
                    <i class="bi-{{ person.verifiedAt ? 'check-circle-fill' : 'clock' }} me-2"></i>
                    {{ person.verifiedAt ? 'Verified' : 'Verify' }}
                </button>
                
                <div class="row align-items-center">
                    <div class="col-auto">
                        {% if person.image %}
                            <img src="{{ asset('uploads/persons/' ~ person.image) }}" 
                                 alt="{{ person.fullName }}" 
                                 class="citizen-avatar-large">
                        {% else %}
                            <div class="citizen-avatar-placeholder-large">
                                {{ person.firstName|first|upper }}{{ person.lastName|first|upper }}
                            </div>
                        {% endif %}
                    </div>
                    <div class="col">
                        <h1 class="mb-2 fw-bold">
                            <i class="bi-pencil me-3"></i>
                            Edit Citizen
                        </h1>
                        <h2 class="h4 mb-1 opacity-75">{{ person.fullName }}</h2>
                        <p class="mb-0 opacity-75">
                            <i class="bi-credit-card me-2"></i>{{ person.nationalId }}
                            <span class="mx-2">•</span>
                            <i class="bi-calendar me-1"></i>{{ person.age }} years old
                        </p>
                    </div>
                    <div class="col-auto">
                        <div class="d-flex flex-column gap-2">
                            <a href="{{ path('admin_person_show', {'id': person.id}) }}" 
                               class="btn btn-light">
                                <i class="bi-eye me-2"></i>View Profile
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Verification Alert -->
            {% if person.verifiedAt %}
            <div class="p-4">
                <div class="verification-alert">
                    <div class="d-flex align-items-center">
                        <i class="bi-exclamation-triangle me-3" style="font-size: 1.5rem;"></i>
                        <div>
                            <h6 class="mb-1 fw-bold">Verified Citizen</h6>
                            <p class="mb-0">This citizen has been verified on {{ person.verifiedAt|date('F d, Y \\a\\t H:i') }}. Please ensure any changes are necessary and accurate.</p>
                        </div>
                    </div>
                </div>
            </div>
            {% endif %}
            
            <!-- Quick Stats -->
            <div class="p-4">
                <div class="quick-stats">
                    <div class="stat-item">
                        <div class="stat-icon bg-primary-subtle text-primary">
                            <i class="bi-files"></i>
                        </div>
                        <h6 class="fw-bold mb-1">{{ person.documents|length }}</h6>
                        <p class="text-muted mb-0 small">Documents</p>
                    </div>
                    <div class="stat-item">
                        <div class="stat-icon bg-success-subtle text-success">
                            <i class="bi-calendar-check"></i>
                        </div>
                        <h6 class="fw-bold mb-1">{{ person.createdAt|date('M Y') }}</h6>
                        <p class="text-muted mb-0 small">Member Since</p>
                    </div>
                    <div class="stat-item">
                        <div class="stat-icon bg-info-subtle text-info">
                            <i class="bi-clock-history"></i>
                        </div>
                        <h6 class="fw-bold mb-1">{{ person.updatedAt|date('M d') }}</h6>
                        <p class="text-muted mb-0 small">Last Updated</p>
                    </div>
                </div>
            </div>
            
            <!-- Form Content -->
            <div class="p-4">
                <!-- Progress Tabs -->
                <div class="progress-tabs">
                    <button class="progress-tab active" data-tab="personal">
                        <i class="bi-person-fill me-2"></i>Personal
                    </button>
                    <button class="progress-tab" data-tab="contact">
                        <i class="bi-telephone-fill me-2"></i>Contact
                    </button>
                    <button class="progress-tab" data-tab="professional">
                        <i class="bi-briefcase-fill me-2"></i>Professional
                    </button>
                    <button class="progress-tab" data-tab="photo">
                        <i class="bi-camera-fill me-2"></i>Photo
                    </button>
                </div>
                
                {{ form_start(form, {'attr': {'id': 'editForm', 'enctype': 'multipart/form-data', 'novalidate': 'novalidate'}}) }}
                
                <!-- Personal Information Tab -->
                <div class="tab-content active" data-tab="personal">
                    <div class="form-section">
                        <div class="section-title">
                            <div class="section-icon bg-primary-subtle text-primary">
                                <i class="bi-person-fill"></i>
                            </div>
                            Personal Information
                        </div>
                        
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label required-field">First Name</label>
                                {{ form_widget(form.firstName, {'attr': {'class': 'form-control', 'placeholder': 'Enter first name'}}) }}
                                <div class="invalid-feedback"></div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label required-field">Last Name</label>
                                {{ form_widget(form.lastName, {'attr': {'class': 'form-control', 'placeholder': 'Enter last name'}}) }}
                                <div class="invalid-feedback"></div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Middle Name</label>
                                {{ form_widget(form.middleName, {'attr': {'class': 'form-control', 'placeholder': 'Enter middle name (optional)'}}) }}
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label required-field">Gender</label>
                                {{ form_widget(form.gender, {'attr': {'class': 'form-select'}}) }}
                                <div class="invalid-feedback"></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label required-field">Date of Birth</label>
                                {{ form_widget(form.dateOfBirth, {'attr': {'class': 'form-control'}}) }}
                                <div class="invalid-feedback"></div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Place of Birth</label>
                                {{ form_widget(form.placeOfBirth, {'attr': {'class': 'form-control', 'placeholder': 'Enter place of birth'}}) }}
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nationality</label>
                                {{ form_widget(form.nationality, {'attr': {'class': 'form-control', 'placeholder': 'Enter nationality'}}) }}
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label required-field">National ID Number</label>
                                {{ form_widget(form.nationalId, {'attr': {'class': 'form-control', 'placeholder': 'Enter national ID number'}}) }}
                                <div class="invalid-feedback"></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Marital Status</label>
                                {{ form_widget(form.maritalStatus, {'attr': {'class': 'form-select'}}) }}
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Contact Information Tab -->
                <div class="tab-content" data-tab="contact">
                    <div class="form-section">
                        <div class="section-title">
                            <div class="section-icon bg-info-subtle text-info">
                                <i class="bi-telephone-fill"></i>
                            </div>
                            Contact Information
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label required-field">Email Address</label>
                                {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Enter email address'}}) }}
                                <div class="invalid-feedback"></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label required-field">Phone Number</label>
                                {{ form_widget(form.phoneNumber, {'attr': {'class': 'form-control', 'placeholder': 'Enter phone number'}}) }}
                                <div class="invalid-feedback"></div>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label required-field">Address</label>
                            {{ form_widget(form.address, {'attr': {'class': 'form-control', 'rows': 3, 'placeholder': 'Enter complete address'}}) }}
                            <div class="invalid-feedback"></div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">City</label>
                                {{ form_widget(form.city, {'attr': {'class': 'form-control', 'placeholder': 'Enter city'}}) }}
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Region</label>
                                {{ form_widget(form.region, {'attr': {'class': 'form-select'}}) }}
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Postal Code</label>
                                {{ form_widget(form.postalCode, {'attr': {'class': 'form-control', 'placeholder': 'Enter postal code'}}) }}
                            </div>
                        </div>
                    </div>
                    
                    <!-- Emergency Contact -->
                    <div class="form-section">
                        <div class="section-title">
                            <div class="section-icon bg-warning-subtle text-warning">
                                <i class="bi-exclamation-triangle-fill"></i>
                            </div>
                            Emergency Contact
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Contact Name</label>
                                {{ form_widget(form.emergencyContactName, {'attr': {'class': 'form-control', 'placeholder': 'Enter emergency contact name'}}) }}
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Relationship</label>
                                {{ form_widget(form.emergencyContactRelation, {'attr': {'class': 'form-select'}}) }}
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Contact Phone</label>
                                {{ form_widget(form.emergencyContactPhone, {'attr': {'class': 'form-control', 'placeholder': 'Enter emergency contact phone'}}) }}
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Contact Email</label>
                                {{ form_widget(form.emergencyContactEmail, {'attr': {'class': 'form-control', 'placeholder': 'Enter emergency contact email'}}) }}
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Professional Information Tab -->
                <div class="tab-content" data-tab="professional">
                    <div class="form-section">
                        <div class="section-title">
                            <div class="section-icon bg-success-subtle text-success">
                                <i class="bi-briefcase-fill"></i>
                            </div>
                            Professional Information
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Profession</label>
                                {{ form_widget(form.profession, {'attr': {'class': 'form-control', 'placeholder': 'Enter profession'}}) }}
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Employer</label>
                                {{ form_widget(form.employer, {'attr': {'class': 'form-control', 'placeholder': 'Enter employer name'}}) }}
                            </div>
                        </div>
                    </div>
                    
                    <!-- Administrative Settings -->
                    <div class="form-section">
                        <div class="section-title">
                            <div class="section-icon bg-secondary-subtle text-secondary">
                                <i class="bi-gear-fill"></i>
                            </div>
                            Administrative Settings
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Display Order</label>
                            {{ form_widget(form.displayOrder, {'attr': {'class': 'form-control'}}) }}
                            <div class="form-text">Lower numbers appear first in listings</div>
                        </div>
                    </div>
                </div>
                
                <!-- Photo Management Tab -->
                <div class="tab-content" data-tab="photo">
                    <div class="form-section">
                        <div class="section-title">
                            <div class="section-icon bg-primary-subtle text-primary">
                                <i class="bi-camera-fill"></i>
                            </div>
                            Photo Management
                        </div>
                        
                        <div class="photo-management-area">
                            <div id="photoDisplay">
                                {% if person.image %}
                                    <img src="{{ asset('uploads/persons/' ~ person.image) }}" 
                                         alt="{{ person.fullName }}" 
                                         class="current-photo">
                                    <h6 class="mt-3 mb-2">Current Photo</h6>
                                    <p class="text-muted small mb-3">Click below to change or remove</p>
                                {% else %}
                                    <div class="photo-placeholder-large">
                                        {{ person.firstName|first|upper }}{{ person.lastName|first|upper }}
                                    </div>
                                    <h6 class="mt-3 mb-2">No Photo</h6>
                                    <p class="text-muted small mb-3">Upload a photo for this citizen</p>
                                {% endif %}
                            </div>
                            
                            <div class="d-flex gap-2 justify-content-center">
                                {{ form_widget(form.photoFile, {'attr': {'class': 'form-control', 'accept': 'image/*', 'style': 'display: none;'}}) }}
                                <button type="button" class="btn btn-primary" onclick="document.getElementById('person_photoFile').click()">
                                    <i class="bi-upload me-1"></i>Upload New
                                </button>
                                {% if person.image %}
                                <div class="form-check d-flex align-items-center ms-3">
                                    {{ form_widget(form.removePhoto, {'attr': {'class': 'form-check-input me-2'}}) }}
                                    {{ form_label(form.removePhoto, 'Remove Photo', {'label_attr': {'class': 'form-check-label text-danger'}}) }}
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
                
                {{ form_end(form, {'render_rest': false}) }}
            </div>
            
            <!-- Action Buttons -->
            <div class="action-buttons">
                <a href="{{ path('admin_person_index') }}" class="btn btn-outline-secondary btn-action">
                    <i class="bi-arrow-left me-2"></i>Cancel
                </a>
                <button type="submit" class="btn btn-primary btn-action" form="editForm">
                    <i class="bi-check-circle me-2"></i>Update Citizen
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Changes Indicator -->
<div class="changes-indicator" id="changesIndicator">
    <i class="bi-exclamation-triangle"></i>
    <span>You have unsaved changes</span>
</div>

{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    let hasChanges = false;
    let originalFormData = new FormData();
    
    // Initialize
    initializeTabs();
    initializeFormTracking();
    initializePhotoUpload();
    initializeValidation();
    initializeVerificationToggle();
    
    // Store original form data
    storeOriginalFormData();
    
    // Tab functionality
    function initializeTabs() {
        const tabs = document.querySelectorAll('.progress-tab');
        const contents = document.querySelectorAll('.tab-content');
        
        tabs.forEach(tab => {
            tab.addEventListener('click', function() {
                const targetTab = this.dataset.tab;
                
                // Remove active class from all tabs and contents
                tabs.forEach(t => t.classList.remove('active'));
                contents.forEach(c => c.classList.remove('active'));
                
                // Add active class to clicked tab and corresponding content
                this.classList.add('active');
                document.querySelector(`.tab-content[data-tab="${targetTab}"]`).classList.add('active');
                
                // Animate tab transition
                animateTabTransition();
            });
        });
    }
    
    function animateTabTransition() {
        const activeContent = document.querySelector('.tab-content.active');
        activeContent.style.opacity = '0';
        activeContent.style.transform = 'translateY(20px)';
        
        setTimeout(() => {
            activeContent.style.transition = 'all 0.3s ease';
            activeContent.style.opacity = '1';
            activeContent.style.transform = 'translateY(0)';
        }, 50);
    }
    
    // Form change tracking
    function initializeFormTracking() {
        const formElements = document.querySelectorAll('#editForm input, #editForm select, #editForm textarea');
        
        formElements.forEach(element => {
            element.addEventListener('input', function() {
                markFieldAsChanged(this);
                detectChanges();
            });
            
            element.addEventListener('change', function() {
                markFieldAsChanged(this);
                detectChanges();
            });
        });
        
        // Warn before leaving page if there are unsaved changes
        window.addEventListener('beforeunload', function(e) {
            if (hasChanges) {
                e.preventDefault();
                e.returnValue = '';
                return '';
            }
        });
    }
    
    function storeOriginalFormData() {
        const form = document.getElementById('editForm');
        originalFormData = new FormData(form);
    }
    
    function markFieldAsChanged(field) {
        field.classList.add('changed');
        
        // Mark parent section as changed
        const section = field.closest('.form-section');
        if (section) {
            section.classList.add('changed');
        }
    }
    
    function detectChanges() {
        const form = document.getElementById('editForm');
        const currentFormData = new FormData(form);
        
        hasChanges = false;
        
        // Compare current form data with original
        for (let [key, value] of currentFormData.entries()) {
            if (originalFormData.get(key) !== value) {
                hasChanges = true;
                break;
            }
        }
        
        // Show/hide changes indicator
        const indicator = document.getElementById('changesIndicator');
        if (hasChanges) {
            indicator.style.display = 'flex';
        } else {
            indicator.style.display = 'none';
        }
    }
    
    // Photo upload functionality
    function initializePhotoUpload() {
        const fileInput = document.getElementById('person_photoFile');
        const photoDisplay = document.getElementById('photoDisplay');
        
        fileInput.addEventListener('change', function(e) {
            if (e.target.files && e.target.files[0]) {
                const file = e.target.files[0];
                
                if (file.type.startsWith('image/')) {
                    previewPhoto(file);
                    markFieldAsChanged(this);
                    detectChanges();
                } else {
                    showToast('error', 'Please upload a valid image file');
                    this.value = '';
                }
            }
        });
        
        function previewPhoto(file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                photoDisplay.innerHTML = `
                    <img src="${e.target.result}" class="current-photo" alt="Photo preview">
                    <h6 class="mt-3 mb-2">New Photo Preview</h6>
                    <p class="text-muted small mb-3">${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)</p>
                `;
            };
            reader.readAsDataURL(file);
        }
    }
    
    // Validation
    function initializeValidation() {
        const requiredFields = document.querySelectorAll('input[required], select[required], textarea[required]');
        
        requiredFields.forEach(field => {
            field.addEventListener('blur', validateField);
            field.addEventListener('input', clearValidation);
        });
        
        // Email validation
        const emailFields = document.querySelectorAll('input[type="email"]');
        emailFields.forEach(field => {
            field.addEventListener('blur', function() {
                if (this.value) {
                    validateEmail(this);
                }
            });
        });
    }
    
    function validateField(e) {
        const field = e.target;
        const value = field.value.trim();
        
        if (field.hasAttribute('required') && !value) {
            showFieldError(field, 'This field is required');
            return false;
        }
        
        clearFieldError(field);
        return true;
    }
    
    function validateEmail(field) {
        const email = field.value.trim();
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        
        if (email && !emailRegex.test(email)) {
            showFieldError(field, 'Please enter a valid email address');
            return false;
        }
        
        clearFieldError(field);
        return true;
    }
    
    function showFieldError(field, message) {
        field.classList.add('is-invalid');
        field.classList.remove('is-valid');
        
        const feedback = field.parentElement.querySelector('.invalid-feedback');
        if (feedback) {
            feedback.textContent = message;
        }
    }
    
    function clearFieldError(field) {
        field.classList.remove('is-invalid');
        if (field.value.trim()) {
            field.classList.add('is-valid');
        }
        
        const feedback = field.parentElement.querySelector('.invalid-feedback');
        if (feedback) {
            feedback.textContent = '';
        }
    }
    
    function clearValidation(e) {
        const field = e.target;
        field.classList.remove('is-invalid');
        
        const feedback = field.parentElement.querySelector('.invalid-feedback');
        if (feedback) {
            feedback.textContent = '';
        }
    }
    
    // Verification toggle
    function initializeVerificationToggle() {
        document.querySelectorAll('.verification-toggle').forEach(button => {
            button.addEventListener('click', function() {
                const personId = this.dataset.personId;
                const button = this;
                
                // Show loading state
                const originalHTML = button.innerHTML;
                button.disabled = true;
                button.innerHTML = '<i class="bi-hourglass-split me-2"></i>Processing...';
                
                fetch(`/admin/person/${personId}/verify`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showToast('success', data.message);
                        
                        // Reload page to reflect changes
                        setTimeout(() => {
                            window.location.reload();
                        }, 1000);
                    } else {
                        showToast('error', data.message);
                        button.innerHTML = originalHTML;
                        button.disabled = false;
                    }
                })
                .catch(error => {
                    showToast('error', 'Error updating verification status');
                    button.innerHTML = originalHTML;
                    button.disabled = false;
                });
            });
        });
    }
    
    // Form submission
    document.getElementById('editForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        // Validate all required fields
        const requiredFields = document.querySelectorAll('input[required], select[required], textarea[required]');
        let isValid = true;
        
        requiredFields.forEach(field => {
            if (!validateField({target: field})) {
                isValid = false;
            }
        });
        
        // Validate email fields
        const emailFields = document.querySelectorAll('input[type="email"]');
        emailFields.forEach(field => {
            if (field.value && !validateEmail(field)) {
                isValid = false;
            }
        });
        
        if (!isValid) {
            showToast('error', 'Please fill in all required fields correctly');
            return;
        }
        
        // Show loading state
        const submitBtn = document.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="bi-hourglass-split me-2"></i>Updating...';
        
        // Submit form
        setTimeout(() => {
            this.submit();
        }, 500);
    });
    
    // Toast notifications
    function showToast(type, message) {
        const toastContainer = getOrCreateToastContainer();
        const toast = document.createElement('div');
        toast.className = `toast align-items-center text-white bg-${type === 'success' ? 'success' : 'danger'} border-0`;
        toast.setAttribute('role', 'alert');
        toast.innerHTML = `
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi-${type === 'success' ? 'check-circle' : 'exclamation-triangle'} me-2"></i>
                    ${message}
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        `;
        
        toastContainer.appendChild(toast);
        const bsToast = new bootstrap.Toast(toast);
        bsToast.show();
        
        toast.addEventListener('hidden.bs.toast', () => {
            toast.remove();
        });
    }
    
    function getOrCreateToastContainer() {
        let container = document.querySelector('.toast-container');
        if (!container) {
            container = document.createElement('div');
            container.className = 'toast-container position-fixed top-0 end-0 p-3';
            container.style.zIndex = '1055';
            document.body.appendChild(container);
        }
        return container;
    }
    
    // Keyboard shortcuts
    document.addEventListener('keydown', function(e) {
        // Ctrl/Cmd + S to save
        if ((e.ctrlKey || e.metaKey) && e.key === 's') {
            e.preventDefault();
            document.getElementById('editForm').dispatchEvent(new Event('submit'));
        }
        
        // Escape to cancel
        if (e.key === 'Escape') {
            if (hasChanges) {
                if (confirm('You have unsaved changes. Are you sure you want to leave?')) {
                    window.location.href = '{{ path('admin_person_index') }}';
                }
            } else {
                window.location.href = '{{ path('admin_person_index') }}';
            }
        }
        
        // Tab navigation (Ctrl + 1-4)
        if (e.ctrlKey && e.key >= '1' && e.key <= '4') {
            e.preventDefault();
            const tabIndex = parseInt(e.key) - 1;
            const tabs = ['personal', 'contact', 'professional', 'photo'];
            const tab = document.querySelector(`.progress-tab[data-tab="${tabs[tabIndex]}"]`);
            if (tab) {
                tab.click();
            }
        }
    });
});
</script>
{% endblock %}