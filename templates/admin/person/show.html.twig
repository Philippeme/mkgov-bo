{% extends 'admin/base.html.twig' %}

{% block title %}{{ person.firstName }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>{{ person.firstName }}</h1>
    <div>
        <a href="{{ path('admin_person_edit', {'id': person.id}) }}" class="btn btn-warning">
            <i class="fas fa-edit"></i> Update
        </a>
        <a href="{{ path('admin_person_index') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to the list
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Person informations</h5>
                <table class="table">
                    <tbody>
                        <tr>
                            <th>ID</th>
                            <td>{{ person.id }}</td>
                        </tr>
                        <tr>
                            <th>First name</th>
                            <td>{{ person.firstName }}</td>
                        </tr>
                        <tr>
                            <th>Last name</th>
                            <td>{{ person.lastName }}</td>
                        </tr>
                        <tr>
                            <th>Middle name</th>
                            <td>{{ person.middleName }}</td>
                        </tr>
                        <tr>
                            <th>Gender</th>
                            <td>{{ person.gender }}</td>
                        </tr>
                        <tr>
                            <th>Date of birth</th>
                            <td>{{ person.dateOfBirth|date('d/m/Y') }}</td>
                        </tr>
                        <tr>
                            <th>Place of birth</th>
                            <td>{{ person.placeOfBirth }}</td>
                        </tr>
                        <tr>
                            <th>National ID</th>
                            <td>{{ person.nationalId }}</td>
                        </tr>
                        <tr>
                            <th>Email</th>
                            <td>{{ person.email }}</td>
                        </tr>
                        <tr>
                            <th>Phone number</th>
                            <td>{{ person.phoneNumber }}</td>
                        </tr>
                        <tr>
                            <th>Marital status</th>
                            <td>{{ person.maritalStatus }}</td>
                        </tr>
                        <tr>
                            <th>Phone number</th>
                            <td>{{ person.phoneNumber }}</td>
                        </tr>
                        <tr>
                            <th>Region</th>
                            <td>{{ person.region }}</td>
                        </tr>
                        <tr>
                            <th>Address</th>
                            <td>{{ person.address }}</td>
                        </tr>
                        <tr>
                            <th>Profession</th>
                            <td>{{ person.profession }}</td>
                        </tr>
                        
                        <tr>
                            <th>Ordre d'affichage</th>
                            <td>{{ person.displayOrder }}</td>
                        </tr>
                        <tr>
                            <th>Créé le</th>
                            <td>{{ person.createdAt ? person.createdAt|date('d/m/Y H:i') : '' }}</td>
                        </tr>
                        <tr>
                            <th>Modifié le</th>
                            <td>{{ person.updatedAt ? person.updatedAt|date('d/m/Y H:i') : '' }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        {% if person.image %}
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Image</h5>
                    <img src="{{ asset('uploads/procedures/' ~ procedure.image) }}" alt="{{ person.firstName }}" class="img-fluid">
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}