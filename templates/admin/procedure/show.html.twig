{% extends 'admin/base.html.twig' %}

{% block title %}{{ procedure.pname }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>{{ procedure.pname }}</h1>
    <div>
        <a href="{{ path('admin_procedure_edit', {'id': procedure.id}) }}" class="btn btn-warning">
            <i class="fas fa-edit"></i> Update
        </a>
        <a href="{{ path('admin_procedure_index') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to the list
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Informations du projet</h5>
                <table class="table">
                    <tbody>
                        <tr>
                            <th>ID</th>
                            <td>{{ procedure.id }}</td>
                        </tr>
                        <tr>
                            <th>Family</th>
                            <td>{{ procedure.family }}</td>
                        </tr>
                        <tr>
                            <th>Short description</th>
                            <td>{{ procedure.shortdesc }}</td>
                        </tr>
                        <tr>
                            <th>Long description</th>
                            <td>{{ procedure.longdesc }}</td>
                        </tr>
                        
                        <tr>
                            <th>Ordre d'affichage</th>
                            <td>{{ procedure.displayOrder }}</td>
                        </tr>
                        <tr>
                            <th>Créé le</th>
                            <td>{{ procedure.createdAt ? procedure.createdAt|date('d/m/Y H:i') : '' }}</td>
                        </tr>
                        <tr>
                            <th>Modifié le</th>
                            <td>{{ procedure.updatedAt ? procedure.updatedAt|date('d/m/Y H:i') : '' }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        {% if procedure.image %}
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Image</h5>
                    <img src="{{ asset('uploads/procedures/' ~ procedure.image) }}" alt="{{ procedure.pname }}" class="img-fluid">
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}