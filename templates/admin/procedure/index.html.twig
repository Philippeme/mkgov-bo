{% extends 'admin/base.html.twig' %}

{% block title %}Procedures Management{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Procedures Management</h1>
    <a href="{{ path('admin_procedure_new') }}" class="btn btn-primary">
        <i class="fas fa-plus"></i> New procedure
    </a>
</div>

<div class="card">
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Family</th>
                    <th>Short description</th>
                    <th>Processing time (days)</th>
                    <th>Sercice cost</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for procedure in procedures %}
                <tr>
                    <td>{{ procedure.id }}</td>
                    <td>
                        {% if procedure.image %}
                            <img src="{{ asset('uploads/procedures/' ~ procedure.image) }}" alt="{{ procedure.pname }}" style="height: 50px;">
                        {% else %}
                            <span class="text-muted">No image</span>
                        {% endif %}
                    </td>
                    <td>{{ procedure.pname }}</td>
                    <td>{{ procedure.family }}</td>
                    <td>{{ procedure.shortdesc }}</td>
                    <td>{{ procedure.processtime }}</td>
                    <td>{{ procedure.servicecost }}</td>
                    <td>
                        <a href="{{ path('admin_procedure_show', {'id': procedure.id}) }}" class="btn btn-sm btn-info">
                            <i class="fas fa-eye"></i>
                        </a>
                        <a href="{{ path('admin_procedure_edit', {'id': procedure.id}) }}" class="btn btn-sm btn-warning">
                            <i class="fas fa-edit"></i>
                        </a>
                        <form method="post" action="{{ path('admin_procedure_delete', {'id': procedure.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette procedure ?');" style="display: inline-block;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ procedure.id) }}">
                            <button class="btn btn-sm btn-danger">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8" class="text-center">No procedure found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}