            <div class="row projects-grid">
                {% for project in projects %}
                    <div class="col-md-4" data-aos="fade-up" data-aos-delay="{{ loop.index * 100 }}">
                        <div class="project-card {% if project.featured %}featured{% endif %}">
                            {% if not project.featured %}
                                <div class="project-image">
                                    {% if project.image %}
                                        <img src="{{ asset('uploads/projects/' ~ project.image) }}" alt="{{ project.title }}">
                                    {% else %}
                                        <img src="{{ asset('images/projets/default.jpg') }}" alt="{{ project.title }}">
                                    {% endif %}
                                </div>
                            {% endif %}
                            <div class="project-info">
                                <div class="project-category">{{ project.category|upper }}</div>
                                <h3 class="project-title">
                                    <a href="{{ path('app_project_show', {'id': project.id}) }}" style="color: inherit; text-decoration: none;">
                                        {{ project.title }}
                                    </a>
                                </h3>
                                <div class="project-excerpt">{{ project.excerpt }}</div>
                                <div class="project-description">
                                    {{ project.description|length > 250 ? project.description|slice(0, 250) ~ '...' : project.description }}
                                </div>
                                {% if not project.featured %}
                                    <a href="{{ path('app_project_show', {'id': project.id}) }}" class="btn btn-sm btn-primary mt-3">
                                        Voir le projet <i class="fas fa-arrow-right"></i>
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12 text-center">
                        <p class="text-muted">Aucun projet disponible pour le moment.</p>
                    </div>
                {% endfor %}
            </div>

            <div class="text-center mt-4">
                <a href="{{ path('app_projects') }}" class="btn btn-primary">VOIR PLUS</a>
            </div>
        </div>
