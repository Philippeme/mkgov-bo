{# templates/project/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ project.title }} - OAG{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .project-hero {
            position: relative;
            height: 500px;
            background-size: cover;
            background-position: center;
            margin-top: 80px;
        }
        .project-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(to bottom, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.7) 100%);
        }
        .project-hero-content {
            position: absolute;
            bottom: 60px;
            left: 0;
            right: 0;
            color: white;
            z-index: 1;
        }
        .project-hero h1 {
            color: white;
            font-size: 48px;
            margin-bottom: 20px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        }
        .project-content {
            padding: 60px 0;
        }
        .project-meta-box {
            background-color: #f8f9fa;
            padding: 30px;
            border-radius: 10px;
            margin-bottom: 30px;
        }
        .project-navigation {
            background-color: #f8f9fa;
            padding: 30px 0;
            margin-top: 60px;
        }
        .nav-project {
            display: flex;
            align-items: center;
            padding: 20px;
            background: white;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.3s ease;
            height: 100%;
        }
        .nav-project:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }
        .nav-project-icon {
            font-size: 24px;
            margin: 0 15px;
            color: #1a4b8f;
        }
        .nav-project-content {
            flex: 1;
        }
        .nav-project-label {
            font-size: 12px;
            text-transform: uppercase;
            color: #666;
            margin-bottom: 5px;
        }
        .nav-project-title {
            font-size: 16px;
            font-weight: 600;
            color: #333;
        }
        .similar-projects {
            padding: 60px 0;
            background-color: #f8f9fa;
        }
        .share-buttons {
            margin-top: 30px;
            padding-top: 30px;
            border-top: 1px solid #dee2e6;
        }
        .share-button {
            display: inline-block;
            padding: 10px 20px;
            margin-right: 10px;
            border-radius: 5px;
            color: white;
            text-decoration: none;
            transition: all 0.3s ease;
        }
        .share-button:hover {
            transform: translateY(-2px);
            color: white;
        }
        .share-facebook { background-color: #3b5998; }
        .share-twitter { background-color: #1da1f2; }
        .share-linkedin { background-color: #0077b5; }
        .share-email { background-color: #666; }
    </style>
{% endblock %}

{% block body %}
    <!-- Hero Section -->
    <div class="project-hero" style="background-image: url('{{ project.image ? asset('uploads/projects/' ~ project.image) : asset('images/projets/default-hero.jpg') }}');">
        <div class="project-hero-content">
            <div class="container">
                <div class="category-badge">
                    <span class="badge bg-warning text-dark">{{ project.category|upper }}</span>
                    {% if project.featured %}
                        <span class="badge bg-success">Projet en vedette</span>
                    {% endif %}
                </div>
                <h1>{{ project.title }}</h1>
                <p class="lead">{{ project.excerpt }}</p>
            </div>
        </div>
    </div>

    <!-- Contenu du projet -->
    <div class="project-content">
        <div class="container">
            <div class="row">
                <div class="col-md-8">
                    <!-- Description principale -->
                    <div class="project-description">
                        {{ project.description|nl2br }}
                    </div>

                    <!-- Boutons de partage -->
                    <div class="share-buttons">
                        <h5>Partager ce projet :</h5>
                        <a href="https://www.facebook.com/sharer/sharer.php?u={{ url('app_project_show', {'id': project.id}) }}" 
                           target="_blank" class="share-button share-facebook">
                            <i class="fab fa-facebook-f"></i> Facebook
                        </a>
                        <a href="https://twitter.com/intent/tweet?url={{ url('app_project_show', {'id': project.id}) }}&text={{ project.title|url_encode }}" 
                           target="_blank" class="share-button share-twitter">
                            <i class="fab fa-twitter"></i> Twitter
                        </a>
                        <a href="https://www.linkedin.com/shareArticle?mini=true&url={{ url('app_project_show', {'id': project.id}) }}&title={{ project.title|url_encode }}" 
                           target="_blank" class="share-button share-linkedin">
                            <i class="fab fa-linkedin-in"></i> LinkedIn
                        </a>
                        <a href="mailto:?subject={{ project.title|url_encode }}&body={{ url('app_project_show', {'id': project.id}) }}" 
                           class="share-button share-email">
                            <i class="fas fa-envelope"></i> Email
                        </a>
                    </div>
                </div>

                <div class="col-md-4">
                    <!-- Métadonnées du projet -->
                    <div class="project-meta-box">
                        <h4>Informations du projet</h4>
                        <hr>
                        <ul class="list-unstyled">
                            <li class="mb-3">
                                <strong><i class="fas fa-tag"></i> Catégorie :</strong><br>
                                {{ project.category }}
                            </li>
                            <li class="mb-3">
                                <strong><i class="fas fa-calendar"></i> Date de publication :</strong><br>
                                {{ project.createdAt|date('d F Y') }}
                            </li>
                            <li class="mb-3">
                                <strong><i class="fas fa-clock"></i> Dernière mise à jour :</strong><br>
                                {{ project.updatedAt|date('d F Y') }}
                            </li>
                            {% if project.featured %}
                                <li class="mb-3">
                                    <span class="badge bg-warning text-dark">
                                        <i class="fas fa-star"></i> Projet en vedette
                                    </span>
                                </li>
                            {% endif %}
                        </ul>
                        <hr>
                        <a href="{{ path('app_projects') }}" class="btn btn-secondary w-100">
                            <i class="fas fa-arrow-left"></i> Retour aux projets
                        </a>
                    </div>

                    <!-- Call to action -->
                    <div class="card mt-4">
                        <div class="card-body text-center">
                            <h5>Intéressé par ce projet ?</h5>
                            <p>Contactez-nous pour en savoir plus sur notre expertise</p>
                            <a href="#" class="btn btn-primary">
                                <i class="fas fa-envelope"></i> Nous contacter
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation entre projets -->
    {% if previousProject or nextProject %}
        <div class="project-navigation">
            <div class="container">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        {% if previousProject %}
                            <a href="{{ path('app_project_show', {'id': previousProject.id}) }}" class="nav-project">
                                <i class="fas fa-chevron-left nav-project-icon"></i>
                                <div class="nav-project-content">
                                    <div class="nav-project-label">Projet précédent</div>
                                    <div class="nav-project-title">{{ previousProject.title }}</div>
                                </div>
                            </a>
                        {% endif %}
                    </div>
                    <div class="col-md-6 mb-3">
                        {% if nextProject %}
                            <a href="{{ path('app_project_show', {'id': nextProject.id}) }}" class="nav-project">
                                <div class="nav-project-content text-end">
                                    <div class="nav-project-label">Projet suivant</div>
                                    <div class="nav-project-title">{{ nextProject.title }}</div>
                                </div>
                                <i class="fas fa-chevron-right nav-project-icon"></i>
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    <!-- Projets similaires -->
    {% if similarProjects|length > 0 %}
        <div class="similar-projects">
            <div class="container">
                <h2 class="section-title">Projets similaires</h2>
                <div class="row">
                    {% for similarProject in similarProjects %}
                        <div class="col-md-4 mb-4">
                            <div class="project-card">
                                <div class="project-image">
                                    {% if similarProject.image %}
                                        <img src="{{ asset('uploads/projects/' ~ similarProject.image) }}" 
                                             alt="{{ similarProject.title }}" class="img-fluid">
                                    {% else %}
                                        <img src="{{ asset('images/projets/default.jpg') }}" 
                                             alt="{{ similarProject.title }}" class="img-fluid">
                                    {% endif %}
                                </div>
                                <div class="project-info">
                                    <div class="project-category">{{ similarProject.category|upper }}</div>
                                    <h3 class="project-title">
                                        <a href="{{ path('app_project_show', {'id': similarProject.id}) }}">
                                            {{ similarProject.title }}
                                        </a>
                                    </h3>
                                    <div class="project-excerpt">{{ similarProject.excerpt }}</div>
                                    <a href="{{ path('app_project_show', {'id': similarProject.id}) }}" 
                                       class="btn btn-sm btn-primary mt-3">
                                        Voir le projet <i class="fas fa-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Smooth scroll pour les ancres
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    </script>
{% endblock %}