{# templates/project/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Nos Réalisations - OAG{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .projects-header {
            background: linear-gradient(135deg, #1a4b8f 0%, #2a5db3 100%);
            color: white;
            padding: 100px 0 60px;
            margin-top: 80px;
        }
        .projects-header h1 {
            color: white;
            font-size: 42px;
            margin-bottom: 20px;
        }
        .projects-filters {
            background-color: #f8f9fa;
            padding: 30px 0;
            margin-bottom: 40px;
        }
        .filter-form {
            display: flex;
            gap: 15px;
            align-items: flex-end;
            flex-wrap: wrap;
        }
        .filter-group {
            flex: 1;
            min-width: 200px;
        }
        .filter-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
            color: #333;
        }
        .projects-grid {
            padding: 40px 0;
        }
        .project-card {
            height: 100%;
            transition: all 0.3s ease;
        }
        .project-card:hover {
            transform: translateY(-10px);
        }
        .load-more {
            text-align: center;
            padding: 40px 0;
        }
        .no-results {
            text-align: center;
            padding: 60px 0;
            color: #666;
        }
        .no-results i {
            font-size: 48px;
            color: #ddd;
            margin-bottom: 20px;
        }
    </style>
{% endblock %}

{% block body %}
    <!-- Header -->
    <div class="projects-header">
        <div class="container">
            <h1>Nos Réalisations</h1>
            <p class="lead">Découvrez l'ensemble de nos projets à travers le monde</p>
        </div>
    </div>

    <!-- Filtres -->
    <div class="projects-filters">
        <div class="container">
            <form method="get" action="{{ path('app_projects') }}" class="filter-form">
                <div class="filter-group">
                    <label for="category">Catégorie</label>
                    <select name="category" id="category" class="form-control">
                        <option value="">Toutes les catégories</option>
                        {% for category in categories %}
                            <option value="{{ category }}" {% if currentFilters.category == category %}selected{% endif %}>
                                {{ category }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                
                <div class="filter-group">
                    <label for="year">Année</label>
                    <select name="year" id="year" class="form-control">
                        <option value="">Toutes les années</option>
                        {% for year in years %}
                            <option value="{{ year }}" {% if currentFilters.year == year %}selected{% endif %}>
                                {{ year }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                
                <div class="filter-group">
                    <label for="search">Rechercher</label>
                    <input type="text" name="search" id="search" class="form-control" 
                           placeholder="Mots-clés..." value="{{ currentFilters.search }}">
                </div>
                
                <div class="filter-group">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search"></i> Filtrer
                    </button>
                    <a href="{{ path('app_projects') }}" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Réinitialiser
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Grille des projets -->
    <div class="projects-grid">
        <div class="container">
            {% if projects|length > 0 %}
                <div class="row">
                    {% for project in projects %}
                        <div class="col-md-4 mb-4" data-aos="fade-up" data-aos-delay="{{ loop.index * 50 }}">
                            <div class="project-card {% if project.featured %}featured{% endif %}">
                                {% if not project.featured %}
                                    <div class="project-image">
                                        {% if project.image %}
                                            <img src="{{ asset('uploads/projects/' ~ project.image) }}" 
                                                 alt="{{ project.title }}" class="img-fluid">
                                        {% else %}
                                            <img src="{{ asset('images/projets/default.jpg') }}" 
                                                 alt="{{ project.title }}" class="img-fluid">
                                        {% endif %}
                                    </div>
                                {% endif %}
                                <div class="project-info">
                                    <div class="project-category">{{ project.category|upper }}</div>
                                    <h3 class="project-title">
                                        <a href="{{ path('app_project_show', {'id': project.id}) }}">
                                            {{ project.title }}
                                        </a>
                                    </h3>
                                    <div class="project-excerpt">{{ project.excerpt }}</div>
                                    <div class="project-description">
                                        {{ project.description|length > 200 ? project.description|slice(0, 200) ~ '...' : project.description }}
                                    </div>
                                    <div class="project-meta mt-3">
                                        <small class="text-muted">
                                            <i class="far fa-calendar"></i> {{ project.createdAt|date('d/m/Y') }}
                                        </small>
                                    </div>
                                    <a href="{{ path('app_project_show', {'id': project.id}) }}" 
                                       class="btn btn-sm btn-primary mt-3">
                                        Voir le projet <i class="fas fa-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="no-results">
                    <i class="fas fa-search"></i>
                    <h3>Aucun projet trouvé</h3>
                    <p>Essayez de modifier vos critères de recherche</p>
                    <a href="{{ path('app_projects') }}" class="btn btn-primary mt-3">
                        Voir tous les projets
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Auto-submit form on change
        document.querySelectorAll('.filter-form select').forEach(select => {
            select.addEventListener('change', function() {
                this.closest('form').submit();
            });
        });
    </script>
{% endblock %}